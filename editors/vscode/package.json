{
  "name": "weby-language",
  "displayName": "Weby",
  "description": "Syntax highlighting, brackets and indentation for Weby (.wb) files",
  "version": "1.0.0",
  "publisher": "weby",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "weby",
        "aliases": ["Weby", "weby"],
        "extensions": [".wb"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "weby",
        "scopeName": "source.weby",
        "path": "./syntaxes/weby.tmLanguage.json"
      }
    ]
  }
}
