{
  "name": "viper-language",
  "displayName": "Viper",
  "description": "Syntax highlighting, brackets and indentation for Viper (.vi) files",
  "version": "1.1.0",
  "publisher": "viper",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "viper",
        "aliases": ["Viper", "viper"],
        "extensions": [".vi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "viper",
        "scopeName": "source.viper",
        "path": "./syntaxes/viper.tmLanguage.json"
      }
    ]
  }
}
