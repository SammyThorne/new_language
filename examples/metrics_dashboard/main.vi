# The orders service with its metrics dashboard: see README.md. The password comes from the
# environment or a `.env` file here: copy `.env.example` to `.env`.

import config
import io
import os
import app

def main():
    match config.load_env():
        case Ok(_):
            pass
        case Err(bad_settings):
            io.eprint(bad_settings.message())
            os.exit(1)
    # `server.metrics` reads METRICS_USER with METRICS_PASSWORD or METRICS_PASSWORD_HASH.
    server = app.make_server_from_env()
    print("open http://localhost:8080/metrics/dashboard")
    server.listen(":8080").unwrap()
