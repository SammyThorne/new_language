# Copy to .env (which is not committed) and fill in. Variables set in the environment win over
# this file. The syntax is in docs/05-standard-library.md, "Configuration".

# Who may see /metrics and /metrics/dashboard (HTTP Basic authentication).
METRICS_USER=ops

# Better than a password here: its hash, from the compiler's `hash-password` command, which
# prints pbkdf2-sha256$<iterations>$<salt>$<hash>. Set one of the two.
METRICS_PASSWORD_HASH=
# METRICS_PASSWORD=
