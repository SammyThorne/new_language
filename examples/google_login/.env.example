# Copy to .env (which is not committed) and fill in. Variables set in the environment win over
# this file. The syntax is in docs/05-standard-library.md, "Configuration".

# The key for session cookies, at least 32 bytes: head -c 32 /dev/urandom | base64
SESSION_SECRET=

# The OAuth client, if not in client_secret.json: its file's path, or its ID and secret.
# GOOGLE_CLIENT_SECRETS=secrets/client_secret.json
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
