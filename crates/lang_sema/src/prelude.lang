"""
The prelude: traits and types available in every program, without an import.

It is compiled with each program, before the program's own code. The compiler gives the traits
below their meaning: `print` and f-strings use `Display`, `==` uses `Eq`, dict keys need `Hash`,
`?` converts errors to `Error`, and the operators `+`, `-` and `*` on structs use the number
traits.
"""

trait Display:
    def to_str(self) -> str

trait Eq:
    def eq(self, other: Self) -> bool

trait Hash(Eq):
    def hash(self) -> int

trait Copy:
    def copy(self) -> Self

trait Error:
    def message(self) -> str

    def status(self) -> int:
        """The HTTP status of a response reporting this error: 500 unless the error says otherwise."""
        return 500

trait AddNumber:
    def add(self, other: Self) -> Self

trait SubNumber:
    def sub(self, other: Self) -> Self

trait MulNumber:
    def mul(self, other: Self) -> Self

@derive(Eq, Display)
struct ParseError:
    """The error from `int.parse(text)` and `float.parse(text)`."""
    text: str
    expected: str

impl Error for ParseError:
    def message(self) -> str:
        return f"\"{self.text}\" is not a valid {self.expected}"

trait Ord(Eq):
    def cmp(self, other: Self) -> int

trait Number(AddNumber, SubNumber, MulNumber, Ord):
    """Implemented by `int` and `float`; a bound for generic arithmetic."""
    pass

trait Shareable:
    """
    Types whose values can be handed to another task: immutable values, `@frozen` structs of
    shareable fields, and `Mutex`, `Atomic`, `Channel` and `Task`. The compiler decides which
    types have it; it cannot be implemented by hand. `trait Store(Shareable):` requires every
    implementation of `Store` to be shareable.
    """
    pass

@extern("lrt_bytes_at")
def __bytes_at(data: str, index: int) -> int

@extern("lrt_bytes_slice")
def __bytes_slice(data: str, start: int, end: int) -> str

@extern("lrt_bytes_is_utf8")
def __bytes_is_utf8(data: str) -> int

@extern("lrt_bytes_repr")
def __bytes_repr(data: str) -> str

@extern("lrt_bytes_hex")
def __bytes_hex(data: str) -> str

@derive(Eq, Hash)
@frozen
struct bytes:
    """
    Binary data: an immutable sequence of bytes, such as a WebSocket binary message.
    `text.encode()` gives a string's UTF-8 bytes and `data.decode()` the text back; `data[i]` is
    one byte as an `int`, and `len(data)` the number of bytes.
    """
    priv data: str

impl bytes:
    def len(self) -> int:
        return len(self.data)

    def get_index(self, index: int) -> int:
        value = __bytes_at(self.data, index)
        if value < 0:
            panic(f"index {index} is out of range for {len(self.data)} bytes")
        return value

    def slice(self, start: int, end: int) -> bytes:
        """Bytes `start` up to `end`; negative indices count from the end, as in slicing."""
        return bytes(__bytes_slice(self.data, start, end))

    def decode(self) -> str?:
        """The bytes as text, or `None` if they are not valid UTF-8."""
        if __bytes_is_utf8(self.data) == 1:
            return self.data
        return None

    def hex(self) -> str:
        return __bytes_hex(self.data)

impl Display for bytes:
    def to_str(self) -> str:
        return __bytes_repr(self.data)

impl AddNumber for bytes:
    def add(self, other: bytes) -> bytes:
        return bytes(self.data + other.data)

def __bytes(data: str) -> bytes:
    """`text.encode()`; also how the standard library wraps data that is not text."""
    return bytes(data)

def __bytes_data(value: bytes) -> str:
    """The data of a `bytes`, for the standard library to hand to the runtime. Not text."""
    return value.data

trait ToJson:
    """Types that `json.encode` can write. `@derive(Json)` implements it with generated code."""
    pass

trait FromJson:
    """Types that `json.decode` can read. `@derive(Json)` implements it with generated code."""
    pass

trait JsonString:
    """
    Types written to JSON as a string, such as `datetime.DateTime`. Implementing it also
    implements `ToJson` and `FromJson`: `json.encode` writes `to_json_string()` as a JSON string,
    and `json.decode` reads a string and passes it to `from_json_string`, whose error message
    becomes the `JsonError`.
    """
    def to_json_string(self) -> str
    def from_json_string(text: str) -> Result[Self, str]

# ---- methods of the built-in types ---------------------------------------------------------
#
# `value.method(...)` on a `str`, `list`, `dict` and so on calls a function named
# `__<type>_<method>` here when the compiler itself has no such method (or none taking these
# arguments). The value is the first argument. A last parameter named `__at` is filled in with
# the location of the call, for `__panic_at`, so that a panic points at the caller's line.

@extern("lrt_panic")
def __panic_at(message: str, where: str)

# -- str

@extern("lrt_str_count")
def __str_count(text: str, sub: str) -> int

@extern("lrt_str_rfind")
def __str_rfind(text: str, sub: str) -> int

@extern("lrt_str_class")
def __str_class(text: str, class_id: int) -> int

@extern("lrt_str_title")
def __str_title(text: str) -> str

@extern("lrt_str_capitalize")
def __str_capitalize(text: str) -> str

@extern("lrt_str_strip_chars")
def __str_strip_chars(text: str, chars: str, mode: int) -> str

@extern("lrt_str_ord")
def __str_ord(text: str) -> int

@extern("lrt_str_chr_ok")
def __chr_ok(code: int) -> int

@extern("lrt_str_chr")
def __chr_text(code: int) -> str

def __str_index(text: str, sub: str, __at: str) -> int:
    at = text.find(sub)
    if at < 0:
        __panic_at("index(): the substring is not in the string", __at)
    return at

def __str_is_digit(text: str) -> bool:
    return __str_class(text, 0) == 1

def __str_is_alpha(text: str) -> bool:
    return __str_class(text, 1) == 1

def __str_is_alnum(text: str) -> bool:
    return __str_class(text, 2) == 1

def __str_is_space(text: str) -> bool:
    return __str_class(text, 3) == 1

def __str_is_upper(text: str) -> bool:
    return __str_class(text, 4) == 1

def __str_is_lower(text: str) -> bool:
    return __str_class(text, 5) == 1

def __str_strip(text: str, chars: str) -> str:
    return __str_strip_chars(text, chars, 0)

def __str_lstrip(text: str, chars: str) -> str:
    return __str_strip_chars(text, chars, 1)

def __str_rstrip(text: str, chars: str) -> str:
    return __str_strip_chars(text, chars, 2)

def __str_remove_prefix(text: str, prefix: str) -> str:
    if text.starts_with(prefix):
        return text[len(prefix):]
    return text

def __str_remove_suffix(text: str, suffix: str) -> str:
    if len(suffix) > 0 and text.ends_with(suffix):
        return text[:len(text) - len(suffix)]
    return text

def __str_partition(text: str, sep: str, __at: str) -> tuple[str, str, str]:
    if len(sep) == 0:
        __panic_at("partition(): empty separator", __at)
    at = text.find(sep)
    if at < 0:
        return (text, "", "")
    return (text[:at], sep, text[at + len(sep):])

def __str_rpartition(text: str, sep: str, __at: str) -> tuple[str, str, str]:
    if len(sep) == 0:
        __panic_at("rpartition(): empty separator", __at)
    at = __str_rfind(text, sep)
    if at < 0:
        return ("", "", text)
    return (text[:at], sep, text[at + len(sep):])

def __str_split(text: str, sep: str, limit: int = -1, __at: str) -> list[str]:
    """`text.split(sep, limit)`: at most `limit` splits, from the left; no limit if negative."""
    if len(sep) == 0:
        __panic_at("split(): empty separator", __at)
    parts: list[str] = []
    rest = text
    splits = 0
    while limit < 0 or splits < limit:
        at = rest.find(sep)
        if at < 0:
            break
        parts.append(rest[:at])
        rest = rest[at + len(sep):]
        splits += 1
    parts.append(rest)
    return parts

def __str_rsplit(text: str, sep: str, limit: int = -1, __at: str) -> list[str]:
    """`text.rsplit(sep, limit)`: like `split`, but the splits are made from the right."""
    if len(sep) == 0:
        __panic_at("rsplit(): empty separator", __at)
    parts: list[str] = []
    rest = text
    splits = 0
    while limit < 0 or splits < limit:
        at = __str_rfind(rest, sep)
        if at < 0:
            break
        parts.append(rest[at + len(sep):])
        rest = rest[:at]
        splits += 1
    parts.append(rest)
    parts.reverse()
    return parts

def __str_split_lines(text: str) -> list[str]:
    """Lines split at `\n`, `\r\n` and `\r`, without the line breaks; none for an empty text."""
    if len(text) == 0:
        return []
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    if lines[len(lines) - 1] == "":
        lines.pop()
    return lines

def __str_zfill(text: str, width: int) -> str:
    """The text padded with zeros on the left to `width` characters, after a sign if it has one."""
    chars = 0
    for _ in text:
        chars += 1
    if chars >= width:
        return text
    fill = "0" * (width - chars)
    if text.starts_with("-") or text.starts_with("+"):
        return text[:1] + fill + text[1:]
    return fill + text

def ord(character: str, __at: str) -> int:
    code = __str_ord(character)
    if code < 0:
        __panic_at("ord() needs a string of exactly one character", __at)
    return code

def chr(code: int, __at: str) -> str:
    if __chr_ok(code) == 0:
        __panic_at(f"chr(): {code} is not a valid character code", __at)
    return __chr_text(code)

def __chars(text: str) -> list[str]:
    """`list(text)`: the characters of a string."""
    out: list[str] = []
    for character in text:
        out.append(character)
    return out

# -- list

def __list_count[T: Eq](items: list[T], value: T) -> int:
    total = 0
    for item in items:
        if item == value:
            total += 1
    return total

def __list_repeat[T](items: list[T], times: int) -> list[T]:
    """`items * times` and `times * items`."""
    out: list[T] = []
    for _ in range(times):
        out.extend(items)
    return out

def reversed[T](items: list[T]) -> list[T]:
    """The items in the opposite order, as a new list."""
    out: list[T] = []
    for index in range(len(items) - 1, -1, -1):
        out.append(items[index])
    return out

# -- dict

def __dict_get_or_insert[K: Hash, V](entries: dict[K, V], key: K, default: V) -> V:
    """`entries.setdefault(key, default)`: the value for `key`, stored first if it was missing."""
    if key not in entries:
        entries[key] = default
    return entries[key]

def __dict_update[K: Hash, V](entries: dict[K, V], other: dict[K, V]):
    for key, value in other.items():
        entries[key] = value

def __dict_copy[K: Hash, V](entries: dict[K, V]) -> dict[K, V]:
    return {key: value for key, value in entries.items()}

def __dict_pop_or[K: Hash, V](entries: dict[K, V], key: K, default: V) -> V:
    if key in entries:
        value = entries[key]
        entries.pop(key)
        return value
    return default

# -- set
#
# A `set[T]` is a dict whose values are `None` and take no room; the compiler has `add`,
# `discard` and `clear`, and the rest is here. The operators `|`, `&`, `-` and `^` call
# `__set_union`, `__set_intersection`, `__set_difference` and `__set_symmetric_difference`.

def __set_of[T: Hash](items: list[T]) -> set[T]:
    """`set(items)`."""
    out: set[T] = set()
    for item in items:
        out.add(item)
    return out

def __set_copy[T: Hash](items: set[T]) -> set[T]:
    return {item for item in items}

def __set_remove[T: Hash](items: set[T], item: T, __at: str):
    if not items.discard(item):
        __panic_at("remove(): the element is not in the set", __at)

def __set_pop[T: Hash](items: set[T]) -> T?:
    """Removes and returns the element added first, or `None` if the set is empty."""
    for item in items:
        items.discard(item)
        return item
    return None

def __set_update[T: Hash](items: set[T], other: set[T]):
    for item in other:
        items.add(item)

def __set_union[T: Hash](a: set[T], b: set[T]) -> set[T]:
    out = {item for item in a}
    for item in b:
        out.add(item)
    return out

def __set_intersection[T: Hash](a: set[T], b: set[T]) -> set[T]:
    return {item for item in a if item in b}

def __set_difference[T: Hash](a: set[T], b: set[T]) -> set[T]:
    return {item for item in a if item not in b}

def __set_symmetric_difference[T: Hash](a: set[T], b: set[T]) -> set[T]:
    out = {item for item in a if item not in b}
    for item in b:
        if item not in a:
            out.add(item)
    return out

def __set_is_subset[T: Hash](a: set[T], b: set[T]) -> bool:
    for item in a:
        if item not in b:
            return False
    return True

def __set_is_superset[T: Hash](a: set[T], b: set[T]) -> bool:
    return __set_is_subset(b, a)

def __set_is_disjoint[T: Hash](a: set[T], b: set[T]) -> bool:
    for item in a:
        if item in b:
            return False
    return True
