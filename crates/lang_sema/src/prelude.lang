"""
The prelude: traits and types available in every program, without an import.

It is compiled with each program, before the program's own code. The compiler gives the traits
below their meaning: `print` and f-strings use `Display`, `==` uses `Eq`, dict keys need `Hash`,
`?` converts errors to `Error`, and the operators `+`, `-` and `*` on structs use the number
traits.
"""

trait Display:
    def to_str(self) -> str

trait Eq:
    def eq(self, other: Self) -> bool

trait Hash(Eq):
    def hash(self) -> int

trait Copy:
    def copy(self) -> Self

trait Error:
    def message(self) -> str

    def status(self) -> int:
        """The HTTP status of a response reporting this error: 500 unless the error says otherwise."""
        return 500

trait AddNumber:
    def add(self, other: Self) -> Self

trait SubNumber:
    def sub(self, other: Self) -> Self

trait MulNumber:
    def mul(self, other: Self) -> Self

@derive(Eq, Display)
struct ParseError:
    """The error from `int.parse(text)` and `float.parse(text)`."""
    text: str
    expected: str

impl Error for ParseError:
    def message(self) -> str:
        return f"\"{self.text}\" is not a valid {self.expected}"

trait Ord(Eq):
    def cmp(self, other: Self) -> int

trait Number(AddNumber, SubNumber, MulNumber, Ord):
    """Implemented by `int` and `float`; a bound for generic arithmetic."""
    pass

trait Shareable:
    """
    Types whose values can be handed to another task: immutable values, `@frozen` structs of
    shareable fields, and `Mutex`, `Atomic`, `Channel` and `Task`. The compiler decides which
    types have it; it cannot be implemented by hand. `trait Store(Shareable):` requires every
    implementation of `Store` to be shareable.
    """
    pass

@extern("lrt_bytes_at")
def __bytes_at(data: str, index: int) -> int

@extern("lrt_bytes_slice")
def __bytes_slice(data: str, start: int, end: int) -> str

@extern("lrt_bytes_is_utf8")
def __bytes_is_utf8(data: str) -> int

@extern("lrt_bytes_repr")
def __bytes_repr(data: str) -> str

@extern("lrt_bytes_hex")
def __bytes_hex(data: str) -> str

@derive(Eq, Hash)
@frozen
struct bytes:
    """
    Binary data: an immutable sequence of bytes, such as a WebSocket binary message.
    `text.encode()` gives a string's UTF-8 bytes and `data.decode()` the text back; `data[i]` is
    one byte as an `int`, and `len(data)` the number of bytes.
    """
    priv data: str

impl bytes:
    def len(self) -> int:
        return len(self.data)

    def get_index(self, index: int) -> int:
        value = __bytes_at(self.data, index)
        if value < 0:
            panic(f"index {index} is out of range for {len(self.data)} bytes")
        return value

    def slice(self, start: int, end: int) -> bytes:
        """Bytes `start` up to `end`; negative indices count from the end, as in slicing."""
        return bytes(__bytes_slice(self.data, start, end))

    def decode(self) -> str?:
        """The bytes as text, or `None` if they are not valid UTF-8."""
        if __bytes_is_utf8(self.data) == 1:
            return self.data
        return None

    def hex(self) -> str:
        return __bytes_hex(self.data)

impl Display for bytes:
    def to_str(self) -> str:
        return __bytes_repr(self.data)

impl AddNumber for bytes:
    def add(self, other: bytes) -> bytes:
        return bytes(self.data + other.data)

def __bytes(data: str) -> bytes:
    """`text.encode()`; also how the standard library wraps data that is not text."""
    return bytes(data)

def __bytes_data(value: bytes) -> str:
    """The data of a `bytes`, for the standard library to hand to the runtime. Not text."""
    return value.data

trait ToJson:
    """Types that `json.encode` can write. `@derive(Json)` implements it with generated code."""
    pass

trait FromJson:
    """Types that `json.decode` can read. `@derive(Json)` implements it with generated code."""
    pass
