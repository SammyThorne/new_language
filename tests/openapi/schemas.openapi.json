            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Shape"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/again/events": {
      "get": {
