          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Color": {
        "type": "string",
        "enum": [
          "Red",
          "Green"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "at",
          "day",
          "length",
          "owner"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "length": {
            "type": "string",
            "examples": [
              "1h30m0s"
            ]
          },
          "owner": {
            "type": "string",
            "format": "uuid"
          },
          "ends": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "default": null
          }
        }
      },
      "Everything": {
        "type": "object",
        "required": [
          "small",
          "tiny",
          "big",
          "ratio",
          "display-name",
          "tags",
          "pair",
          "frozen",
          "extra",
          "anything"
        ],
        "properties": {
          "small": {
            "type": "integer",
            "format": "int32"
          },
          "tiny": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "big": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "ratio": {
            "type": "number",
            "format": "float"
          },
          "display-name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "pair": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "frozen": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "extra": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            }
          },
          "anything": {},
          "color": {
            "$ref": "#/components/schemas/Color"
          },
          "shape": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Shape"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "default": "hi \"there\""
          },
          "score": {
            "type": "number",
            "format": "double",
            "default": -1.5
          }
        },
        "additionalProperties": false
      },
      "Node": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "format": "int64"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "default": []
          },
          "parent": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Node"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        }
      },
      "Page_Node": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Shape": {
        "oneOf": [
          {
            "type": "object",
            "title": "Circle",
            "required": [
              "type",
              "radius"
            ],
            "properties": {
              "type": {
                "const": "Circle"
              },
              "radius": {
                "type": "number",
                "format": "double"
              }
            }
          },
          {
            "type": "object",
            "title": "Rect",
            "required": [
              "type",
              "w",
              "h"
            ],
            "properties": {
              "type": {
                "const": "Rect"
              },
              "w": {
                "type": "integer",
                "format": "int64"
              },
              "h": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          {
            "type": "object",
            "title": "Empty",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "Empty"
              }
            }
          }
        ],
        "discriminator": {
          "propertyName": "type"
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "page"
        ],
        "properties": {
          "page": {
            "$ref": "#/components/schemas/Page_Node"
          }
        }
      }
    }
  }
}
