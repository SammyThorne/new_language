import http

@frozen
struct Api:
    name: str

impl Api:
    @http.get("/a", tags="todos")
    def tags_not_a_list(self) -> str:
        return "a"

    @http.get("/b", tags=["todos", 3])
    def tags_not_strings(self) -> str:
        return "b"

    @http.get("/c", deprecated=1)
    def deprecated_not_a_bool(self) -> str:
        return "c"

    @http.get("/d", errors=[404, 302])
    def errors_not_error_statuses(self) -> str:
        return "d"

    @http.get("/e", errors=404)
    def errors_not_a_list(self) -> str:
        return "e"

    @http.ws("/f", errors=[404])
    def errors_on_a_websocket(self, ws: http.WebSocket):
        pass

    @http.get("/g", summary="no such keyword")
    def unknown_keyword(self) -> str:
        return "g"

    @http.get("/h", security="token")
    def security_not_a_list(self) -> str:
        return "h"

    @http.get("/i", security=["two words"])
    def security_name_with_a_space(self) -> str:
        return "i"

    @http.post("/j", max_body=0)
    def no_body_at_all(self) -> str:
        return "j"

    @http.post("/k", max_body="10MB")
    def max_body_as_text(self) -> str:
        return "k"

    @http.post("/ok", max_body=1048576)
    def a_megabyte(self) -> str:
        return "ok"

    @http.get("/l", timeout=0)
    def no_time_at_all(self) -> str:
        return "l"

    @http.get("/m", timeout="10s")
    def timeout_as_text(self) -> str:
        return "m"

    @http.get("/ok2", timeout=2.5)
    def two_and_a_half_seconds(self) -> str:
        return "ok"

    @http.post("/n", rate_limit="5 per minute")
    def rate_in_words(self) -> str:
        return "n"

    @http.post("/o", rate_limit="0/minute")
    def no_requests_at_all(self) -> str:
        return "o"

    @http.post("/ok3", rate_limit="5/minute")
    def five_a_minute(self) -> str:
        return "ok"

    @http.get("/ok", tags=["todos", "admin"], deprecated=True, errors=[409, 404, 404], security=["token", "token"])
    def fine(self) -> str:
        """Everything here is accepted."""
        return "ok"

def main():
    server = http.Server()
    server.mount(Api("x"))
