# Timeouts and cancellation (docs/14, milestone 13). Run by crates/lang_cli/tests/cancel.rs,
# which sends requests past their route's, group's and server's timeouts, closes connections in
# the middle of requests, pipelines requests, and asks for a connection to an address that never
# answers. With DATABASE_URL set, `/query` runs a query past its route's timeout.

import datetime
import http
import io
import os
import postgres
import time

@frozen
struct State:
    # Handlers that went on after their deadline: there should be none.
    late: Atomic
    # What cancelled handlers and tasks saw, for `/events`.
    events: Channel[str]

# Sleeps past the route's timeout: the sleep ends early, and the work after it does not run.
def slow(req: http.Request, state: State) -> Result[http.Response]:
    time.sleep(5.0)
    http.check_cancelled()?
    state.late.increment()
    return http.text("finished")

# Waits on a channel nothing is sent on, until the client goes away.
def hang(req: http.Request, state: State) -> Result[http.Response]:
    started = time.monotonic()
    nothing = Channel[str]()
    got = nothing.recv()
    waited = time.monotonic() - started
    state.events.send(f"hang got={got} cancelled={req.cancelled()} quick={waited < 3.0}")
    return http.text("hung")

def pause(req: http.Request) -> Result[http.Response]:
    time.sleep(0.3)
    return http.text(f"paused cancelled={req.cancelled()}")

def events(req: http.Request, state: State) -> Result[http.Response]:
    for _ in range(100):
        match state.events.try_recv():
            case Some(event):
                return http.text(event)
            case None:
                time.sleep(0.05)
    return http.text("no event")

def nap(state: State):
    started = time.monotonic()
    time.sleep(5.0)
    state.events.send(f"nap woke early={time.monotonic() - started < 3.0}")

# Spawns a task, which inherits the deadline: its sleep ends at the deadline too.
def spawner(req: http.Request, state: State) -> Result[http.Response]:
    task = spawn nap(state)
    task.join()
    http.check_cancelled()?
    state.late.increment()
    return http.text("finished")

# Never waits: only `check_cancelled` stops it.
def spin(req: http.Request) -> Result[http.Response]:
    count = 0
    while True:
        count += 1
        if count % 1000 == 0:
            http.check_cancelled()?

def deadline(req: http.Request) -> Result[http.Response]:
    match req.deadline():
        case Some(at):
            left = at.since(datetime.now()).seconds()
            return http.text(f"deadline in {left:.0f}s")
        case None:
            return http.text("no deadline")

def connect(req: http.Request) -> Result[http.Response]:
    to = req.query("to").unwrap_or("")
    started = time.monotonic()
    match http.fetch("GET", f"http://{to}/", connect_timeout=datetime.millis(300)):
        case Ok(response):
            return http.text(f"status {response.status}")
        case Err(error):
            return http.text(f"{error.message()} quick={time.monotonic() - started < 2.0}")

# A query past the route's timeout fails, and the server stops running it.
def query(req: http.Request, db: postgres.Db, state: State) -> Result[http.Response]:
    started = time.monotonic()
    match db.query("select pg_sleep(5)"):
        case Ok(_):
            state.events.send("query finished")
        case Err(error):
            state.events.send(f"query {error.code} {error.message()} quick={time.monotonic() - started < 3.0}")
    return http.text("done")

def still_running(req: http.Request, db: postgres.Db) -> Result[http.Response]:
    sql = "select count(*) as n from pg_stat_activity where query = 'select pg_sleep(5)' and state = 'active'"
    row = db.query_row(sql)?.unwrap()
    return http.text(f"running {row.int('n')?}")

@http.get("/annotated", timeout=0.5)
def annotated() -> Result[str, http.HttpError]:
    """Sleeps past its timeout."""
    time.sleep(5.0)
    http.check_cancelled()?
    return "finished"

def main():
    state = State(Atomic(0), Channel[str](16))
    server = http.Server()
    server.timeout = 30.0
    server.use(http.request_log())
    server.route("GET", "/slow", lambda req: slow(req, state), timeout=0.5)
    server.get("/hang", lambda req: hang(req, state))
    server.get("/pause", pause)
    server.get("/events", lambda req: events(req, state))
    server.get("/late", lambda req: http.text(str(state.late.get())))
    server.get("/spawner", lambda req: spawner(req, state), timeout=0.5)
    server.get("/spin", spin, timeout=0.3)
    server.get("/deadline", deadline)
    server.get("/connect", connect)
    api = server.group("/api")
    api.timeout = 0.5
    api.get("/slow", lambda req: slow(req, state))
    server.mount(annotated)
    match os.getenv("DATABASE_URL"):
        case Some(url):
            db = postgres.connect(url).unwrap()
            server.route("GET", "/query", lambda req: query(req, db, state), timeout=0.5)
            server.get("/running", lambda req: still_running(req, db))
        case None:
            pass
    server.metrics(public=True)
    port = server.bind("127.0.0.1:0").unwrap()
    io.eprint(f"listening on {port}")
    server.serve()
