# Serves the directory named by STATIC_ROOT at /, for crates/lang_cli/tests/static_files.rs.

import http
import io
import os

def main():
    server = http.Server()
    server.static("/", os.getenv("STATIC_ROOT").unwrap())
    port = server.bind("127.0.0.1:0").unwrap()
    io.eprint(f"listening on {port}")
    server.serve()
