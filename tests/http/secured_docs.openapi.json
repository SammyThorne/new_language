{
  "openapi": "3.1.0",
  "info": {
    "title": "Notes",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "notes",
      "description": "Reading and **writing** notes."
    },
    {
      "name": "admin"
    }
  ],
  "paths": {
    "/notes": {
      "get": {
        "operationId": "list",
        "tags": [
          "notes"
        ],
        "summary": "List the notes. Anyone may read them.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "add",
        "tags": [
          "notes"
        ],
        "summary": "Add a note.",
        "description": "Needs a token: `Authorization: Bearer <token>`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Note"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/report": {
      "get": {
        "operationId": "report",
        "tags": [
          "admin"
        ],
        "summary": "How many notes were added, for an API key or a token.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "key": []
          },
          {
            "token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Note": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "Report": {
        "type": "object",
        "required": [
          "notes"
        ],
        "properties": {
          "notes": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "login": {
        "type": "http",
        "scheme": "basic"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      },
      "token": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Ask the owner for one."
      }
    }
  }
}
