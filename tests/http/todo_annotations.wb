# Milestone 8 exit program: the todo service from docs/05, written with route annotations.
# The HTTP test in crates/lang_cli/tests/http.rs starts it and sends it a script of requests.

import http
import io
import log
import time

@derive(Json)
@frozen
struct Todo:
    id: int
    title: str
    done: bool = False

@derive(Json)
@frozen
struct NewTodo:
    title: str

@derive(Json)
@frozen
struct Update:
    title: str?
    done: bool?

@frozen
struct App:
    todos: Mutex[dict[int, Todo]]
    next_id: Atomic[int]

impl App:
    @http.get("/todos")
    def list(self, limit: int = 50, done: bool? = None) -> list[Todo]:
        with self.todos.lock() as todos:
            matching = [t for t in todos.values() if done is None or t.done == done]
            return matching[:limit]

    @http.post("/todos", status=201)
    def create(self, body: NewTodo) -> Result[Todo]:
        if body.title.strip() == "":
            return Err(http.Error(422, "the title is empty"))
        todo = Todo(id=self.next_id.increment(), title=body.title)
        with self.todos.lock() as todos:
            todos[todo.id] = todo
        return todo

    @http.get("/todos/{id}")
    def get(self, id: int) -> Result[Todo]:
        with self.todos.lock() as todos:
            match todos.get(id):
                case Some(todo):
                    return todo
                case None:
                    return Err(http.Error(404, "todo not found"))

    @http.patch("/todos/{id}")
    def update(self, id: int, body: Update) -> Result[Todo]:
        with self.todos.lock() as todos:
            match todos.get(id):
                case Some(old):
                    updated = Todo(id, body.title.unwrap_or(old.title), body.done.unwrap_or(old.done))
                    todos[id] = updated
                    return updated
                case None:
                    return Err(http.Error(404, "todo not found"))

    @http.delete("/todos/{id}")
    def remove(self, id: int):
        with self.todos.lock() as todos:
            todos.pop(id)

@http.get("/health")
def health() -> str:
    return "ok"

@http.get("/boom")
def boom(req: http.Request) -> str:
    """A handler with a bug: the panic becomes a 500 and the server carries on."""
    return req.path.split("/")[10]

@http.get("/echo/{rest...}")
def echo(rest: str, req: http.Request) -> http.Response:
    return http.text(f"{req.method} {rest} from {req.header('User-Agent').unwrap_or('?')}")

def request_log(req: http.Request, next: http.Handler) -> Result[http.Response]:
    start = time.now()
    resp = next(req)?
    log.debug(f"{req.method} {req.path} {resp.status} {time.since(start):.4f}s")
    return resp

def main():
    app = App(todos=Mutex({}), next_id=Atomic(0))
    server = http.Server()
    server.use(request_log)
    server.mount(app, prefix="/api")
    server.mount(health)
    server.mount(echo)
    server.mount(boom)
    port = server.bind("127.0.0.1:0").unwrap()
    io.eprint(f"listening on {port}")
    server.serve()
    io.eprint("stopped")
