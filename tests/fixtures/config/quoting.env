# Every form a value can take (tests/run/config_env.vi).

PLAIN=hello world
SPACED   =   trimmed both ends   
EMPTY=
ONLY_COMMENT=   # nothing before the comment
TRAILING=value # a comment
HASH_IN_VALUE=http://example.com/#anchor
export EXPORTED=yes
SINGLE='kept \n as # written'
DOUBLE="tab\there \"quoted\" back\\slash \q"
DOUBLE_COMMENT="x" # after the quote
MULTI="first
second"
KEY='-----BEGIN KEY-----
abc
-----END KEY-----'
EQUALS=a=b=c
REPEATED=first
REPEATED=last
PRESET=from the file
