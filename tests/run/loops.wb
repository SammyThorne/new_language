# while, break, continue, nested loops, stepped ranges, definite assignment.
# expect: 10 8 6 4 2
# expect: found 7 after 3 tries
# expect: 1:1 1:2 2:1 2:2
# expect: big
# expect: 3

def describe(n: int) -> str:
    if n > 10:
        label = "big"
    elif n > 5:
        label = "medium"
    else:
        label = "small"
    return label

def main():
    line = ""
    for i in range(10, 0, -2):
        line = line + str(i) + " "
    print(line.strip())

    tries = 0
    candidate = 4
    while True:
        tries += 1
        candidate += 1
        if candidate % 7 != 0:
            continue
        break
    print(f"found {candidate} after {tries} tries")

    pairs = ""
    for a in range(1, 4):
        if a == 3:
            break
        for b in range(1, 3):
            pairs = pairs + f"{a}:{b} "
    print(pairs.strip())
    print(describe(11))

    count = 0
    while count < 3:
        count += 1
    print(count)
