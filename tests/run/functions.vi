# Functions, parameters, locals and integer arithmetic.
# expect: Hello, Ada
# expect: 7
# expect: 42 True False None
# expect: -9223372036854775808
# expect: 6
# expect: -2 -9223372036854775808
# expect: 8 9 10

struct Pen:
    width: int
    extra: int = 7

def pen_size(pen: Pen = Pen(1)) -> int:
    # A default that constructs a struct whose own field has a default.
    return pen.width + pen.extra

def greet(name: str):
    print("Hello,", name)

def add(a: int, b: int) -> int:
    return a + b

def main():
    greet("Ada")
    print(add(3, 4))
    answer = add(40, 2)
    print(answer, True, not True, None)
    largest: int = 9223372036854775807
    print(largest + 1)  # wraps around, as in Go
    print(area(2, 3))  # functions may be defined after their use
    lowest = -9223372036854775808
    print(-5 - -3, lowest)
    print(pen_size(), pen_size(Pen(2)), pen_size(Pen(1, 9)))

def area(width: int, height: int) -> int:
    return width * height
