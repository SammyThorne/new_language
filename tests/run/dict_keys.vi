# Dict lookups through the typed entry points (docs/10, milestone 4: `str` keys as pointer and
# length, `int` keys by value) must agree with the generic paths that copy, compare and remove,
# for `str` keys of every length from 0 to 40, ASCII or not, shared or copied, and for negative,
# consecutive and extreme `int` keys. A linear list of pairs is the reference.
# expect: str keys: 122 distinct, 122 found, 0 wrong
# expect: str after pops: 81 left, 0 wrong
# expect: str copy equal: True True
# expect: int keys: 1003 distinct, 0 wrong
# expect: int after pops: 501 left, 0 wrong
# expect: int copy equal: True
# expect: 7 7 True

def find_str(pairs: list[tuple[str, int]], key: str) -> int:
    for k, v in pairs:
        if k == key:
            return v
    return -1

def find_int(pairs: list[tuple[int, int]], key: int) -> int:
    for k, v in pairs:
        if k == key:
            return v
    return -1

def main():
    d: dict[str, int] = {}
    pairs: list[tuple[str, int]] = []
    candidates: list[str] = []
    for n in range(41):
        candidates.append("k" * n)
        candidates.append("é" * n)
        candidates.append(f"{n}:" + "xy" * (n // 2))
    for i in range(len(candidates)):
        key = candidates[i]
        d[key] = i
        found = False
        for j in range(len(pairs)):
            if pairs[j][0] == key:
                pairs[j] = (key, i)
                found = True
        if not found:
            pairs.append((key, i))
    wrong = 0
    hits = 0
    for key, value in pairs:
        if key in d and d[key] == value and d.get_or(key, -1) == value:
            hits += 1
        else:
            wrong += 1
    for key in ["missing", "k" * 41, "é" * 41, "kk" + "é"]:
        if key in d:
            wrong += 1
    print(f"str keys: {len(d)} distinct, {hits} found, {wrong} wrong")

    kept: list[tuple[str, int]] = []
    for i in range(len(pairs)):
        if i % 3 == 0:
            d.pop(pairs[i][0])
        else:
            kept.append(pairs[i])
    wrong = 0
    for key, value in pairs:
        expected = find_str(kept, key)
        if d.get_or(key, -1) != expected:
            wrong += 1
    print(f"str after pops: {len(d)} left, {wrong} wrong")
    copy = {k: v for k, v in d.items()}
    literal = {"": 1, "a": 2}
    print("str copy equal:", copy == d, literal == {"a": 2, "": 1})

    ints: dict[int, int] = {}
    int_pairs: list[tuple[int, int]] = []
    numbers: list[int] = [9223372036854775807, -9223372036854775807 - 1, 4611686018427387904, -1]
    for i in range(-500, 500):
        numbers.append(i)
    for i in range(len(numbers)):
        ints[numbers[i]] = i * 7
        int_pairs.append((numbers[i], i * 7))
    ints[-1] = 3
    for j in range(len(int_pairs)):
        if int_pairs[j][0] == -1:
            int_pairs[j] = (-1, 3)
    wrong = 0
    for number, value in int_pairs:
        if not (number in ints) or ints[number] != value:
            wrong += 1
    print(f"int keys: {len(ints)} distinct, {wrong} wrong")
    kept_ints: list[tuple[int, int]] = []
    for i in range(len(int_pairs)):
        if int_pairs[i][0] % 2 == 0:
            ints.pop(int_pairs[i][0])
        else:
            kept_ints.append(int_pairs[i])
    wrong = 0
    for number, _ in int_pairs:
        expected = find_int(kept_ints, number)
        actual = ints.get_or(number, -1)
        if actual != expected:
            wrong += 1
    print(f"int after pops: {len(ints)} left, {wrong} wrong")
    print("int copy equal:", {k: v for k, v in ints.items()} == ints)

    text = "prefix-shared-key"
    shared = text[7:13]
    fresh = "sha" + "red"
    counts: dict[str, int] = {}
    counts[shared] = 7
    print(counts[fresh], counts.get_or(fresh, 0), fresh in counts)
