# `count`, `*`, `reversed`, `list(...)`, `ord` and `chr`, written in the prelude (docs/11,
# milestone 2). Each line is what the same calls give in Python, which `reversed(x)` and
# `list(...)` match by giving lists.
# expect: 3 0 2 2
# expect: 2 2 1
# expect: [0, 0, 0] ['ab', 'ab'] [] [] [[0], [0]]
# expect: [0, 5, 0]
# expect: [[1, 0], [1, 0]]
# expect: [3, 2, 3, 1, 3] ['x'] [1, 2, 3]
# expect: True ['a', 'b', 'c'] [0, 1, 2, 3] [2, 6, 10] [3, 2, 1] []
# expect: 5 6
# expect: ['ann', 'bob'] [1, 2]
# expect: [3, 3, 3, 2, 1] ['c', 'b', 'a']
# expect: 65 233 A é 😀 b
# expect: ['a', 'b', 'c'] 294
struct Point:
    x: int
    y: int

@derive(Eq)
struct Tag:
    name: str

def main():
    nums = [3, 1, 3, 2, 3]
    print(nums.count(3), nums.count(9), ["a", "b", "a"].count("a"), [True, False, True].count(True))
    print([Tag("a"), Tag("b"), Tag("a")].count(Tag("a")), [[1], [2], [1]].count([1]), [1.5, 2.5].count(2.5))
    print([0] * 3, 2 * ["ab"], [1, 2] * 0, [1, 2] * -1, [[0]] * 2)
    cells = [0] * 3
    cells[1] = 5
    print(cells)
    grid = [[0] * 2] * 2
    grid[0][0] = 1
    print(grid)
    print(reversed(nums), reversed(["x"]), reversed(reversed([1, 2, 3])))
    print(list(nums) == nums, list("abc"), list(range(4)), list(range(2, 11, 4)), list(range(3, 0, -1)), list(range(0)))
    copy = list(nums)
    copy.append(99)
    print(len(nums), len(copy))
    ages = {"ann": 30, "bob": 25}
    print(list(ages), list({1: "a", 2: "b"}))
    nums.sort(reverse=True)
    print(nums, sorted(["b", "a", "c"], reverse=True))
    print(ord("A"), ord("é"), chr(65), chr(233), chr(0x1F600), chr(ord("a") + 1))
    print([chr(i) for i in range(97, 100)], sum([ord(c) for c in "abc"]))
