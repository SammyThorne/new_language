# `set[T]` (docs/11, milestone 3): literals, comprehensions, `set(...)`, `add`, `discard`,
# the operators `| & - ^`, subset tests and `copy`, `update` and `pop`.
# Python's sets print in an order of their own, so a set is shown here through `sorted`, except
# when it is empty or has one element; the answers are otherwise Python's, apart from `discard`
# giving whether the element was there.
# expect: 3 True False True 1
# expect: [1, 2, 3, 4] [3] [1, 2] [4] [1, 2, 4]
# expect: [1, 2, 3, 4] [3] [1, 2] [1, 2, 4]
# expect: True False True False True False
# expect: True False True True True [1, 2, 3]
# expect: set() 0 {5} True True True
# expect: [10, 11] True False [11] 1
# expect: [1, 2, 11]
# expect: [1, 2, 11] False True 3
# expect: set() 0 True
# expect: ['apple', 'fig', 'pear'] True False ['i', 'm', 'p', 's'] [1, 2, 3]
# expect: [0, 1, 2] [3, 4, 5] ['apple', 'pear']
# expect: [(1, 2), (3, 4)] True 2
# expect: 18 6 9 2 True False
# expect: [1, 2] [3] True True
# expect: ['a', 'b', 'c'] 3 ['a', 'b', 'c']
# expect: [(0, 1), (0, 2), (1, 2)] 3
# expect: 500 True False True
@derive(Eq, Hash)
struct Point:
    x: int
    y: int

def show(items: set[int]) -> str:
    return str(sorted(items))

def main():
    a = {1, 2, 3}
    b = {3, 4}
    print(len(a), 2 in a, 9 in a, 9 not in a, len({7, 7, 7}))
    print(show(a | b), show(a & b), show(a - b), show(b - a), show(a ^ b))
    print(show(a.union(b)), show(a.intersection(b)), show(a.difference(b)), show(a.symmetric_difference(b)))
    print(a.is_subset({1, 2, 3, 4}), a.is_subset({1, 2}), {1, 2, 3, 4}.is_superset(a), a.is_superset({9}), a.is_disjoint({7, 8}), a.is_disjoint(b))
    print(a == {3, 2, 1}, a == b, a != b, {1} == {1}, set([1, 2]) == {2, 1}, show(a))
    empty: set[int] = set()
    print(empty, len(empty), {5}, empty == set(), empty.is_subset(a), a.is_superset(empty))
    s = {10}
    s.add(11)
    s.add(10)
    print(show(s), s.discard(10), s.discard(10), show(s), len(s))
    s.update({1, 2})
    print(show(s))
    t = s.copy()
    t.add(99)
    popped = t.pop().unwrap()
    print(show(s), popped in t, popped in s or popped == 99, len(t))
    s.clear()
    print(s, len(s), s.pop() is None)
    words = {"pear", "apple", "fig"}
    print(sorted(words), "fig" in words, "kiwi" in words, sorted(set("mississippi")), sorted(set([3, 1, 3, 2, 1])))
    print(sorted({x % 3 for x in range(10)}), sorted({len(w) for w in words}), sorted({w for w in words if "p" in w}))
    print(sorted({(1, 2), (3, 4), (1, 2)}), (3, 4) in {(1, 2), (3, 4)}, len({Point(1, 2), Point(1, 2), Point(2, 1)}))
    total = 0
    for item in {5, 6, 7, 5}:
        total += item
    print(total, sum({1, 2, 2, 3}), max({4, 9, 2}), min({4, 9, 2}), any({False, True}), all({True, False}))
    nested = {1: {1, 2}, 2: set([3])}
    print(sorted(nested[1]), sorted(nested[2]), {1: 2} == {1: 2}, [{1}, {2}] == [{1}, {2}])
    seen: set[str] = set()
    for word in ["a", "b", "a", "c", "b"]:
        seen.add(word)
    print(sorted(seen), len(seen), sorted(list(seen)))
    pairs = {(i, j) for i in range(3) for j in range(3) if i < j}
    print(sorted(pairs), len(pairs))
    big = {0}
    for i in range(5000):
        big.add(i * 7 % 1000)
    for i in range(0, 1000, 2):
        big.discard(i)
    print(len(big), 7 in big, 14 in big, 993 in big)
