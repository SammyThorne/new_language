# Integer and float arithmetic, matching Python except that `int` wraps on overflow.
# expect: -4 1 -1 -4 3.0 0.5 1024 1.4142135623730951 0.3333333333333333 5.0
# expect: 8 -4 1 7 6 -6 3 -3 3.0 5 2.5
# expect: 0.30000000000000004 1e+16 6.0 2.5e-05 0.14285714285714285 100.0 -0.0
# expect: 3.14|   3.142|1,234,567|   1234567|00042|0xff|25.0%|**ab**|3.141590e+00|3.14159|+1.5
# expect: True True True True 3
# expect: -9223372036854775808 0 0 -1
# expect: 7.5 2.0 9.5

def main():
    print(-7 // 2, -7 % 2, 7 % -2, 7 // -2, 7.5 // 2, -7.5 % 2, 2 ** 10, 2.0 ** 0.5, 1 / 3, 10 / 2)
    print(1 << 3, -16 >> 2, 5 & 3, 5 | 3, 5 ^ 3, ~5, int(3.9), int(-3.9), float(3), abs(-5), abs(-2.5))
    print(0.1 + 0.2, 1e16, 3.0 * 2, 2.5e-5, 1 / 7, 100.0, -0.0)
    x = 3.14159
    n = 1234567
    print(f"{x:.2f}|{x:8.3f}|{n:,}|{n:>10}|{42:05d}|{255:#x}|{0.25:.1%}|{'ab':*^6}|{x:e}|{x:g}|{1.5:+.1f}")
    print(1 == 1.0, "abc" < "abd", "b" > "abc", True and not False, 3 if 2 > 1 else 4)
    biggest = 9223372036854775807
    lowest = -9223372036854775808
    print(biggest + 1, 1 << 64, lowest // -1 + lowest, -1 >> 70)
    half = 2.5
    total: float = 5
    print(total + half, half - 0.5, half * 2 + 4.5)
