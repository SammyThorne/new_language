# `print` with `sep`, `end` and `flush` (docs/11, milestone 1.6).
# expect: a-b-c
# expect: 1, 2, 3.
# expect: no newline here|next
# expect: x
# expect: 
# expect: 7
# expect: a b
# expect: 1 -- 2 -- 3 !
def main():
    print("a", "b", "c", sep="-")
    print(1, 2, 3, sep=", ", end=".\n")
    print("no newline here", end="|")
    print("next")
    print("x", end="\n", flush=True)
    print(end="\n")
    print(7, flush=False)
    print("a", "b", sep=" ", end="\n")
    sep = " -- "
    print(1, 2, 3, sep=sep, end=" !\n")
