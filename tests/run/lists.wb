# Lists: literals, indexing, mutation, methods, slicing, iteration, printing.
# expect: [3, 1, 2] 3 2 3
# expect: [3, 10, 1, 2, 5, 6]
# expect: 6 [3, 10, 2, 5]
# expect: [2, 3, 5, 10] [10, 5, 3, 2]
# expect: ['apple', 'banana', 'cherry'] [1.5, 2.25]
# expect: 2 True False
# expect: [[1, 2], [3]] [(1, 'a'), (2, 'b')]
# expect: [5, 3] [] [2, 3, 5, 3]
# expect: True False
# expect: 20
# expect: [0, 1, 4, 9, 16]

def squares(n: int) -> list[int]:
    out: list[int] = []
    for i in range(n):
        out.append(i * i)
    return out

def main():
    xs = [3, 1, 2]
    print(xs, xs[0], xs[-1], len(xs))
    xs.insert(1, 10)
    xs.extend([5, 6])
    print(xs)
    last = xs.pop()
    xs.remove(1)
    print(last, xs)
    ys = xs.copy()
    ys.sort()
    xs.sort()
    xs.reverse()
    print(ys, xs)
    words = ["cherry", "apple", "banana"]
    words.sort()
    print(words, [1.5, 2.25])
    print(ys.index(5), 10 in ys, 7 in ys)
    print([[1, 2], [3]], [(1, "a"), (2, "b")])
    print(xs[1:3], xs[5:], ys[:2] + xs[1:3])
    print([1, 2] == [1, 2], [1, 2] == [2, 1])
    total = 0
    for value in ys:
        total += value
    print(total)
    print(squares(5))
