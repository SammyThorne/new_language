# Milestone 1 exit program: a prime sieve using only scalars (trial division).
# expect: 168 primes below 1000
# expect: largest: 997
# expect: sum: 76127

def is_prime(n: int) -> bool:
    if n < 2:
        return False
    divisor = 2
    while divisor * divisor <= n:
        if n % divisor == 0:
            return False
        divisor += 1
    return True

def main():
    count = 0
    largest = 0
    total = 0
    for n in range(1000):
        if not is_prime(n):
            continue
        count += 1
        total += n
        largest = n
    print(count, "primes below 1000")
    print("largest:", largest)
    print("sum:", total)
