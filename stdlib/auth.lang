"""
Sign-in with Google: the login, callback and logout routes, a signed session cookie, and the
checks of Google's tokens. The program points it at the credentials file it downloaded from the
Google Cloud console and marks the routes that need a signed-in user.

    import http
    import auth
    import os

    def notes(req: http.Request) -> Result[http.Response]:
        user = auth.user(req).unwrap()                  # always `Some` behind `auth.protect`
        return http.text(f"notes of {user.name}")

    def main():
        server = http.Server()
        google = auth.google("secrets/client_secret.json", secret=os.getenv("SESSION_SECRET")).unwrap()
        google.install(server)                          # /auth/google/login, the callback, /auth/logout
        server.get("/notes", auth.protect(notes))
        server.listen(":8080").unwrap()

A signed-out request to a protected route is refused: a browser opening a page is sent to the
login route, which brings it back after signing in, and anything else gets
`401 {"error": "sign-in required"}`. The session is a cookie signed with the session secret; it
holds the `User` and nothing else, so no database is needed and Google's tokens are not kept.
"""

import http
import crypto
import json
import time
import log
import os
import io

# Google's issuer; ID tokens may also give it without the scheme.
const ISSUER = "https://accounts.google.com"
# How long a sign-in may take, from the login route to the callback, in seconds.
const FLOW_SECONDS = 600
# The clock difference allowed when checking a token's times, in seconds.
const SKEW = 60
# The request locals the session middleware sets.
const USER_KEY = "auth.user"
const LOGIN_KEY = "auth.login"
# The security scheme of protected routes in the API documentation (docs/12). The compiler
# names it too, in `check/http.rs`.
const SCHEME = "session"
# The name the scheme had when Google was the only provider; kept as an alias.
const OLD_SCHEME = "googleSession"

# ---- errors -------------------------------------------------------------------------------

pub struct AuthError:
    """Why sign-in could not be set up: the credentials, the redirect URI or the session
    secret. The message says what to change."""
    message: str

impl Error for AuthError:
    def message(self) -> str:
        return self.message

impl Display for AuthError:
    def to_str(self) -> str:
        return self.message

# ---- users and tokens ---------------------------------------------------------------------

@derive(Json)
@frozen
pub struct User:
    """
    A signed-in user, from Google's ID token. `id` is Google's account ID (the `sub` claim):
    key your records on it, not on the email address, which the user can change. The profile
    fields are `""` when Google does not give them; `domain` is the Google Workspace domain, or
    `""` for a personal account.
    """
    id: str
    email: str = ""
    email_verified: bool = False
    name: str = ""
    given_name: str = ""
    family_name: str = ""
    picture: str = ""
    domain: str = ""
    provider: str = "google"

@frozen
pub struct Tokens:
    """Google's reply to a sign-in, handed to `on_login`: the access token for calling Google
    APIs as the user, the refresh token (only with offline access), when the access token
    expires (seconds since 1970), the scopes granted, and the ID token. The module keeps none
    of them; store what you need in `on_login`."""
    access_token: str
    refresh_token: str?
    expires_at: float
    scope: str
    id_token: str

pub type LoginHook = def(User, Tokens) -> Result[User, http.HttpError]
"""Called after each sign-in with the user and Google's tokens: return the user, with any
fields changed but `id`, to sign them in, or an error (`http.Error(403, "...")`) to refuse."""

@frozen
pub struct Endpoints:
    """Where sign-in sends users and requests: Google's, unless a test points a provider at a
    fake Google with `auth.google_for_tests(endpoints=...)`. `keys` is the JSON Web Key Set the
    ID tokens' signatures are checked with; a test provider with `keys=""` does not check them,
    for a fake Google that cannot sign."""
    authorize: str = "https://accounts.google.com/o/oauth2/v2/auth"
    token: str = "https://oauth2.googleapis.com/token"
    keys: str = "https://www.googleapis.com/oauth2/v3/certs"
    # The issuer ID tokens must name, exactly; "" for Google's two spellings. It may hold
    # `{tenantid}`, which a token's `tid` claim fills in (Microsoft's multi-tenant endpoints).
    issuer: str = ""
    # The signing algorithms accepted, separated by spaces: `RS256`, `ES256`.
    algorithms: str = "RS256"
    # The base URL of an OAuth 2 provider's API with no ID token (GitHub's): the user is read
    # from `<api>/user` and `<api>/user/emails` with the access token. "" for OpenID Connect.
    api: str = ""

# ---- the provider -------------------------------------------------------------------------

@frozen
pub struct Provider:
    """
    Sign-in with Google, set up by `auth.google(...)`. `install(server)` adds its routes and the
    middleware that reads the session cookie.
    """
    priv client_id: str
    priv client_secret: str
    priv redirect_uri: str
    priv callback_path: str
    priv scope: str
    priv allowed_domains: tuple[str, ...]
    priv allowed_emails: tuple[str, ...]
    priv require_verified_email: bool
    priv session_seconds: int
    priv login_path: str
    priv logout_path: str
    priv after_logout: str
    priv on_login: LoginHook?
    priv session_key: bytes
    priv flow_key: bytes
    priv session_cookie: str
    priv flow_cookie: str
    priv secure: bool
    priv endpoints: Endpoints
    priv key_cache: Mutex[KeyCache]
    priv name: str
    priv title: str

@frozen
struct Key:
    """A public key of the JSON Web Key Set: an RSA key's modulus and exponent, or (`ec`) a P-256
    key's `x` and `y`, in the same two fields."""
    n: bytes
    e: bytes
    ec: bool = False

struct KeyCache:
    keys: frozendict[str, Key]
    # When to fetch the keys again (seconds since 1970); 0 before the first fetch.
    expires: float

pub def google(
    credentials: str = "",
    secret: str? = None,
    redirect_uri: str = "",
    scopes: list[str] = ["openid", "email", "profile"],
    allowed_domains: list[str] = [],
    allowed_emails: list[str] = [],
    require_verified_email: bool = True,
    session_days: int = 7,
    login_path: str = "/auth/google/login",
    logout_path: str = "/auth/logout",
    after_logout: str = "/",
    on_login: LoginHook? = None,
) -> Result[Provider, AuthError]:
    """
    Set up sign-in with Google.

    - `credentials` is the path of the OAuth client file from the Google Cloud console (APIs &
      Services > Credentials > your web client > Download JSON). With `""`, the path is read
      from `GOOGLE_CLIENT_SECRETS`, or the client from `GOOGLE_CLIENT_ID` and
      `GOOGLE_CLIENT_SECRET` (then give `redirect_uri=`).
    - `secret` signs the session cookie: at least 32 bytes, the same on every instance. `None`
      reads `SESSION_SECRET`. Without one, a key is made for this run (sign-ins end when the
      program stops) on `http://localhost`, and setting up fails for an `https` redirect URI.
    - `redirect_uri` is the one registered in the console that Google sends users back to; its
      path becomes the callback route. `""` takes the file's only one.
    - `allowed_domains` limits sign-in to Google Workspace domains, and `allowed_emails` to
      addresses; empty allows any account. `require_verified_email` refuses accounts whose
      address Google has not verified.
    - `session_days` is how long a sign-in lasts.
    - `on_login` is called after each sign-in (see `LoginHook`).
    """
    client = read_client(credentials, redirect_uri)?
    return make_provider(
        client.id,
        client.secret,
        client.redirect_uri,
        secret,
        scopes,
        allowed_domains,
        allowed_emails,
        require_verified_email,
        session_days,
        login_path,
        logout_path,
        after_logout,
        on_login,
        Endpoints(),
    )

pub def google_for_tests(
    secret: str = "a session secret for tests, never for a real program",
    endpoints: Endpoints? = None,
    redirect_uri: str = "http://localhost:8080/auth/google/callback",
    allowed_domains: list[str] = [],
    allowed_emails: list[str] = [],
    require_verified_email: bool = True,
    on_login: LoginHook? = None,
) -> Provider:
    """A provider for tests, without a credentials file: its client ID is
    `test-client.apps.googleusercontent.com` and its secret `test-secret`. Use it with
    `test_cookie` to sign requests in, or point `endpoints` at a fake Google to test the whole
    sign-in."""
    match make_provider(
        "test-client.apps.googleusercontent.com",
        "test-secret",
        redirect_uri,
        Some(secret),
        ["openid", "email", "profile"],
        allowed_domains,
        allowed_emails,
        require_verified_email,
        7,
        "/auth/google/login",
        "/auth/logout",
        "/",
        on_login,
        endpoints.unwrap_or(Endpoints()),
    ):
        case Ok(provider):
            return provider
        case Err(problem):
            panic(problem.message)

pub def oidc(
    issuer: str,
    name: str = "oidc",
    title: str = "",
    client_id: str = "",
    client_secret: str = "",
    redirect_uri: str = "",
    secret: str? = None,
    scopes: list[str] = ["openid", "email", "profile"],
    allowed_domains: list[str] = [],
    allowed_emails: list[str] = [],
    require_verified_email: bool = True,
    session_days: int = 7,
    login_path: str = "",
    logout_path: str = "/auth/logout",
    after_logout: str = "/",
    on_login: LoginHook? = None,
) -> Result[Provider, AuthError]:
    """
    Set up sign-in with any OpenID Connect provider, found from `issuer`: the provider's
    discovery document at `<issuer>/.well-known/openid-configuration` names its endpoints and
    signing keys. ID tokens must name exactly that issuer and be signed with RS256 or ES256.

    `name` is the provider's short name: it is `User.provider`, the routes are
    `/auth/<name>/login` and the callback's path comes from `redirect_uri`, and the client is
    read from `<NAME>_CLIENT_ID` and `<NAME>_CLIENT_SECRET` unless `client_id=` and
    `client_secret=` are given. Users' `id`s are `<name>:<sub>`. The other arguments are those of
    `google`.
    """
    prefix = name.upper().replace("-", "_")
    id = client_id
    if id == "":
        id = os.getenv(prefix + "_CLIENT_ID").unwrap_or("")
    password = client_secret
    if password == "":
        password = os.getenv(prefix + "_CLIENT_SECRET").unwrap_or("")
    if id == "" or password == "":
        return Err(AuthError(f"no {name} client: give `client_id=` and `client_secret=`, or set {prefix}_CLIENT_ID and {prefix}_CLIENT_SECRET"))
    redirect = redirect_uri
    if redirect == "":
        redirect = os.getenv(prefix + "_REDIRECT_URI").unwrap_or("")
    if redirect == "":
        return Err(AuthError(f"give `redirect_uri=` (or set {prefix}_REDIRECT_URI): the one registered for the client with {name}"))
    endpoints = discover(issuer)?
    return make_provider(
        id,
        password,
        redirect,
        secret,
        scopes,
        allowed_domains,
        allowed_emails,
        require_verified_email,
        session_days,
        login_path if login_path != "" else f"/auth/{name}/login",
        logout_path,
        after_logout,
        on_login,
        endpoints,
        name,
        title if title != "" else name,
    )

pub def oidc_for_tests(
    name: str = "oidc",
    issuer: str = "https://idp.test",
    endpoints: Endpoints? = None,
    secret: str = "a session secret for tests, never for a real program",
