pub def install_all(server: http.Server, providers: list[Provider], csrf: bool = True):
    """
    Install several providers on one server: one session middleware and one logout route, and a
    login and callback route for each. They must share one `secret`, so that a session from any
    of them reads the same; give each its own `redirect_uri` path and `login_path` (the
    defaults differ by name).
    """
    if len(providers) == 0:
        return
    providers[0].install(server, csrf)
    for index in range(1, len(providers)):
        providers[index].install_routes(server)

def discover(issuer: str) -> Result[Endpoints, AuthError]:
    """The endpoints from an issuer's discovery document, checked to name the issuer asked for."""
    base = issuer
    if base.ends_with("/"):
        base = base[:len(base) - 1]
    url = base + "/.well-known/openid-configuration"
    match http.get(url):
        case Ok(answer):
            if not answer.ok():
                return Err(AuthError(f"{url} answered {answer.status}: is {issuer} an OpenID Connect issuer?"))
            match answer.json():
                case Ok(doc):
                    named = doc["issuer"].as_str().unwrap_or("")
                    if not issuer_names(issuer, named):
                        return Err(AuthError(f"{url} says its issuer is {named!r}, not {issuer!r}: refusing it"))
                    authorize = doc["authorization_endpoint"].as_str().unwrap_or("")
                    token = doc["token_endpoint"].as_str().unwrap_or("")
                    keys = doc["jwks_uri"].as_str().unwrap_or("")
                    if authorize == "" or token == "" or keys == "":
                        return Err(AuthError(f"{url} lacks an authorization_endpoint, token_endpoint or jwks_uri"))
                    algorithms: list[str] = []
                    match doc["id_token_signing_alg_values_supported"]:
                        case json.Value.Array(items):
                            for item in items:
                                alg = item.as_str().unwrap_or("")
                                if alg == "RS256" or alg == "ES256":
                                    algorithms.append(alg)
                        case _:
                            algorithms = ["RS256"]
                    if len(algorithms) == 0:
                        return Err(AuthError(f"{url} signs ID tokens only with algorithms this module does not support (it supports RS256 and ES256)"))
                    return Endpoints(authorize, token, keys, named, " ".join(algorithms))
                case Err(problem):
                    return Err(AuthError(f"{url} is not JSON: {problem.message()}"))
        case Err(problem):
            return Err(AuthError(f"cannot read {url}: {problem.message()}"))

def api_get(url: str, headers: dict[str, str]) -> Result[json.Value, str]:
    """A JSON answer from a provider's API, or why there is none."""
    match http.fetch("GET", url, headers=headers):
        case Ok(answer):
            if not answer.ok():
                return Err(f"{url} answered {answer.status}")
            match answer.json():
                case Ok(value):
                    return Ok(value)
                case Err(problem):
                    return Err(f"{url} is not JSON: {problem.message()}")
        case Err(problem):
            return Err(f"{url}: {problem.message()}")

def issuer_names(asked: str, named: str) -> bool:
    """Whether a discovery document's issuer is the one asked for; a `{tenantid}` template
    stands for the tenant named in the URL asked for."""
    if named == asked:
        return True
    if "{tenantid}" not in named:
        return False
    before, _, after = named.partition("{tenantid}")
    return asked.starts_with(before) and asked.ends_with(after)

struct Client:
    id: str
    secret: str
    redirect_uri: str

def read_client(credentials: str, redirect_uri: str) -> Result[Client, AuthError]:
    path = credentials
    if path == "":
        match os.getenv("GOOGLE_CLIENT_SECRETS"):
            case Some(found):
                path = found
            case None:
                id = os.getenv("GOOGLE_CLIENT_ID").unwrap_or("")
                secret = os.getenv("GOOGLE_CLIENT_SECRET").unwrap_or("")
                if id == "" or secret == "":
                    return Err(AuthError("no Google client: give the path of the client_secret.json file from the Google Cloud console, or set GOOGLE_CLIENT_SECRETS to it, or set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET"))
                if redirect_uri == "":
                    return Err(AuthError("with GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, give `redirect_uri=`: the one registered for the client in the Google Cloud console"))
                return Client(id, secret, redirect_uri)
    match io.read_file(path):
        case Ok(text):
            return parse_client(text, path, redirect_uri)
        case Err(problem):
            return Err(AuthError(f"cannot read the Google credentials file: {problem.message()}"))

const DOWNLOAD_HELP = "download it from the Google Cloud console: APIs & Services > Credentials > your OAuth client (a web application) > Download JSON"

def parse_client(text: str, path: str, redirect_uri: str) -> Result[Client, AuthError]:
    match json.parse(text):
        case Ok(data):
            section = data["web"]
            if section == json.Value.Null:
                section = data["installed"]
            if section == json.Value.Null:
                return Err(AuthError(f"{path} is not a Google OAuth client file: it has no \"web\" section; {DOWNLOAD_HELP}"))
            id = section["client_id"].as_str().unwrap_or("")
            if id == "":
                return Err(AuthError(f"{path} has no client_id; {DOWNLOAD_HELP}"))
            secret = section["client_secret"].as_str().unwrap_or("")
            if secret == "":
                return Err(AuthError(f"{path} has no client_secret; {DOWNLOAD_HELP}"))
            uris: list[str] = []
            match section["redirect_uris"]:
                case json.Value.Array(items):
                    for item in items:
                        match item.as_str():
                            case Some(uri):
                                uris.append(uri)
                            case None:
                                pass
                case _:
                    pass
            if redirect_uri != "":
                if len(uris) > 0 and redirect_uri not in uris:
                    return Err(AuthError(f"the redirect URI {redirect_uri} is not one of those registered in {path} ({', '.join(uris)}): add it to the client in the Google Cloud console and download the file again"))
                return Client(id, secret, redirect_uri)
            if len(uris) == 0:
                return Err(AuthError(f"{path} has no redirect URI: add one to the client in the Google Cloud console, such as http://localhost:8080/auth/google/callback, and download the file again"))
            if len(uris) > 1:
                return Err(AuthError(f"{path} has several redirect URIs ({', '.join(uris)}): choose one with `redirect_uri=`"))
            return Client(id, secret, uris[0])
        case Err(problem):
            return Err(AuthError(f"{path} is not JSON ({problem.message()}); {DOWNLOAD_HELP}"))

def make_provider(
    client_id: str,
    client_secret: str,
    redirect_uri: str,
    secret: str?,
    scopes: list[str],
    allowed_domains: list[str],
    allowed_emails: list[str],
    require_verified_email: bool,
    session_days: int,
    login_path: str,
    logout_path: str,
    after_logout: str,
    on_login: LoginHook?,
    endpoints: Endpoints,
    name: str = "google",
    title: str = "Google",
) -> Result[Provider, AuthError]:
    secure, callback_path = split_redirect_uri(redirect_uri)?
    plain = endpoints.api != ""
    if plain and require_verified_email and "user:email" not in scopes:
        return Err(AuthError("`require_verified_email` needs the \"user:email\" scope, which reads the account's addresses; add it, or pass `require_verified_email=False`"))
    if not plain and "openid" not in scopes:
        return Err(AuthError(f"the scopes must include \"openid\", which asks {title} who the user is"))
    if not plain and require_verified_email and "email" not in scopes:
        return Err(AuthError("`require_verified_email` needs the \"email\" scope; add it, or pass `require_verified_email=False`"))
    if session_days < 1:
        return Err(AuthError(f"`session_days` must be at least 1, not {session_days}"))
    for label, path in [("login_path", login_path), ("logout_path", logout_path), ("after_logout", after_logout)]:
        if not path.starts_with("/") or path.starts_with("//"):
            return Err(AuthError(f"`{label}` must be a path on this site, starting with one `/`: {path!r}"))
    if callback_path == login_path or callback_path == logout_path:
        return Err(AuthError(f"the redirect URI's path {callback_path} is also the login or logout route; register another, such as /auth/google/callback"))
    master = session_secret(secret, secure)?
    no_keys: dict[str, Key] = {}
    domains = tuple([domain.lower() for domain in allowed_domains])
    emails = tuple([email.lower() for email in allowed_emails])
    session_cookie = "__Host-session" if secure else "session"
    flow_cookie = "__Host-oauth" if secure else "oauth"
    if name != "google":
        flow_cookie = flow_cookie + "-" + name
    return Provider(
        client_id,
        client_secret,
        redirect_uri,
        callback_path,
        " ".join(scopes),
        domains,
        emails,
        require_verified_email,
        session_days * 86400,
        login_path,
        logout_path,
        after_logout,
        on_login,
        crypto.hmac_sha256(master, "auth session v1".encode()),
        crypto.hmac_sha256(master, "auth flow v1".encode()),
        session_cookie,
        flow_cookie,
        secure,
        endpoints,
        Mutex(KeyCache(frozendict(no_keys), 0.0)),
        name,
        title,
    )

def split_redirect_uri(uri: str) -> Result[tuple[bool, str], AuthError]:
    """Whether the redirect URI is `https`, and its path (the callback route)."""
    secure = uri.starts_with("https://")
    rest = ""
    if secure:
        rest = uri[8:]
    elif uri.starts_with("http://"):
        rest = uri[7:]
    else:
        return Err(AuthError(f"the redirect URI must start with https:// (or http://localhost for development): {uri!r}"))
    host, slash, path = rest.partition("/")
    if not secure:
        name = host
        if not host.starts_with("["):
            name, _colon, _port = host.partition(":")
        elif "]" in host:
            name = host[0:host.index("]") + 1]
        if name != "localhost" and name != "127.0.0.1" and name != "[::1]":
            return Err(AuthError(f"the redirect URI must use https, except on localhost: {uri}"))
    if "#" in path or "*" in uri or "@" in host:
        return Err(AuthError(f"the redirect URI cannot have a fragment, a wildcard or a user name: {uri}"))
    path = path.partition("?")[0]
    if slash == "" or path == "":
        return Err(AuthError(f"the redirect URI needs a path for the callback route, such as {uri.rstrip('/')}/auth/google/callback: {uri}"))
    return (secure, "/" + path)

def session_secret(secret: str?, secure: bool) -> Result[bytes, AuthError]:
    text = ""
    match secret:
        case Some(given):
            text = given
        case None:
            match os.getenv("SESSION_SECRET"):
                case Some(found) if found != "":
                    text = found
                case _:
                    if secure:
                        return Err(AuthError("no session secret: set SESSION_SECRET, or pass `secret=`, to at least 32 random characters (`openssl rand -base64 32` makes some). With an https redirect URI it is required, so that sign-ins survive restarts and every instance accepts the others' cookies"))
                    log.warn("no SESSION_SECRET: using a key made for this run, so sign-ins end when the program stops")
                    return crypto.random_bytes(32)
    if len(text.encode()) < 32:
        return Err(AuthError(f"the session secret must be at least 32 bytes, not {len(text.encode())}: `openssl rand -base64 32` makes one"))
    return text.encode()

# ---- signed cookies -----------------------------------------------------------------------

def sign(text: str, key: bytes) -> str:
    """`text` and its MAC, as `base64url(text).base64url(mac)`."""
    body = crypto.base64url_encode(text.encode())
    mac = crypto.hmac_sha256(key, ("v1." + body).encode())
    return body + "." + crypto.base64url_encode(mac)

def unsign(value: str, key: bytes) -> str?:
    """The text `sign` signed with `key`, or `None` if the value was changed or signed with
    another key."""
    body, dot, mac_text = value.partition(".")
    if dot == "":
        return None
    match crypto.base64url_decode(mac_text):
        case Some(mac):
            if not crypto.equal(mac, crypto.hmac_sha256(key, ("v1." + body).encode())):
                return None
            match crypto.base64url_decode(body):
                case Some(data):
                    return data.decode()
                case None:
                    return None
        case None:
            return None

@derive(Json)
struct Session:
    u: User
    iat: int
    exp: int

@derive(Json)
struct Flow:
    state: str
    nonce: str
    verifier: str
    next: str
    exp: int

def now() -> int:
    return int(time.now())

# ---- routes -------------------------------------------------------------------------------

impl Provider:
    def install(self, server: http.Server, csrf: bool = True):
        """Add the login route, the callback route (the redirect URI's path), the logout route
        (`POST`), and the middleware that reads the session cookie on every request, which
        `auth.user`, `auth.required` and `auth.protect` rely on. Unless `csrf=False`, it also
        adds `http.csrf()`: a page on another site cannot make the browser post to a route
        that the session cookie signs in (a server that already has `http.csrf(tokens=True)`
        can pass `csrf=False`)."""
        provider = self
        if csrf:
            server.use(http.csrf())
        scheme = http.api_key(self.session_cookie, cookie=True, description=f"The session cookie. Sign in at {self.login_path}.")
        server.security_scheme(SCHEME, scheme)
        server.security_scheme(OLD_SCHEME, scheme)
        server.use(lambda req, next: provider.middleware(req, next))
        self.install_routes(server)
        server.post(self.logout_path, lambda req: provider.logout(req))

    def install_routes(self, server: http.Server):
        provider = self
        server.get(self.login_path, lambda req: provider.login(req))
        server.get(self.callback_path, lambda req: provider.callback(req))

    def login_url(self, next: str = "/") -> str:
        """The login route's URL, which brings the user back to `next` (a path on this site)."""
        return self.login_path + "?next=" + http.url_encode(next)

    def test_cookie(self, user: User, expires_in: int? = None) -> str:
        """A `Cookie` header that signs a test request in as `user`:
        `http.test_request("GET", "/notes", headers={"Cookie": google.test_cookie(user)})`.
        The sign-in lasts as long as a real one, or `expires_in` seconds; a negative number
        makes one that has ended."""
        issued = now()
        ends = issued + expires_in.unwrap_or(self.session_seconds)
        return self.session_cookie + "=" + sign(json.encode(Session(user, issued, ends)), self.session_key)

    def logout_response(self, location: str = "/") -> http.Response:
        """A response that signs the user out and redirects (303) to `location`: for an app
        that writes its own logout route."""
        response = http.redirect(location, 303)
        response.delete_cookie(self.session_cookie)
        return response

    def session_value(self, user: User) -> str:
        issued = now()
        return sign(json.encode(Session(user, issued, issued + self.session_seconds)), self.session_key)

    # The key that signs sessions, for `bearer`: a plain value, so an app can keep it in a
    # handler (a `Provider` holds a callback, which handlers may not share).
    def signing_key(self) -> bytes:
        return self.session_key

    def middleware(self, req: http.Request, next: http.Handler) -> Result[http.Response]:
        req.set_local(LOGIN_KEY, self.login_path)
        match session_token(req, self.session_cookie):
            case Some(value):
                match unsign(value, self.session_key):
                    case Some(text):
                        match json.decode[Session](text):
                            case Ok(session):
                                if session.exp > now():
                                    req.set_local(USER_KEY, json.encode(session.u))
                            case Err(_):
                                pass
                    case None:
                        pass
            case None:
                pass
        return next(req)

    def login(self, req: http.Request) -> Result[http.Response]:
        target = safe_next(req.query("next").unwrap_or("/"))
        state = crypto.token()
        nonce = crypto.token()
        verifier = crypto.token(48)
        challenge = crypto.base64url_encode(crypto.sha256(verifier.encode()))
        flow = sign(json.encode(Flow(state, nonce, verifier, target, now() + FLOW_SECONDS)), self.flow_key)
        params = [
            ("client_id", self.client_id),
            ("redirect_uri", self.redirect_uri),
            ("response_type", "code"),
            ("scope", self.scope),
            ("state", state),
            ("nonce", nonce),
            ("code_challenge", challenge),
            ("code_challenge_method", "S256"),
        ]
        if self.name == "google":
            params.append(("include_granted_scopes", "true"))
            # Always show Google's account chooser, so a signed-in browser is asked which account to use.
            params.append(("prompt", "select_account"))
        if self.name == "google" and len(self.allowed_domains) == 1:
            params.append(("hd", self.allowed_domains[0]))
        joiner = "&" if "?" in self.endpoints.authorize else "?"
        response = http.redirect(self.endpoints.authorize + joiner + http.form_encode(params))
        response.set_cookie(self.flow_cookie, flow, max_age=FLOW_SECONDS, secure=self.secure)
        return response

    def callback(self, req: http.Request) -> Result[http.Response]:
        flow: Flow? = None
        match req.cookie(self.flow_cookie):
            case Some(value):
                match unsign(value, self.flow_key):
                    case Some(text):
                        match json.decode[Flow](text):
                            case Ok(decoded):
                                if decoded.exp > now():
                                    flow = Some(decoded)
                            case Err(_):
                                pass
                    case None:
                        pass
            case None:
                pass
        match flow:
            case None:
                return self.page(400, "Sign-in expired", "The sign-in took too long, or did not start here.", True)
            case Some(started):
                response = self.finish(req, started)
                response.delete_cookie(self.flow_cookie)
                return response

    def finish(self, req: http.Request, flow: Flow) -> http.Response:
        """The rest of the callback, once the flow cookie is read."""
        match req.query("error"):
            case Some(reason):
                return self.page(401, "Sign-in cancelled", f"{self.title} did not sign you in ({reason}).", True)
            case None:
                pass
        state = req.query("state").unwrap_or("")
        if not crypto.equal(state.encode(), flow.state.encode()):
            return self.page(400, "Sign-in expired", "This sign-in does not match the one this browser started.", True)
        match req.query("iss"):
            case Some(issuer):
                if not self.issuer_matches(issuer, ""):
                    log.warn(f"sign-in: the callback names the issuer {issuer!r}")
                    return self.page(401, "Sign-in failed", "Could not verify the sign-in.", True)
            case None:
                pass
        code = req.query("code").unwrap_or("")
        if code == "":
            return self.page(400, "Sign-in failed", f"{self.title} sent no authorization code.", True)
        fields = [
            ("grant_type", "authorization_code"),
            ("code", code),
            ("redirect_uri", self.redirect_uri),
            ("client_id", self.client_id),
            ("client_secret", self.client_secret),
            ("code_verifier", flow.verifier),
        ]
        reply: json.Value = json.Value.Null
        match http.post_form(self.endpoints.token, fields, {"Accept": "application/json"}):
            case Ok(answer):
                match answer.json():
                    case Ok(value):
                        reply = value
                    case Err(problem):
                        log.warn(f"sign-in: the token endpoint answered {answer.status} without JSON: {problem.message()}")
                        return self.page(502, "Sign-in failed", f"{self.title} could not be reached. Try again later.", True)
                if not answer.ok():
                    error = reply["error"].as_str().unwrap_or("")
                    if error == "invalid_grant":
                        return self.page(400, "Sign-in expired", "The sign-in was already used or took too long.", True)
                    detail = reply["error_description"].as_str().unwrap_or("")
                    if detail != "":
                        error = f"{error}: {detail}"
                    log.error(f"sign-in: the token endpoint refused the code: {answer.status} {error}")
                    return self.page(502, "Sign-in failed", f"{self.title} refused the sign-in. Try again later.", True)
            case Err(problem):
                log.warn(f"sign-in: the token request failed: {problem.message()}")
                return self.page(502, "Sign-in failed", f"{self.title} could not be reached. Try again later.", True)
        id_token = ""
        user = User("")
        if self.endpoints.api != "":
            match self.github_user(reply["access_token"].as_str().unwrap_or("")):
                case Ok(found):
                    user = found
                case Err(reason):
                    log.warn(f"sign-in: reading the {self.title} account failed: {reason}")
                    return self.page(502, "Sign-in failed", f"{self.title} could not be reached. Try again later.", True)
        else:
            id_token = reply["id_token"].as_str().unwrap_or("")
            claims = json.Value.Null
            match self.check_id_token(id_token, flow.nonce):
                case Ok(checked):
                    claims = checked
                case Err(reason):
                    log.warn(f"sign-in: the ID token was refused: {reason}")
                    return self.page(401, "Sign-in failed", "Could not verify the sign-in.", True)
            user = user_of(claims, self.name)
        who = user.email if user.email != "" else user.name
        if self.require_verified_email and not user.email_verified:
            return self.page(403, "Sign-in refused", f"The {self.title} account {who} has no verified email address.", False)
        if len(self.allowed_domains) > 0 and user.domain.lower() not in self.allowed_domains:
            return self.page(403, "Sign-in refused", f"The {self.title} account {who} cannot sign in here.", False)
        if len(self.allowed_emails) > 0 and user.email.lower() not in self.allowed_emails:
            return self.page(403, "Sign-in refused", f"The {self.title} account {who} cannot sign in here.", False)
        match self.on_login:
            case Some(hook):
                expires_in = reply["expires_in"].as_float().unwrap_or(0.0)
                tokens = Tokens(
                    reply["access_token"].as_str().unwrap_or(""),
                    reply["refresh_token"].as_str(),
                    time.now() + expires_in,
                    reply["scope"].as_str().unwrap_or(""),
                    id_token,
                )
                match hook(user, tokens):
                    case Ok(changed):
                        user = User(user.id, changed.email, changed.email_verified, changed.name, changed.given_name, changed.family_name, changed.picture, changed.domain, user.provider)
                    case Err(refused):
                        return self.page(refused.status, "Sign-in refused", refused.message, False)
            case None:
                pass
        response = http.redirect(flow.next)
        # `SameSite=None` lets the browser send the session to an editor on another site, which
        # needs `Secure` (HTTPS); without HTTPS the cookie stays `Lax`.
        response.set_cookie(self.session_cookie, self.session_value(user), max_age=self.session_seconds, secure=self.secure, same_site="None" if self.secure else "Lax")
        return response

    def github_user(self, token: str) -> Result[User, str]:
        """The account an access token belongs to, from GitHub's API: its profile, and its
        primary email address if that is verified."""
        if token == "":
            return Err("the token endpoint gave no access token")
        headers = {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}
        profile = api_get(self.endpoints.api + "/user", headers)?
        id = profile["id"].as_int()
        if id == None:
            return Err("the profile has no id")
        email = ""
        # Without the `user:email` scope this fails, and the account has no email to trust.
        match api_get(self.endpoints.api + "/user/emails", headers):
            case Ok(addresses):
                match addresses.as_list():
                    case Some(items):
                        for item in items:
                            if item["primary"].as_bool() == Some(True) and item["verified"].as_bool() == Some(True):
                                email = item["email"].as_str().unwrap_or("")
                    case None:
                        pass
            case Err(reason):
                log.info(f"sign-in: no email addresses from {self.title}: {reason}")
        name = profile["name"].as_str().unwrap_or("")
        if name == "":
            name = profile["login"].as_str().unwrap_or("")
        return User(
            f"{self.name}:{id.unwrap()}",
            email,
            email != "",
            name,
            "",
            "",
            profile["avatar_url"].as_str().unwrap_or(""),
            "",
            self.name,
        )

    def check_id_token(self, token: str, nonce: str) -> Result[json.Value, str]:
        """The ID token's claims, once its header and claims are checked; or why not."""
        parts = token.split(".")
        if len(parts) != 3:
            return Err("it is not a JSON Web Token")
        header = decode_part(parts[0])
        claims = decode_part(parts[1])
        algorithms = self.endpoints.algorithms.split()
        alg = header["alg"].as_str().unwrap_or("")
        if alg not in algorithms:
            if len(algorithms) == 1:
                return Err(f"its algorithm is {header['alg']}, not {algorithms[0]}")
            return Err(f"its algorithm is {header['alg']}, not one of {', '.join(algorithms)}")
        if self.endpoints.keys != "":
            key = self.key(header["kid"].as_str().unwrap_or(""))?
            signature = crypto.base64url_decode(parts[2]).unwrap_or("".encode())
            signed = (parts[0] + "." + parts[1]).encode()
            valid = False
            if alg == "ES256":
                valid = key.ec and crypto.verify_es256(key.n, key.e, signed, signature)
            else:
                valid = not key.ec and crypto.verify_rs256(key.n, key.e, signed, signature)
            if not valid:
                return Err("its signature is not valid")
        issuer = claims["iss"].as_str().unwrap_or("")
        if not self.issuer_matches(issuer, claims["tid"].as_str().unwrap_or("")):
            return Err(f"its issuer is {issuer!r}")
        match claims["aud"]:
            case json.Value.Str(audience):
                if audience != self.client_id:
                    return Err(f"it is for another client ({audience})")
            case json.Value.Array(audiences):
                if json.Value.Str(self.client_id) not in audiences or claims["azp"].as_str() != Some(self.client_id):
                    return Err("it is for other clients")
            case _:
                return Err("it has no audience")
        current = time.now()
        expires = claims["exp"].as_float().unwrap_or(0.0)
        if expires <= current - float(SKEW):
            return Err(f"it expired at {int(expires)}, and the time is {int(current)} (seconds since 1970); check the server's clock if this repeats")
        issued = claims["iat"].as_float().unwrap_or(current)
        if issued >= current + float(SKEW):
            return Err(f"it was issued at {int(issued)}, after the time now, {int(current)} (seconds since 1970); check the server's clock")
        if not crypto.equal(claims["nonce"].as_str().unwrap_or("").encode(), nonce.encode()):
            return Err("its nonce is not the one this sign-in sent")
        if claims["sub"].as_str().unwrap_or("") == "":
            return Err("it names no account (`sub`)")
        return claims

    def issuer_matches(self, issuer: str, tenant: str) -> bool:
        """Whether a token's `iss` (or the callback's) is the issuer this provider trusts."""
        expected = self.endpoints.issuer
        if expected == "":
            return issuer == ISSUER or issuer == "accounts.google.com"
        if "{tenantid}" in expected:
            if tenant == "":
                return False
            return issuer == expected.replace("{tenantid}", tenant)
        return issuer == expected

    def key(self, id: str) -> Result[Key, str]:
        """The signing key `id` (a token's `kid`), from the cached key set. The set is fetched
        when the cache has expired, and once more for a key it does not have, since Google adds
        keys before signing with them. The lock is held during the fetch, so sign-ins arriving
        together fetch once."""
        with self.key_cache.lock() as cache:
            if time.now() < cache.expires:
                match cache.keys.get(id):
                    case Some(found):
                        return found
                    case None:
                        pass
            fetched, max_age = fetch_keys(self.endpoints.keys)?
            cache.keys = fetched
            cache.expires = time.now() + max_age
            match fetched.get(id):
                case Some(found):
                    return found
                case None:
                    return Err(f"its key {id!r} is not one of {self.title}'s")

    def logout(self, req: http.Request) -> Result[http.Response]:
        match req.header("Origin"):
            case Some(origin):
                _scheme, separator, host = origin.partition("://")
                if separator == "" or host != req.header("Host").unwrap_or(""):
                    return http.error(403, "sign-out from another site refused")
            case None:
                pass
        return self.logout_response(self.after_logout)

    def page(self, status: int, title: str, message: str, retry: bool) -> http.Response:
        """A small page explaining why sign-in stopped, with a link to try again."""
        link = ""
        if retry:
            link = f"<p><a href=\"{escape(self.login_path)}\">Sign in again</a></p>"
        body = f"<!doctype html><meta charset=\"utf-8\"><title>{escape(title)}</title><h1>{escape(title)}</h1><p>{escape(message)}</p>{link}"
        return http.html(body, status)

def fetch_keys(url: str) -> Result[tuple[frozendict[str, Key], float], str]:
    """The RSA signing keys at `url`, by ID, and how long to keep them: the response's
    `max-age`, from one hour to a day, or an hour if it gives none."""
    match http.get(url):
        case Ok(response):
            if not response.ok():
                return Err(f"fetching the signing keys from {url} gave {response.status}")
            match response.json():
                case Ok(body):
                    keys: dict[str, Key] = {}
                    match body["keys"]:
                        case json.Value.Array(items):
                            for item in items:
                                kty = item["kty"].as_str().unwrap_or("")
                                alg = item["alg"].as_str().unwrap_or("")
                                use = item["use"].as_str().unwrap_or("sig")
                                id = item["kid"].as_str().unwrap_or("")
                                if use != "sig":
                                    continue
                                if kty == "RSA" and (alg == "RS256" or alg == ""):
                                    n = crypto.base64url_decode(item["n"].as_str().unwrap_or(""))
                                    e = crypto.base64url_decode(item["e"].as_str().unwrap_or(""))
                                    if n != None and e != None:
                                        keys[id] = Key(n.unwrap(), e.unwrap())
                                if kty == "EC" and item["crv"].as_str() == Some("P-256") and (alg == "ES256" or alg == ""):
                                    x = crypto.base64url_decode(item["x"].as_str().unwrap_or(""))
                                    y = crypto.base64url_decode(item["y"].as_str().unwrap_or(""))
                                    if x != None and y != None:
                                        keys[id] = Key(x.unwrap(), y.unwrap(), True)
                        case _:
                            return Err(f"the signing keys from {url} are not a JSON Web Key Set")
                    return (frozendict(keys), max_age(response.header("Cache-Control").unwrap_or("")))
                case Err(problem):
                    return Err(f"the signing keys from {url} are not JSON: {problem.message()}")
        case Err(problem):
            return Err(f"cannot fetch the signing keys: {problem.message()}")

def max_age(cache_control: str) -> float:
    seconds = 3600
    for part in cache_control.split(","):
        name, equals, value = part.strip().partition("=")
        if name.lower() == "max-age" and equals == "=":
            seconds = int.parse(value.strip()).unwrap_or(3600)
    return float(min(max(seconds, 3600), 86400))

def decode_part(text: str) -> json.Value:
    match crypto.base64url_decode(text):
        case Some(data):
            match data.decode():
                case Some(decoded):
                    return json.parse(decoded).unwrap_or(json.Value.Null)
                case None:
                    return json.Value.Null
        case None:
            return json.Value.Null

def user_of(claims: json.Value, provider: str) -> User:
    verified = False
    match claims["email_verified"]:
        case json.Value.Bool(flag):
            verified = flag
        case json.Value.Str(text):
            verified = text == "true"
        case _:
            pass
    subject = claims["sub"].as_str().unwrap_or("")
    if provider != "google":
        # Google's IDs stay as they were; the others are written `<provider>:<subject>`, so that
        # two providers never give one ID to two people.
        subject = provider + ":" + subject
    return User(
        subject,
        claims["email"].as_str().unwrap_or(""),
        verified,
        claims["name"].as_str().unwrap_or(""),
        claims["given_name"].as_str().unwrap_or(""),
        claims["family_name"].as_str().unwrap_or(""),
        claims["picture"].as_str().unwrap_or(""),
        claims["hd"].as_str().unwrap_or(""),
        provider,
    )

pub def bearer(key: bytes, user: User, expires_in: int) -> str:
    """A signed sign-in for `Authorization: Bearer <token>`, made with `Provider.signing_key()`
    and lasting `expires_in` seconds. For an app that hands the token to a browser on another
    site instead of setting a cookie."""
    issued = now()
    return sign(json.encode(Session(user, issued, issued + expires_in)), key)

# The signed session a request carries: from `Authorization: Bearer <token>` when it has one,
# otherwise from the session cookie.
def session_token(req: http.Request, cookie: str) -> str?:
    match req.header("Authorization"):
        case Some(value):
            if value.starts_with("Bearer "):
                return value[7:]
        case None:
            pass
    return req.cookie(cookie)

def safe_next(target: str) -> str:
    """`target` if it is a path on this site, else `/`: the login route never sends a user to
    another site (an open redirect)."""
    if not target.starts_with("/") or target.starts_with("//") or "\\" in target:
        return "/"
    for c in target:
        code = ord(c)
        if code < 32 or code == 127:
            return "/"
    return target

def escape(text: str) -> str:
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")

# ---- protecting routes --------------------------------------------------------------------

pub def user(req: http.Request) -> User?:
    """The signed-in user, or `None`. The provider's middleware finds it."""
    match req.local(USER_KEY):
        case Some(text):
            match json.decode[User](text):
                case Ok(found):
                    return found
                case Err(_):
                    return None
        case None:
            return None

pub def required(req: http.Request, next: http.Handler) -> Result[http.Response]:
    """Refuses signed-out requests. As an annotation, `@auth.required` protects one `@http`
    route; as middleware, `server.use(auth.required)` or `group.use(auth.required)` protects
    them all. A browser opening a page is redirected to the login route, and anything else
    gets a 401. A handler parameter of type `auth.User` protects its route too, and gets the
    signed-in user."""
    match guard(req):
        case Some(refusal):
            return refusal
        case None:
            return next(req)

pub def protect(handler: http.Handler) -> http.Handler:
    """`handler`, refusing signed-out requests as `required` does: `server.get("/notes",
    auth.protect(notes))`."""
    return lambda req: required(req, handler)

pub def guard(req: http.Request) -> http.Response?:
    """`None` if a user is signed in, or else the response refusing the request. `required`
    uses it, as does the code `server.mount` generates for protected routes."""
    match req.local(USER_KEY):
        case Some(_):
            return None
        case None:
            pass
    match req.local(LOGIN_KEY):
        case Some(login_path):
            return refusal(req, login_path)
        case None:
            log.error(f"{req.method} {req.path} needs a signed-in user, but no sign-in provider is installed: call `provider.install(server)`")
            return http.error(500, "internal server error")

pub def user_param(req: http.Request) -> Result[User, http.HttpError]:
    """The signed-in user, for an `auth.User` parameter of a mounted route. It is for the code
    `server.mount` generates, which calls `guard` first."""
    match user(req):
        case Some(found):
            return found
        case None:
            return Err(http.HttpError(401, "sign-in required"))

def refusal(req: http.Request, login_path: str) -> http.Response:
    if (req.method == "GET" or req.method == "HEAD") and "text/html" in req.header("Accept").unwrap_or(""):
        target = req.path
        query = req.query_string()
        if query != "":
            target = target + "?" + query
        return http.redirect(login_path + "?next=" + http.url_encode(target))
    return http.error(401, "sign-in required").with_header("WWW-Authenticate", "Cookie realm=\"sign-in\"")
