pub def microsoft(
    tenant: str = "common",
    client_id: str = "",
    client_secret: str = "",
    redirect_uri: str = "",
    secret: str? = None,
    allowed_domains: list[str] = [],
    allowed_emails: list[str] = [],
    require_verified_email: bool = False,
    session_days: int = 7,
    on_login: LoginHook? = None,
    base: str = "https://login.microsoftonline.com",
) -> Result[Provider, AuthError]:
    """
    Sign-in with Microsoft (Entra ID). `tenant` is a tenant's ID or domain, or `"common"` (any
    work or personal account), `"organizations"` or `"consumers"`; with those, each token names
    its own tenant (`tid`) in its issuer, which is checked against that tenant's. Microsoft does
    not say whether an email is verified, so `require_verified_email` is off: key records on
    `User.id`, never on the email. The client comes from `MICROSOFT_CLIENT_ID` and
    `MICROSOFT_CLIENT_SECRET`. `base` is
    the sign-in host; a test points it at a fake.
    """
    return oidc(
        f"{base}/{tenant}/v2.0",
        name="microsoft",
        title="Microsoft",
        client_id=client_id,
        client_secret=client_secret,
        redirect_uri=redirect_uri,
        secret=secret,
        allowed_domains=allowed_domains,
        allowed_emails=allowed_emails,
        require_verified_email=require_verified_email,
        session_days=session_days,
        on_login=on_login,
    )

