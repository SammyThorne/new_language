    allowed_emails: list[str] = [],
    require_verified_email: bool = True,
    on_login: LoginHook? = None,
) -> Provider:
    """`oidc` for tests: no discovery, no environment. Point `endpoints` at a fake provider; its
    `issuer` is `issuer`, and its `algorithms` may be `"RS256 ES256"`."""
    chosen = endpoints.unwrap_or(Endpoints("https://idp.test/authorize", "https://idp.test/token", "", issuer, "RS256 ES256"))
    redirect = redirect_uri if redirect_uri != "" else f"http://localhost:8080/auth/{name}/callback"
    match make_provider(
        f"test-client-{name}",
        "test-secret",
        redirect,
        Some(secret),
        ["openid", "email", "profile"],
        allowed_domains,
        allowed_emails,
        require_verified_email,
        7,
        f"/auth/{name}/login",
        "/auth/logout",
        "/",
        on_login,
        chosen,
        name,
        name,
    ):
        case Ok(provider):
            return provider
        case Err(problem):
            panic(problem.message)

pub def github(
    client_id: str = "",
    client_secret: str = "",
    redirect_uri: str = "",
    secret: str? = None,
    scopes: list[str] = ["read:user", "user:email"],
    allowed_emails: list[str] = [],
    require_verified_email: bool = True,
    session_days: int = 7,
    on_login: LoginHook? = None,
) -> Result[Provider, AuthError]:
    """
    Sign-in with GitHub, which is OAuth 2 without an ID token: after the code exchange the
    server reads the account from GitHub's API with the access token. The user's email is
    their primary address when GitHub has verified it, and `""` otherwise, which
    `require_verified_email` refuses (it needs the `user:email` scope). `User.id` is
    `github:<number>`, which stays the same when the user renames their account. The client
    comes from `GITHUB_CLIENT_ID`, `GITHUB_CLIENT_SECRET` and `GITHUB_REDIRECT_URI`; register
    `https://<your site>/auth/github/callback` in the OAuth app.
    """
    id = client_id
    if id == "":
        id = os.getenv("GITHUB_CLIENT_ID").unwrap_or("")
    password = client_secret
    if password == "":
        password = os.getenv("GITHUB_CLIENT_SECRET").unwrap_or("")
    if id == "" or password == "":
        return Err(AuthError("no github client: give `client_id=` and `client_secret=`, or set GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (from an OAuth app in GitHub's developer settings)"))
    redirect = redirect_uri
    if redirect == "":
        redirect = os.getenv("GITHUB_REDIRECT_URI").unwrap_or("")
    if redirect == "":
        return Err(AuthError("give `redirect_uri=` (or set GITHUB_REDIRECT_URI): the one registered for the OAuth app with GitHub"))
    return make_provider(
        id,
        password,
        redirect,
        secret,
        scopes,
        [],
        allowed_emails,
        require_verified_email,
        session_days,
        "/auth/github/login",
        "/auth/logout",
        "/",
        on_login,
        Endpoints("https://github.com/login/oauth/authorize", "https://github.com/login/oauth/access_token", "", "", "", "https://api.github.com"),
        "github",
        "GitHub",
    )

pub def github_for_tests(
