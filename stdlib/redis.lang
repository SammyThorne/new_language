"""
A Redis client with a connection pool. Calls wait without blocking other tasks, and a `Client`
can be shared by every request handler.

    import redis
    import datetime

    def main():
        cache = redis.connect("redis://localhost:6379").unwrap()
        cache.set("greeting", "hello", ttl=datetime.minutes(5)).unwrap()
        print(cache.get("greeting").unwrap())            # Some("hello")
        print(cache.incr("visits").unwrap())             # 1, 2, 3, ...

The URL is `redis://[user:password@]host[:port][/database]`, or `rediss://` for TLS (the server's
certificate is checked against the trusted roots, and `SSL_CERT_FILE`). Options after `?`:
`pool_max` (default 10) and `timeout`, the milliseconds to wait for one reply (default 30000).

Every command is also available as `command(["NAME", "arg", ...])`, which answers with a
`Reply`. Values travel as text; Redis stores bytes, and what you `set` is what you `get`.
`pipeline()` sends several commands in one write, `subscribe` listens to channels, and
`redis.rate_store` and `redis.queue` make `http.rate_limit` and a job queue shared by every
instance of a service that uses the same Redis.
"""

import datetime
import http
import crypto
import json as jsonlib
import log
import time
import jobs

