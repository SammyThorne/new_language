# ---- errors -------------------------------------------------------------------------------

pub struct HttpError:
    """An error that becomes a response with its status: `Err(http.Error(404, "not found"))`."""
    status: int
    message: str

impl Error for HttpError:
    def message(self) -> str:
        return self.message

    def status(self) -> int:
        return self.status

impl Display for HttpError:
    def to_str(self) -> str:
        return f"{self.status} {self.message}"

pub def Error(status: int, message: str) -> HttpError:
    """An error with an HTTP status, for handlers to return."""
    return HttpError(status, message)

pub def check_cancelled() -> Result[None, HttpError]:
    """An error if the running task has been cancelled, for loops that never wait (waiting
    operations fail by themselves): 503 past the deadline, 499 after the client closed the
    connection. `http.check_cancelled()?` in the loop ends the handler."""
    state = cancel_state_raw()
    if state == 1:
        return Err(HttpError(503, "cancelled: the request's deadline passed"))
    if state == 2:
        return Err(HttpError(499, "cancelled: the client closed the connection"))
    return Ok(None)

# ---- requests -----------------------------------------------------------------------------

pub struct Request:
    """
    A request being handled. `method` and `path` are filled in; the rest is read from the
    connection when asked for.
    """
    method: str
    path: str
    priv handle: int = -1
    priv params: dict[str, str] = {}
    # What no connection holds: a test request's parts, and the values middleware stored.
    # `None` until needed, so a request that uses neither is no bigger for them.
    priv extra: RequestExtra? = None

struct RequestExtra:
    # A test request's body, query string and headers; `None` for a request from a connection.
    test: TestParts?
    locals: dict[str, str]?
    # Headers middleware asked for on the response `Server.handle` makes from an error, which
    # did not exist when the middleware saw the request.
    error_headers: dict[str, str]? = None
    # A test request's route, as `Route.label`; a request from a connection keeps it in the
    # runtime.
    route: int = UNMATCHED

struct TestParts:
    body: str
    query: str
    # Names lower-cased.
    headers: dict[str, str]
    # The form `test_request(files=...)` was given, which no text body can hold.
    form: FormData? = None

impl Request:
    def param(self, name: str) -> str:
        """A `{name}` segment of the route's path, or `""`."""
        return self.params.get_or(name, "")

    def param_int(self, name: str) -> Result[int, HttpError]:
        """A path segment as an `int`; a 400 error if it is not one."""
        match int.parse(self.param(name)):
            case Ok(value):
                return value
            case Err(_):
                return Err(HttpError(400, f"path parameter `{name}` must be an integer"))

    def param_float(self, name: str) -> Result[float, HttpError]:
        match float.parse(self.param(name)):
            case Ok(value):
                return value
            case Err(_):
                return Err(HttpError(400, f"path parameter `{name}` must be a number"))

    def param_bool(self, name: str) -> Result[bool, HttpError]:
        return parse_bool(self.param(name), f"path parameter `{name}`")

    priv def test_parts(self) -> TestParts?:
        match self.extra:
            case Some(extra):
                return extra.test
            case None:
                return None

    def query(self, name: str) -> str?:
        """A query parameter (`?name=value`), decoded, or `None`."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return query_value_raw(parts.query, name)
                case None:
                    return None
        return req_query(self.handle, name)

    def query_string(self) -> str:
        """The query string as sent, without the `?` and not decoded: `""` if there is none."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return parts.query
                case None:
                    return ""
        return req_query_string(self.handle)

    def header(self, name: str) -> str?:
        """A header's value, or `None`. Header names are case-insensitive."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return parts.headers.get(name.lower())
                case None:
                    return None
        return req_header(self.handle, name)

    def set_local(self, name: str, value: str):
        """Keep a value with this request, for the handlers and middleware after this one:
        middleware that works out who is asking stores it here, as Express's `res.locals` and
        Starlette's `request.state` do."""
        match self.extra:
            case Some(extra):
                match extra.locals:
                    case Some(values):
                        values[name] = value
                    case None:
                        extra.locals = {name: value}
            case None:
                self.extra = RequestExtra(None, {name: value})

    def local(self, name: str) -> str?:
        """A value stored with `set_local`, or `None`."""
        match self.extra:
            case Some(extra):
                match extra.locals:
                    case Some(values):
                        return values.get(name)
                    case None:
                        return None
            case None:
                return None

    def route(self) -> str:
        """The pattern of the route that took the request, such as `/todos/{id}`: `""` before
        routing and when no route took it. For logs and metrics, whose labels must not be raw
        paths."""
        return route_pattern_raw(self.route_label())

    def deadline(self) -> datetime.DateTime?:
        """When the route's `timeout` cancels the handler, or `None` without one. Tasks the
        handler spawns have the same deadline."""
        if self.handle < 0:
            return None
        nanos = cancel_deadline_raw()
        if nanos < 0:
            return None
        return datetime.from_unix(nanos // 1000000000, nanos % 1000000000)

    def cancelled(self) -> bool:
        """Whether the handler has been cancelled: its deadline has passed, or the client
        closed the connection. Waiting operations then fail by themselves."""
        return self.handle >= 0 and cancel_state_raw() != 0

    priv def route_label(self) -> int:
        if self.handle >= 0:
            return req_route_raw(self.handle)
        match self.extra:
            case Some(extra):
                return extra.route
            case None:
                return UNMATCHED

    priv def routed(self, route: Route):
        # Tells the runtime which route took the request: one store.
        if self.handle >= 0:
            set_route_raw(self.handle, route.label)
            return
        match self.extra:
            case Some(extra):
                extra.route = route.label
            case None:
                self.extra = RequestExtra(None, None, None, route.label)

    priv def add_error_header(self, name: str, value: str):
        match self.extra:
            case Some(extra):
                match extra.error_headers:
                    case Some(headers):
                        headers[name] = value
                    case None:
                        extra.error_headers = {name: value}
            case None:
                self.extra = RequestExtra(None, None, {name: value})

    priv def error_headers(self) -> dict[str, str]?:
        match self.extra:
            case Some(extra):
                return extra.error_headers
            case None:
                return None

    def text(self) -> Result[str, HttpError]:
        """The body as text; a 400 error if it is not UTF-8, and a 413 if it is larger than the
        route's `max_body` (else the group's, else the server's). Each call reads it from the
        connection's buffer again, so keep the result rather than calling it twice."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    limit = self.route_label() // ROUTE_LIMIT
                    if limit > 0 and len(parts.body.encode()) > limit:
                        return Err(HttpError(413, f"the request body is larger than {limit} bytes"))
                    return parts.body
                case None:
                    return ""
        problem = req_read_body(self.handle)
        if problem != 0:
            return Err(HttpError(problem, last_error()))
        match req_body(self.handle):
            case Some(text):
                return text
            case None:
                return Err(HttpError(400, "the request body is not UTF-8 text"))

    def json(self) -> Result[jsonlib.Value, HttpError]:
        """The body parsed as JSON of any shape; a 400 error if it is not JSON."""
        text = self.text()?
        match jsonlib.parse(text):
            case Ok(value):
                return value
            case Err(error):
                return Err(HttpError(400, f"invalid JSON body: {error.message()}"))

    def body(self) -> bytes:
        """The body as bytes, whether or not it is text: for uploads and binary formats. Past
        the route's `max_body` it is empty, and the client is answered 413 whatever the handler
        returns."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return parts.body.encode()
                case None:
                    return "".encode()
        return __bytes(req_body_bytes(self.handle))

    def form(self) -> Result[FormData, HttpError]:
        """The body as a form, sent as `application/x-www-form-urlencoded` or
        `multipart/form-data`: its text fields and its files. A 415 for another content type,
        a 400 for a malformed body, and a 413 past the route's `max_body` or the server's
        `max_files` or `max_fields`. The body is parsed on each call, so keep the result."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    match parts.form:
                        case Some(form):
                            return form
                        case None:
                            pass
                    body = self.text()?
                    return read_form(parse_form_raw(parts.headers.get_or("content-type", ""), body))
                case None:
                    return Err(HttpError(415, "a form must be sent as application/x-www-form-urlencoded or multipart/form-data"))
        return read_form(req_form_raw(self.handle))

    def remote_addr(self) -> str:
        """The address and port of the other end of the connection: the client's, or a proxy's
        when there is one in front. `""` for a test request."""
        if self.handle < 0:
            return ""
        return req_remote(self.handle)

    def client_ip(self) -> str:
        """The client's IP address, without a port. When the connection comes from one of the
        server's `trusted_proxies`, this is the address the proxies say they forwarded the
        request for (`X-Forwarded-For`, read from the right, past the trusted ones); otherwise
        it is the connection's. A client cannot choose it by sending the header itself. `""`
        for a test request."""
        if self.handle < 0:
            return ""
        return req_client_ip(self.handle)

    def cookie(self, name: str) -> str?:
        """A cookie sent with the request (from its `Cookie` header), or `None`. `%XX` escapes
        are decoded, undoing what `Response.set_cookie` does to characters a cookie cannot
        hold; a value with a malformed escape is returned as it was sent."""
        match self.header("Cookie"):
            case Some(text):
                for pair in text.split(";"):
                    parts = pair.strip().split("=")
                    if len(parts) >= 2 and parts[0] == name:
                        value = "=".join(parts[1:])
                        if "%" not in value:
                            return value
                        return url_decode_raw(value, 0).unwrap_or(value)
                return None
            case None:
                return None

@frozen
pub struct Header:
    """A handler parameter bound from the request header named after it:
    `user_agent: http.Header` is the `User-Agent` header. A 400 if it is missing, unless the
    parameter is `http.Header?`."""
    value: str

impl Display for Header:
    def to_str(self) -> str:
        return self.value

@frozen
pub struct Cookie:
    """A handler parameter bound from the cookie with its name: `session: http.Cookie`. A 400
    if it is missing, unless the parameter is `http.Cookie?`."""
    value: str

impl Display for Cookie:
    def to_str(self) -> str:
        return self.value

# ---- forms and uploads --------------------------------------------------------------------

pub struct Upload:
    """A file sent in a form: from `form.files(name)`, or a handler parameter
    `avatar: http.Upload`. `filename` is the base name the client gave, without any directory
    or control characters (it may be `""`), and `content_type` what the client said it is;
    neither is checked against the contents. A file over 1 MiB is kept in a temporary file in
    `server.upload_dir` until the request ends: read or `save` it in the handler."""
    filename: str
    content_type: str
    size: int
    priv data: bytes
    # The temporary file holding a large upload, or "".
    priv path: str = ""

impl Upload:
    def bytes(self) -> Result[bytes, HttpError]:
        """The contents. A 500 error if a large upload's temporary file is gone, as it is once
        the request has ended."""
        if self.path == "":
            return self.data
        data = upload_read_raw(self.path)
        if len(data) != self.size:
            return Err(HttpError(500, last_error()))
        return __bytes(data)

    def text(self) -> Result[str, HttpError]:
        """The contents as text; a 400 error if they are not UTF-8."""
        match self.bytes()?.decode():
            case Some(text):
                return text
            case None:
                return Err(HttpError(400, f"the upload `{self.filename}` is not UTF-8 text"))

    def save(self, path: str) -> Result[None, HttpError]:
        """Write the contents to `path`, replacing any file there. A large upload's temporary
        file is moved there rather than copied when it is on the same file system. Choose the
        path yourself: `filename` comes from the client."""
        if upload_save_raw(self.path, __bytes_data(self.data), path) != 0:
            return Err(HttpError(500, last_error()))
        return Ok(None)

pub def test_file(filename: str, content: bytes, content_type: str = "application/octet-stream") -> Upload:
    """An upload for `test_request(files={...})`. `filename` is cut down to its base name, as
    a client's is."""
    return Upload(sanitise_filename_raw(filename), content_type, len(content), content)

pub struct FormData:
    """A form's text fields and files, from `req.form()`. Names may repeat (checkboxes, several
    files): `get` and `file` give the first, `all` and `files` every one, in order."""
    priv fields: dict[str, list[str]]
    priv uploads: dict[str, list[Upload]]

impl FormData:
    def get(self, name: str) -> str?:
        """The first text field called `name`, or `None`."""
        match self.fields.get(name):
            case Some(values):
                return values[0]
            case None:
                return None

    def all(self, name: str) -> list[str]:
        """Every text field called `name`."""
        return self.fields.get_or(name, [])

    def file(self, name: str) -> Upload?:
        """The first file sent as `name`, or `None`."""
        match self.uploads.get(name):
            case Some(files):
                return files[0]
            case None:
                return None

    def files(self, name: str) -> list[Upload]:
        """Every file sent as `name`."""
        return self.uploads.get_or(name, [])

    def names(self) -> list[str]:
        """The names of the text fields, in the order they first appear."""
        return list(self.fields.keys())

def read_form(handle: int) -> Result[FormData, HttpError]:
    if handle < 0:
        return Err(HttpError(0 - handle, last_error()))
    fields: dict[str, list[str]] = {}
    uploads: dict[str, list[Upload]] = {}
    for i in range(form_count_raw(handle)):
        name = form_part_raw(handle, i, 0)
        match form_filename_raw(handle, i):
            case Some(filename):
                path = form_part_raw(handle, i, 4)
                data = __bytes(form_part_raw(handle, i, 3))
                upload = Upload(filename, form_part_raw(handle, i, 2), form_size_raw(handle, i), data, path)
                match uploads.get(name):
                    case Some(files):
                        files.append(upload)
                    case None:
                        uploads[name] = [upload]
            case None:
                value = form_part_raw(handle, i, 3)
                match fields.get(name):
                    case Some(values):
                        values.append(value)
                    case None:
                        fields[name] = [value]
    form_free_raw(handle)
    return FormData(fields, uploads)

pub struct Form[T]:
    """A handler parameter holding the form's text fields decoded into `T`, a struct deriving
    `Json`: `signup: http.Form[Signup]`, then `signup.value`. Numbers and booleans are read from
    the fields' text (`on`, as a checked box sends, is `True`); a field sent several times fills
    a list. A missing or malformed field is a 400 naming it."""
    value: T

pub def form_data(req: Request) -> Result[FormData, HttpError]:
    return req.form()

pub def form_value[T: FromJson](form: FormData) -> Result[Form[T], HttpError]:
    parts: list[str] = []
    for name, values in form.fields.items():
        if len(values) == 1:
            parts.append(jsonlib.encode(name) + ":" + jsonlib.encode(values[0]))
        else:
            parts.append(jsonlib.encode(name) + ":" + jsonlib.encode(values))
    set_lenient_raw(1)
    match jsonlib.decode[T]("{" + ",".join(parts) + "}"):
        case Ok(value):
            return Form(value)
        case Err(error):
            problems: list[str] = []
            for i in range(problem_count_raw()):
                problems.append(form_problem(problem_raw(i, 0), problem_raw(i, 1)))
            if len(problems) == 0:
                problems.append(form_problem(error.path, error.message()))
            return Err(HttpError(400, "invalid form: " + "; ".join(sorted(problems))))

def form_problem(path: str, message: str) -> str:
    if path == "":
        return message
    if message.starts_with("must ") or message.starts_with("is "):
        return f"field `{path}` {message}"
    return f"field `{path}`: {message}"

pub def upload_param(form: FormData, name: str) -> Result[Upload, HttpError]:
    match form.file(name):
        case Some(upload):
            return upload
        case None:
            return Err(HttpError(400, f"missing file `{name}`"))

pub def upload_param_opt(form: FormData, name: str) -> Result[Upload?, HttpError]:
    return Ok(form.file(name))

pub def upload_param_list(form: FormData, name: str) -> Result[list[Upload], HttpError]:
    return Ok(form.files(name))

pub def header_param(req: Request, name: str) -> Result[Header, HttpError]:
    match req.header(name):
        case Some(value):
            return Header(value)
        case None:
            return Err(HttpError(400, f"missing header `{name}`"))

pub def header_param_opt(req: Request, name: str) -> Result[Header?, HttpError]:
    match req.header(name):
        case Some(value):
            return Ok(Some(Header(value)))
        case None:
            return Ok(None)

pub def cookie_param(req: Request, name: str) -> Result[Cookie, HttpError]:
    match req.cookie(name):
        case Some(value):
            return Cookie(value)
        case None:
            return Err(HttpError(400, f"missing cookie `{name}`"))

pub def cookie_param_opt(req: Request, name: str) -> Result[Cookie?, HttpError]:
    match req.cookie(name):
        case Some(value):
            return Ok(Some(Cookie(value)))
        case None:
            return Ok(None)

pub def test_request(method: str, path: str, body: str = "", headers: dict[str, str] = {}, form: dict[str, str] = {}, files: dict[str, Upload] = {}) -> Request:
    """A request that is not from a connection, for calling `server.handle(...)` in tests.
    `path` may end in a query string (`"/items?limit=5"`), which `query` reads; `headers` are
    what `header` and `cookie` read, with names in any case. `form` sends text fields as an
    urlencoded body, and `files` (made with `http.test_file`) a multipart form with them."""
    before, _mark, after = path.partition("?")
    lowered: dict[str, str] = {}
    for name, value in headers.items():
        lowered[name.lower()] = value
    request = Request(method, before)
    parts = TestParts(body, after, lowered)
    if len(files) > 0:
        fields: dict[str, list[str]] = {}
        for name, value in form.items():
            fields[name] = [value]
        uploads: dict[str, list[Upload]] = {}
        for name, upload in files.items():
            uploads[name] = [upload]
        parts.form = Some(FormData(fields, uploads))
        lowered["content-type"] = "multipart/form-data; boundary=test"
    elif len(form) > 0:
        pairs: list[tuple[str, str]] = []
        for name, value in form.items():
            pairs.append((name, value))
        parts.body = form_encode(pairs)
        lowered["content-type"] = "application/x-www-form-urlencoded"
    request.extra = RequestExtra(parts, None)
    return request

def parse_bool(text: str, what: str) -> Result[bool, HttpError]:
    lowered = text.lower()
    if lowered == "true" or lowered == "1":
        return True
    if lowered == "false" or lowered == "0":
        return False
    return Err(HttpError(400, f"{what} must be `true` or `false`"))

pub def body[T: FromJson](req: Request) -> Result[T, HttpError]:
    """The body decoded as JSON into a `T`; a 400 error naming the problem if it does not fit."""
    text = req.text()?
    match jsonlib.decode[T](text):
        case Ok(value):
            return value
        case Err(error):
            return Err(HttpError(400, f"invalid JSON body: {error.message()}"))

pub def query_str(req: Request, name: str) -> Result[str, HttpError]:
    match req.query(name):
        case Some(text):
            return text
        case None:
            return Err(HttpError(400, f"missing query parameter `{name}`"))

pub def query_str_opt(req: Request, name: str) -> Result[str?, HttpError]:
    return Ok(req.query(name))

pub def query_int(req: Request, name: str) -> Result[int, HttpError]:
    text = query_str(req, name)?
    match int.parse(text):
        case Ok(value):
            return value
        case Err(_):
            return Err(HttpError(400, f"query parameter `{name}` must be an integer"))

pub def query_int_opt(req: Request, name: str) -> Result[int?, HttpError]:
    match req.query(name):
        case Some(_):
            value = query_int(req, name)?
            return Ok(Some(value))
        case None:
            return Ok(None)

pub def query_float(req: Request, name: str) -> Result[float, HttpError]:
    text = query_str(req, name)?
    match float.parse(text):
        case Ok(value):
            return value
        case Err(_):
            return Err(HttpError(400, f"query parameter `{name}` must be a number"))

pub def query_float_opt(req: Request, name: str) -> Result[float?, HttpError]:
    match req.query(name):
        case Some(_):
            value = query_float(req, name)?
            return Ok(Some(value))
        case None:
            return Ok(None)

pub def query_bool(req: Request, name: str) -> Result[bool, HttpError]:
    text = query_str(req, name)?
    return parse_bool(text, f"query parameter `{name}`")

pub def query_bool_opt(req: Request, name: str) -> Result[bool?, HttpError]:
    match req.query(name):
        case Some(text):
            value = parse_bool(text, f"query parameter `{name}`")?
            return Ok(Some(value))
        case None:
            return Ok(None)

def from_text[T: FromJson](text: str, what: str) -> Result[T, HttpError]:
    # A `JsonString` type's `from_json_string`, reached through the JSON decoder because a type
    # parameter's static methods cannot be called directly.
    match jsonlib.decode[T](jsonlib.encode(text)):
        case Ok(value):
            return value
        case Err(error):
            return Err(HttpError(400, f"{what}: {error.message()}"))

pub def path_text[T: FromJson](req: Request, name: str) -> Result[T, HttpError]:
    return from_text[T](req.param(name), f"path parameter `{name}`")

pub def query_text[T: FromJson](req: Request, name: str) -> Result[T, HttpError]:
    text = query_str(req, name)?
    return from_text[T](text, f"query parameter `{name}`")

pub def query_text_opt[T: FromJson](req: Request, name: str) -> Result[T?, HttpError]:
    match req.query(name):
        case Some(text):
            value = from_text[T](text, f"query parameter `{name}`")?
            return Ok(Some(value))
        case None:
            return Ok(None)

# ---- responses ----------------------------------------------------------------------------

pub struct Response:
    status: int = 200
    body: str = ""
    content_type: str = "text/plain; charset=utf-8"
    headers: dict[str, str] = {}
    # The body of a response made by `http.binary`, sent instead of `body`.
    priv data: bytes? = None

impl Response:
    def body_bytes(self) -> bytes:
        """The body as sent: the data of a response made by `http.binary`, otherwise `body` in
        UTF-8. For tests."""
        match self.data:
            case Some(data):
                return data
            case None:
                return self.body.encode()

    def with_header(self, name: str, value: str) -> Response:
        """Set a header, replacing any value it had, and return the response for chaining."""
        self.headers[name] = value
        return self

    def add_header(self, name: str, value: str) -> Response:
        """Add a header, keeping any it already has: the header is sent once per value. In
        `headers`, the values are joined by newlines."""
        match self.headers.get(name):
            case Some(existing):
                self.headers[name] = existing + "\n" + value
            case None:
                self.headers[name] = value
        return self

    def set_cookie(
        self,
        name: str,
        value: str,
        max_age: int = -1,
        path: str = "/",
        http_only: bool = True,
        secure: bool = False,
        same_site: str = "Lax",
    ) -> Response:
        """Set a cookie (a `Set-Cookie` header); any number can be set on one response.
        Characters a cookie cannot hold (spaces, `;`, `,`, `"`, `\\`, non-ASCII) and `%` are
        sent as `%XX`, which `req.cookie` decodes. `max_age` is in seconds; -1 makes a cookie
        that ends with the browser session. Scripts cannot read it unless `http_only=False`.
        `same_site` is `"Lax"`, `"Strict"`, `"None"` or `""` to leave it out. A cookie named
        `__Host-...` or `__Secure-...`, or with `same_site="None"`, is always `Secure`, as
        browsers require."""
        check_cookie_name(name)
        if same_site != "Lax" and same_site != "Strict" and same_site != "None" and same_site != "":
            panic(f"`same_site` must be \"Lax\", \"Strict\", \"None\" or \"\", not {same_site!r}")
        if ";" in path or "\n" in path or "\r" in path:
            panic(f"a cookie's path cannot contain `;` or a line break: {path!r}")
        if name.starts_with("__Host-") and path != "/":
            panic(f"a `__Host-` cookie must have the path \"/\", not {path!r}")
        parts = [name + "=" + cookie_encode_raw(value)]
        if path != "":
            parts.append("Path=" + path)
        if max_age >= 0:
            parts.append(f"Max-Age={max_age}")
        if http_only:
            parts.append("HttpOnly")
        if secure or same_site == "None" or name.starts_with("__Host-") or name.starts_with("__Secure-"):
            parts.append("Secure")
        if same_site != "":
            parts.append("SameSite=" + same_site)
        return self.add_header("Set-Cookie", "; ".join(parts))

    def delete_cookie(self, name: str, path: str = "/") -> Response:
        """Tell the browser to forget a cookie: the same name and path, expired now."""
        return self.set_cookie(name, "", 0, path, True, False, "Lax")

    def cookie(self, name: str) -> str?:
        """The value this response sets for the cookie `name`, decoded, or `None`: for tests."""
        match self.headers.get("Set-Cookie"):
            case Some(lines):
                for line in lines.split("\n"):
                    first, _mark, _rest = line.partition(";")
                    key, equals, value = first.partition("=")
                    if equals == "=" and key == name:
                        return url_decode_raw(value, 0).unwrap_or(value)
                return None
            case None:
                return None

def check_cookie_name(name: str):
    # RFC 6265: a token, so no separators, spaces or control characters.
    if name == "":
        panic("a cookie needs a name")
    for c in name:
        code = ord(c)
        if code <= 32 or code >= 127 or c in "()<>@,;:\\\"/[]?={}":
            panic(f"{name!r} is not a valid cookie name: use letters, digits and `-_.!#$%&'*+^`|~`")

pub def text(body: str, status: int = 200) -> Response:
    return Response(status, body, "text/plain; charset=utf-8")

pub def html(body: str, status: int = 200) -> Response:
    return Response(status, body, "text/html; charset=utf-8")

pub def json[T: ToJson](value: T, status: int = 200) -> Response:
    """A JSON response."""
    return Response(status, jsonlib.encode(value), "application/json")

pub def binary(data: bytes, content_type: str = "application/octet-stream", status: int = 200) -> Response:
    """A response whose body is any bytes: an image, a download, a binary format."""
    response = Response(status, "", content_type)
    response.data = data
    return response

pub def error(status: int, message: str) -> Response:
    """A JSON error response: `{"error": message}`."""
    return Response(status, jsonlib.encode({"error": message}), "application/json")

pub def redirect(location: str, status: int = 302) -> Response:
    return Response(status, "", "").with_header("Location", location)

pub def no_content() -> Response:
    return Response(204, "", "")

# ---- encoding -----------------------------------------------------------------------------

pub def url_encode(text: str) -> str:
    """`text` with every character but ASCII letters, digits and `-._~` written as `%XX`, byte
    by byte in UTF-8: safe in a query string, a form body or a path segment."""
    return url_encode_raw(text)

pub def url_decode(text: str, plus_is_space: bool = True) -> str?:
    """`%XX` escapes decoded, and `+` as a space unless `plus_is_space=False` (it is a space in
    query strings and form bodies, not in paths). `None` if an escape is malformed or the
    result is not UTF-8."""
    return url_decode_raw(text, 1 if plus_is_space else 0)

pub def form_encode(fields: list[tuple[str, str]]) -> str:
    """Name and value pairs as `a=1&b=2`, each part `url_encode`d: a query string, or an
    `application/x-www-form-urlencoded` body. A list keeps the order and allows a name twice."""
    parts: list[str] = []
    for name, value in fields:
        parts.append(url_encode_raw(name) + "=" + url_encode_raw(value))
    return "&".join(parts)

# ---- routing ------------------------------------------------------------------------------

pub type Handler = def(Request) -> Result[Response]
"""A request handler: every route, and the rest of the chain that middleware calls."""

pub type Middleware = def(Request, Handler) -> Result[Response]
"""Code that runs around handlers: it gets the request and the next handler."""

# The kinds of a route's path segments.
const LITERAL = 0
const PARAM = 1
const REST = 2

struct Route:
    method: str
    pattern: str
    handler: Handler
    # Per segment: its kind, and the literal text or the parameter's name.
    kinds: list[int]
    names: list[str]
    # Whether the pattern has parameters; if not, every path it matches is the same.
    has_params: bool
    # For a route of a group with middleware: that middleware around a 405, which answers a
    # CORS preflight for this route (an `OPTIONS` request no route accepts), so that the group's
    # `http.cors` can. `Server.unrouted` calls it.
    preflight: Handler? = None
    # The route's slot in the runtime's metrics, plus UNMETERED or QUIET times 65536.
    label: int = UNMATCHED
    # Seconds until its handler is cancelled and the client answered 503; 0 for the server's.
    timeout: float = 0.0

# Requests no route took, in the metrics (the runtime's `metrics::UNMATCHED`).
const UNMATCHED = 1025
# Route flags, times 65536 in `Route.label`: left out of the metrics, or of the access log.
const UNMETERED = 65536
const QUIET = 131072
# A route's `max_body` is kept in `Route.label` times this, for the runtime to read in the
# one call that says which route took a request.
const ROUTE_LIMIT = 16777216
const MAX_ROUTE_LIMIT = 274877906944

def new_route(method: str, pattern: str, handler: Handler, max_body: int = 0, timeout: float = 0.0) -> Route:
    kinds: list[int] = []
    names: list[str] = []
    for part in split_path(pattern):
        if part.starts_with("{") and part.ends_with("...}"):
            kinds.append(REST)
            names.append(part[1:len(part) - 4])
        elif part.starts_with("{") and part.ends_with("}"):
            kinds.append(PARAM)
            names.append(part[1:len(part) - 1])
        else:
            kinds.append(LITERAL)
            names.append(part)
    has_params = PARAM in kinds or REST in kinds
    if max_body < 0 or max_body >= MAX_ROUTE_LIMIT:
        panic(f"the route {method} {pattern} has max_body={max_body}, which must be from 0 (the server's) to 256 GiB")
    if timeout < 0.0:
        panic(f"the route {method} {pattern} has timeout={timeout}, which must be 0 (the server's) or more")
    return Route(method, pattern, handler, kinds, names, has_params, None, route_slot_raw(method, pattern) + max_body * ROUTE_LIMIT, timeout)

def split_path(path: str) -> list[str]:
    return [part for part in path.split("/") if part != ""]

def fits(route: Route, path: list[str]) -> bool:
    """Whether `path` (split into segments) fits the route's pattern. Allocates nothing."""
    for i in range(len(route.kinds)):
        kind = route.kinds[i]
        if kind == REST:
            return True
        if i >= len(path):
            return False
        if kind == LITERAL and route.names[i] != path[i]:
            return False
    return len(path) == len(route.kinds)

def params_of(route: Route, path: list[str]) -> dict[str, str]:
    """The parameters of a path that fits the route."""
    params: dict[str, str] = {}
    for i in range(len(route.kinds)):
        kind = route.kinds[i]
        if kind == REST:
            params[route.names[i]] = "/".join(path[i:])
            return params
        if kind == PARAM:
            params[route.names[i]] = path[i]
    return params

def accepts(route: Route, method: str) -> bool:
    return route.method == method or (method == "HEAD" and route.method == "GET")

struct Candidate:
    """A route a path fits, with the parameters it gives."""
    route: Route
    params: dict[str, str]

def not_routed(req: Request, fitting: list[Route]) -> Result[Response]:
    """The response when no route takes the request: 405 with the methods the path's routes
    accept, or 404 if no route fits the path."""
    allowed: list[str] = []
    for route in fitting:
        if route.method not in allowed:
            allowed.append(route.method)
    if len(allowed) > 0:
        return error(405, "method not allowed").with_header("Allow", ", ".join(allowed))
    return error(404, "not found")

def metrics_refusal(req: Request, credentials: int) -> Response?:
    # The 401 for a request without the metrics' credentials, or the 429 for a client locked
    # out after ten failures in a minute; `None` when it may go on.
    if credentials < 0:
        return None
    header = ""
    match req.header("Authorization"):
        case Some(value):
            header = value
        case None:
            pass
    verdict = metrics_authorized_raw(credentials, header, req.client_ip(), req.handle)
    if verdict == 1:
        return None
    if verdict < 0:
        return error(429, "too many failed sign-ins; try again later").with_header("Retry-After", str(0 - verdict))
    return error(401, "unauthorized").with_header("WWW-Authenticate", "Basic realm=\"metrics\", charset=\"UTF-8\"")

def guarded(response: Response, page: bool, kept: bool) -> Response:
    # The headers of every metrics and dashboard response: never framed or referred, and only
    # the stylesheet and script `kept` (and checked each time, by their ETag).
    if not kept:
        response.headers["Cache-Control"] = "no-store"
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["Referrer-Policy"] = "no-referrer"
    if page:
        response.headers["Content-Security-Policy"] = "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
    return response

def metrics_reply(req: Request, credentials: int) -> Response:
    match metrics_refusal(req, credentials):
        case Some(refusal):
            return guarded(refusal, False, False)
        case None:
            pass
    return guarded(Response(200, metrics_text_raw(), "text/plain; version=0.0.4; charset=utf-8"), False, False)

def dashboard_file(req: Request, credentials: int, file: DocsFile) -> Response:
    match metrics_refusal(req, credentials):
        case Some(refusal):
            return guarded(refusal, False, False)
        case None:
            pass
    if file.page:
        return guarded(Response(200, file.body, file.content_type), True, False)
    return guarded(serve_docs_file(file, req), False, True)

def dashboard_data(req: Request, credentials: int) -> Response:
    match metrics_refusal(req, credentials):
        case Some(refusal):
            return guarded(refusal, False, False)
        case None:
            pass
    since = 0
    match req.query("since"):
        case Some(text):
            since = int.parse(text).unwrap_or(0)
        case None:
            pass
    return guarded(Response(200, dashboard_data_raw(since), "application/json"), False, False)

# How long each readiness check has, in seconds.
const CHECK_SECONDS = 2.0

def run_check(check: def() -> Result[None]) -> str:
    match check():
        case Ok(_):
            return "ok"
        case Err(problem):
            return problem.message()

def readiness(names: tuple[str, ...], checks: tuple[def() -> Result[None], ...]) -> Response:
    if draining_raw() == 1:
        return Response(503, "{\"server\":\"draining\"}", "application/json").with_header("Cache-Control", "no-store")
    tasks: list[Task[str]] = []
    for check in checks:
        tasks.append(spawn run_check(check))
    start = monotonic_raw()
    parts: list[str] = []
    healthy = True
    for i in range(len(names)):
        left = CHECK_SECONDS - (monotonic_raw() - start)
        result = f"did not answer within {CHECK_SECONDS:.0f} s"
        match tasks[i].join_timeout(left if left > 0.0 else 0.0):
            case Some(answer):
                result = answer
            case None:
                pass
        if result != "ok":
            healthy = False
        parts.append(jsonlib.encode(names[i]) + ":" + jsonlib.encode(result))
    body = "{" + ",".join(parts) + "}"
    return Response(200 if healthy else 503, body, "application/json").with_header("Cache-Control", "no-store")

def wrap(middleware: Middleware, next: Handler) -> Handler:
    return lambda req: middleware(req, next)

# ---- request logs -------------------------------------------------------------------------

# The request local that holds the request's ID.
const REQUEST_ID = "request_id"

pub def request_log(skip: list[str] = [], trace: bool = False) -> Middleware:
    """
    Middleware that gives each request an ID and logs one line for it when it is answered:

        2026-11-20T09:30:00.123Z INFO  GET /photos/7 200 request_id=019aa3f2-5c41-7d0e-9b2a-4e8f1c6d3a70 method=GET path=/photos/7 status=200 ms=1.84 client=203.0.113.9

    The ID is the client's `X-Request-Id` if it sent a usable one (up to 128 letters, digits,
    `.`, `_` and `-`), otherwise a new `uuid.v7()`, so IDs sort by when requests arrived. It is
    sent back in `X-Request-Id`, kept as the request local `"request_id"`, and added to every
    log line written while the request is handled, including by tasks the handler spawns. The path is logged without its query
    string, which often holds tokens. Requests for the paths in `skip` (exactly) are passed
    on without an ID or a line. Add it first, so that it times the other middleware too.

    With `trace=True`, tracing is turned on from the environment as `trace.init()` would
    (`OTEL_EXPORTER_OTLP_ENDPOINT`, `OTEL_SERVICE_NAME`, `OTEL_TRACES_SAMPLER_ARG`), and the
    lines carry `trace_id` and `span_id`.
    """
    if trace and trace_init_raw("", "", -1.0) < 0:
        panic(f"http.request_log: {last_error()}")
    skipped: tuple[str, ...] = tuple(skip)
    return lambda req, next: log_request(req, next, skipped)

def log_request(req: Request, next: Handler, skipped: tuple[str, ...]) -> Result[Response]:
    if req.path in skipped:
        return next(req)
    id = request_id_from(req.header("X-Request-Id"))
    set_request_id_raw(id)
    req.set_local(REQUEST_ID, id)
    start = monotonic_raw()
    result = next(req)
    ms = (monotonic_raw() - start) * 1000.0
    label = req.route_label()
    if label // QUIET % 2 == 1:
        # The health checks, which a load balancer asks for every few seconds.
        set_request_id_raw("")
        return result
    status = 200
    match result:
        case Ok(response):
            status = response.status
            response.headers["X-Request-Id"] = id
        case Err(problem):
            status = problem.status()
            req.add_error_header("X-Request-Id", id)
    if req.handle >= 0 and cancel_state_raw() == 1:
        # Past the route's timeout the client is answered 503, whatever the handler gave.
        status = 503
    fields = {"method": req.method, "path": req.path, "status": str(status), "ms": f"{ms:.2f}"}
    route = route_pattern_raw(label)
    if route != "":
        fields["route"] = route
    client = req.client_ip()
    if client != "":
        fields["client"] = client
    if status >= 500:
        log.error(f"{req.method} {req.path} {status}", fields)
    else:
        log.info(f"{req.method} {req.path} {status}", fields)
    set_request_id_raw("")
    return result

def request_id_from(sent: str?) -> str:
    match sent:
        case Some(id):
            if usable_request_id(id):
                return id
        case None:
            pass
    return str(uuid.v7())

def usable_request_id(id: str) -> bool:
    if id == "" or len(id) > 128:
        return False
    for c in id:
        code = ord(c)
        ascii_alnum = (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
        if not (ascii_alnum or c == "." or c == "_" or c == "-"):
            return False
    return True

# ---- static files -------------------------------------------------------------------------

@frozen
struct StaticFiles:
    # The prefix's number of segments; the root, index and fallback, NUL-separated; 1 for
    # dotfiles and 2 for immutable.
    depth: int
    settings: str
    flags: int
    max_age: int

impl StaticFiles:
    def serve(self, req: Request) -> Result[Response]:
        conditions: list[str] = []
        for name in ["If-Match", "If-None-Match", "If-Modified-Since", "If-Unmodified-Since", "Range", "If-Range", "Accept-Encoding"]:
            conditions.append(req.header(name).unwrap_or("").replace("\0", ""))
        raw = __bytes(static_raw(req.handle, req.path, self.depth, self.settings, self.flags, self.max_age, "\0".join(conditions)))
        # `status\ncontent type\nheader lines`, a NUL, and for a test request the bytes to send.
        end = 0
        while raw[end] != 0:
            end += 1
        status_line, _, rest = raw.slice(0, end).decode().unwrap().partition("\n")
        content_type, _, header_lines = rest.partition("\n")
        status = int.parse(status_line).unwrap()
        if status == 404:
            return Err(HttpError(404, "not found"))
        headers: dict[str, str] = {}
        for line in header_lines.split("\r\n"):
            if line != "":
                name, _, value = line.partition(": ")
                headers[name] = value
        response = Response(status, "", content_type, headers)
        if req.handle < 0 and len(raw) > end + 1:
            response.data = raw.slice(end + 1, len(raw))
        return response

# ---- CORS ---------------------------------------------------------------------------------

@frozen
struct CorsPolicy:
    origins: tuple[str, ...]
    any_origin: bool
    allow: (def(str) -> bool)?
    methods: str
    # Lower-cased.
    headers: tuple[str, ...]
    any_header: bool
    expose: str
    credentials: bool
    max_age: int

pub def cors(
    origins: list[str] = [],
    allow: (def(str) -> bool)? = None,
    methods: list[str] = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"],
    headers: list[str] = ["Content-Type", "Authorization"],
    expose: list[str] = [],
    credentials: bool = False,
    max_age: int = 600,
) -> Middleware:
    """
    Middleware that lets pages from other origins call this server from a browser
    (cross-origin resource sharing):

        server.use(http.cors(origins=["https://app.example.com"], expose=["X-Request-Id"]))

    `origins` lists the origins allowed, exactly as browsers send them (`https://host` or
    `https://host:port`, no path), or `["*"]` for any. `allow` decides instead, or as well,
    for origins not listed: `allow=lambda origin: origin.ends_with(".example.com")`.

    A preflight (an `OPTIONS` request with `Origin` and `Access-Control-Request-Method`) is
    answered here with a 204 and never reaches a route: it allows `methods`, the requested
    headers that are in `headers` (`["*"]` allows any), and is cached by the browser for
    `max_age` seconds. Other requests from an allowed origin get `Access-Control-Allow-Origin`
    and `Access-Control-Expose-Headers` for `expose`, on errors too. `credentials=True` lets
    the browser send cookies and read the response; it needs listed origins, not `"*"`.
    Requests from other origins get no CORS headers, so the browser keeps the response from
    the page. Use it on a group (`api.use(http.cors(...))`) to allow only that group's routes.
    """
    if len(origins) == 0 and allow is None:
        panic("`http.cors` needs `origins` or `allow`, or it allows no origin")
    for origin in origins:
        if origin != "*" and (not origin.contains("://") or origin.partition("://")[2].contains("/")):
            panic(f"`http.cors` origin {origin!r} is not an origin such as \"https://app.example.com\" (a scheme and a host, with no path)")
    any_origin = "*" in origins
    if credentials and any_origin:
        panic("`http.cors` cannot allow credentials from any origin (`\"*\"`): browsers refuse that combination, so list the origins")
    lowered = [header.lower() for header in headers]
    policy = CorsPolicy(
        tuple(origins),
        any_origin,
        allow,
        ", ".join([method.upper() for method in methods]),
        tuple(lowered),
        "*" in lowered,
        ", ".join(expose),
        credentials,
        max_age,
    )
    return lambda req, next: policy.handle(req, next)

impl CorsPolicy:
    def allows(self, origin: str) -> bool:
        if self.any_origin or origin in self.origins:
            return True
        match self.allow:
            case Some(decide):
                return decide(origin)
            case None:
                return False

    def handle(self, req: Request, next: Handler) -> Result[Response]:
        origin = ""
        match req.header("Origin"):
            case Some(sent):
                origin = sent
            case None:
                return next(req)
        allowed = self.allows(origin)
        if req.method == "OPTIONS":
            match req.header("Access-Control-Request-Method"):
                case Some(_):
                    return self.preflight(req, origin, allowed)
                case None:
                    pass
        if not allowed:
            return next(req)
        result = next(req)
        match result:
            case Ok(response):
                for name, value in self.actual_headers(origin):
                    if name == "Vary":
                        add_vary(response, value)
                    else:
                        response.headers[name] = value
            case Err(_):
                for name, value in self.actual_headers(origin):
                    req.add_error_header(name, value)
        return result

    def allow_origin(self, origin: str) -> str:
        """The `Access-Control-Allow-Origin` value: `*` only when any origin is allowed without
        credentials, since a response that names the origin must not be cached for another."""
        return "*" if self.any_origin and not self.credentials else origin

    def actual_headers(self, origin: str) -> list[tuple[str, str]]:
        headers = [("Access-Control-Allow-Origin", self.allow_origin(origin))]
        if self.allow_origin(origin) != "*":
            headers.append(("Vary", "Origin"))
        if self.credentials:
            headers.append(("Access-Control-Allow-Credentials", "true"))
        if self.expose != "":
            headers.append(("Access-Control-Expose-Headers", self.expose))
        return headers

    def preflight(self, req: Request, origin: str, allowed: bool) -> Result[Response]:
        response = no_content()
        response.headers["Vary"] = "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
        if not allowed:
            return response
        response.headers["Access-Control-Allow-Origin"] = self.allow_origin(origin)
        response.headers["Access-Control-Allow-Methods"] = self.methods
        match req.header("Access-Control-Request-Headers"):
            case Some(requested):
                granted: list[str] = []
                for name in requested.split(","):
                    name = name.strip()
                    if name != "" and (self.any_header or name.lower() in self.headers):
                        granted.append(name)
                if len(granted) > 0:
                    response.headers["Access-Control-Allow-Headers"] = ", ".join(granted)
            case None:
                pass
        if self.credentials:
            response.headers["Access-Control-Allow-Credentials"] = "true"
        if self.max_age >= 0:
            response.headers["Access-Control-Max-Age"] = str(self.max_age)
        return response

def add_vary(response: Response, name: str):
    """Add `name` to the response's `Vary` header."""
    key = "Vary"
    for existing in response.headers.keys():
        if existing.lower() == "vary":
            key = existing
    match response.headers.get(key):
        case Some(value):
            if name.lower() not in [part.strip().lower() for part in value.split(",")]:
                response.headers[key] = f"{value}, {name}"
        case None:
            response.headers[key] = name

def find_header(response: Response, name: str) -> str?:
    """A response header, with the name in any case."""
    lowered = name.lower()
    for key, value in response.headers.items():
        if key.lower() == lowered:
            return value
    return None

# ---- compression ---------------------------------------------------------------------------

@frozen
struct Compression:
    min_size: int
    level: int
    types: tuple[str, ...]

pub def compress(
    min_size: int = 1024,
    level: int = 6,
    types: list[str] = ["text/*", "application/json", "application/javascript", "image/svg+xml"],
) -> Middleware:
    """
    Middleware that sends response bodies gzip-compressed to clients that accept it:

        server.use(http.compress())

    A body is compressed when the request's `Accept-Encoding` allows `gzip`, the body is at
    least `min_size` bytes, its content type matches one of `types` (`"text/*"` matches every
    `text/` type), and the response has no `Content-Encoding` of its own. A client that refuses
    uncompressed bodies (`identity;q=0`) gets gzip whatever the size and type. 1xx, 204, 206
    and 304 responses, responses with `Cache-Control: no-transform`, errors returned as `Err`
    and files from `server.static` (which sends `.gz` files beside them instead) are left
    alone. `level` runs from 1 (fastest) to 9 (smallest); 0 stores without compressing.

    Compressed responses get `Content-Encoding: gzip`, and their `ETag`, if any, becomes weak
    (`W/`), since the bytes differ from the uncompressed ones. Every response that could be
    compressed gets `Vary: Accept-Encoding`, so caches keep the two forms apart.
    """
    if level < 0 or level > 9:
        panic(f"`http.compress` level {level} is not between 0 and 9")
    if min_size < 0:
        panic(f"`http.compress` min_size {min_size} is negative")
    policy = Compression(min_size, level, tuple([kind.lower() for kind in types]))
    return lambda req, next: policy.handle(req, next)

impl Compression:
    def handle(self, req: Request, next: Handler) -> Result[Response]:
        result = next(req)
        match result:
            case Ok(response):
                self.apply(req, response)
            case Err(_):
                pass
        return result

    def fits(self, content_type: str) -> bool:
        kind = content_type.partition(";")[0].strip().lower()
        for wanted in self.types:
            if wanted == kind or (wanted.ends_with("/*") and kind.starts_with(wanted[0:len(wanted) - 1])):
                return True
        return False

    def apply(self, req: Request, response: Response):
        status = response.status
        if status < 200 or status == 204 or status == 206 or status == 304:
            return
        match find_header(response, "Content-Encoding"):
            case Some(_):
                return
            case None:
                pass
        size = len(response.body)
        match response.data:
            case Some(data):
                size = len(data)
            case None:
                pass
        if size == 0:
            return
        eligible = size >= self.min_size and self.fits(response.content_type)
        if eligible:
            add_vary(response, "Accept-Encoding")
        choice = 0
        match req.header("Accept-Encoding"):
            case Some(accepted):
                choice = gzip_choice_raw(accepted)
            case None:
                pass
        if choice == 0 or (choice == 1 and not eligible):
            return
        match find_header(response, "Cache-Control"):
            case Some(control):
                if control.lower().contains("no-transform"):
                    return
            case None:
                pass
        response.data = __bytes(gzip_raw(__bytes_data(response.body_bytes()), self.level))
        response.body = ""
        response.headers["Content-Encoding"] = "gzip"
        add_vary(response, "Accept-Encoding")
        for key, value in response.headers.items():
            if key.lower() == "etag" and not value.starts_with("W/"):
                response.headers[key] = "W/" + value

struct DocOperation:
    """A route `mount` documented: `operation` is its OpenAPI operation object as JSON text,
    without the `operationId`, which the document makes unique."""
    method: str
    path: str
    id: str
    operation: str
    ws: bool
    # The names in its `security=`, separated by spaces.
    security: str

struct DocsSettings:
    path: str
    title: str
    version: str
    description: str
    servers: list[str]
    tags: list[Tag]
    security: dict[str, SecurityScheme]
    hide_ws: bool

@frozen
pub struct Tag:
    """A tag of the API documentation: its description, and its place in the page. Give
    them to `docs(tags=[...])`; the page lists tags in that order, then the others."""
    name: str
    description: str = ""

@frozen
pub struct SecurityScheme:
    """How clients authenticate, for the API documentation. Make one with `http.bearer`,
    `http.basic_auth` or `http.api_key`, give it a name in `docs(security={...})`, and name it in
    `security=[...]` on the routes that need it. It documents the scheme; checking credentials is
    the job of your middleware."""
    priv kind: str = "bearer"
    priv name: str = ""
    priv format: str = ""
    priv description: str = ""

pub def bearer(format: str = "", description: str = "") -> SecurityScheme:
    """A token in `Authorization: Bearer <token>`. `format` is a hint such as `"JWT"`."""
    return SecurityScheme("bearer", "", format, description)

pub def basic_auth(description: str = "") -> SecurityScheme:
    """A user name and password in `Authorization: Basic ...`."""
    return SecurityScheme("basic", "", "", description)

pub def api_key(name: str, cookie: bool = False, description: str = "") -> SecurityScheme:
    """A key in the request header called `name`, or in the cookie called `name` when `cookie`
    is set."""
    return SecurityScheme("cookie" if cookie else "header", name, "", description)

def security_scheme_json(scheme: SecurityScheme) -> str:
    fields = ""
    if scheme.kind == "bearer" or scheme.kind == "basic":
        fields = "\"type\":\"http\",\"scheme\":" + jsonlib.encode(scheme.kind)
        if scheme.format != "":
            fields = fields + ",\"bearerFormat\":" + jsonlib.encode(scheme.format)
    else:
        fields = "\"type\":\"apiKey\",\"in\":" + jsonlib.encode(scheme.kind) + ",\"name\":" + jsonlib.encode(scheme.name)
    if scheme.description != "":
        fields = fields + ",\"description\":" + jsonlib.encode(scheme.description)
    return "{" + fields + "}"

pub struct Server:
    """
    Routes, middleware and settings. Register routes, then call `listen`. Request handlers run
    concurrently, one task per connection, so handlers and mounted values must be shareable.
    """
    # The largest request body a route reads, unless the route or its group says otherwise;
    # larger ones get a 413. Bodies over 64 KiB are read only when the handler asks for them.
    max_body: int = 8388608
    # The most headers a request may have (else 431), and the longest path and query string
    # (else 414).
    max_headers: int = 100
    max_url: int = 8192
    # Forms (`req.form()`): the most files (else 413), text fields (else 413) and bytes of
    # headers in one part (else 400), and where files over 1 MiB wait until the request ends
    # ("" for the system's temporary directory).
    max_files: int = 10
    max_fields: int = 1000
    # Seconds a handler may run before its task is cancelled and the client answered 503 with
    # `Retry-After: 1`, unless the route or its group says otherwise; 0 for no limit.
    timeout: float = 0.0
    max_part_headers: int = 8192
    upload_dir: str = ""
    max_message: int = 16777216
    ping_interval: int = 30
    trusted_proxies: list[str] = []
    # Seconds to go on serving after SIGTERM, with `/readyz` failing, before closing: time for a
    # load balancer to stop sending requests. 5 is typical on Kubernetes.
    drain_delay: int = 0
    priv routes: list[Route] = []
    priv middleware: list[Middleware] = []
    priv error_handler: (def(Request, HttpError) -> Response)? = None
    priv chain: Handler? = None
    priv listener: int = -1
    # For each path that is exactly a route's pattern without parameters, every route that
    # path fits, in order, with its parameters: worked out once, in `compose`.
    priv fixed: dict[str, list[Candidate]] = {}
    # The parameters of a request on a route without any, shared by all such requests. Never
    # changed: `params` is only ever replaced, and read.
    priv no_params: dict[str, str] = {}
    # The API documentation (docs/12): what `mount` recorded when the program asks for it, the
    # settings given to `docs`, the patterns of the routes `docs` added, and the documents
    # once built ("" until the first request for them, and after any route is added).
    priv doc_operations: list[DocOperation] = []
    priv doc_schemas: dict[str, str] = {}
    priv docs_settings: DocsSettings? = None
    priv docs_routes: list[str] = []
    priv docs_json: str = ""
    priv docs_yaml: str = ""
    # Security schemes that libraries document for every page, such as `auth`'s session cookie.
    priv security_schemes: dict[str, SecurityScheme] = {}

impl Server:
    def route(self, method: str, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        """Register a handler for a method and a path such as `/todos/{id}` or `/files/{rest...}`.
        `max_body` is the largest request body it reads, in bytes, and `timeout` the seconds its
        handler may run, in place of the server's."""
        self.routes.append(new_route(method.upper(), path, handler, max_body, timeout))
        self.chain = None
        self.docs_json = ""

    def get(self, path: str, handler: Handler, timeout: float = 0.0):
        self.route("GET", path, handler, 0, timeout)

    def post(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("POST", path, handler, max_body, timeout)

    def put(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("PUT", path, handler, max_body, timeout)

    def patch(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("PATCH", path, handler, max_body, timeout)

    def delete(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("DELETE", path, handler, max_body, timeout)

    def head(self, path: str, handler: Handler):
        self.route("HEAD", path, handler)

    def options(self, path: str, handler: Handler):
        self.route("OPTIONS", path, handler)

    def use(self, middleware: Middleware):
        """Add middleware, which runs around every route, first added outermost."""
        self.middleware.append(middleware)
        self.chain = None

    def static(
        self,
        prefix: str,
        root: str,
        max_age: int = 0,
        immutable: bool = False,
        index: str = "index.html",
        dotfiles: bool = False,
        fallback: str = "",
    ):
        """
        Serve the files under the directory `root` at `prefix`: `server.static("/assets",
        "public")` answers `GET /assets/css/site.css` with `public/css/site.css`.

        The runtime sends the file, with its content type from the extension, `ETag` and
        `Last-Modified` (so browsers revalidate with a 304), `Cache-Control: public,
        max-age=<max_age>` (`immutable` added for file names that change with their content),
        single ranges (206, 416) for video and resumed downloads, and `file.br` or `file.gz` in
        its place when it exists and the client accepts it. Large files are sent in pieces.
        A directory serves its `index` file. Paths that leave `root`, through `..`, an encoded
        `/` or a symbolic link, and dotfiles (unless `dotfiles=True`) are 404s.

        `fallback` names a file sent for paths with no file, for a single-page app whose
        router runs in the browser: `server.static("/", "dist", fallback="index.html")`.
        Routes without parameters are always tried before it; routes with parameters are tried
        in the order they were added, so add those first. The files are not listed in the API
        documentation.
        """
        problem = static_root_raw(root)
        if problem != "":
            panic(f"`server.static` root {root!r} {problem}")
        base = prefix
        while base.ends_with("/"):
            base = base[0:len(base) - 1]
        flags = (1 if dotfiles else 0) + (2 if immutable else 0)
        settings = StaticFiles(len(split_path(prefix)), f"{root}\0{index}\0{fallback}", flags, max_age)
        self.docs_route(base + "/{path...}", lambda req: settings.serve(req))

    def ws(self, path: str, handler: WsHandler):
        """A WebSocket endpoint. `handler` runs in its own task for the life of each connection."""
        self.route("GET", path, lambda req: upgrade(req, handler))

    def group(self, prefix: str) -> Group:
        """Routes under a common path prefix, with their own middleware."""
        return Group(self, prefix)

    def on_error(self, handler: def(Request, HttpError) -> Response):
        """Replace how errors returned by handlers become responses."""
        self.error_handler = handler

    def dispatch(self, req: Request) -> Result[Response]:
        # The first route, in order, that the path fits and that accepts the method.
        match self.fixed.get(req.path):
            case Some(candidates):
                for candidate in candidates:
                    if accepts(candidate.route, req.method):
                        req.params = candidate.params
                        req.routed(candidate.route)
                        return candidate.route.handler(req)
                return self.unrouted(req, [candidate.route for candidate in candidates])
            case None:
                pass
        segments = split_path(req.path)
        for route in self.routes:
            if fits(route, segments) and accepts(route, req.method):
                req.params = params_of(route, segments) if route.has_params else self.no_params
                req.routed(route)
                return route.handler(req)
        return self.unrouted(req, [route for route in self.routes if fits(route, segments)])

    def unrouted(self, req: Request, fitting: list[Route]) -> Result[Response]:
        """The answer when no route accepts the method. A CORS preflight goes to the route that
        accepts the method it asks about, if that route is in a group with middleware: the
        group's `http.cors` answers it (and without one, the 405 below comes back through it)."""
        if req.method == "OPTIONS":
            match req.header("Access-Control-Request-Method"):
                case Some(wanted):
                    for route in fitting:
                        if accepts(route, wanted):
                            match route.preflight:
                                case Some(preflight):
                                    return preflight(req)
                                case None:
                                    pass
                            break
                case None:
                    pass
        return not_routed(req, fitting)

    def build_fixed(self):
        fixed: dict[str, list[Candidate]] = {}
        for route in self.routes:
            if route.has_params or route.pattern in fixed:
                continue
            segments = split_path(route.pattern)
            candidates: list[Candidate] = []
            for other in self.routes:
                if fits(other, segments):
                    params = params_of(other, segments) if other.has_params else self.no_params
                    candidates.append(Candidate(other, params))
            fixed[route.pattern] = candidates
        self.fixed = fixed

    def handle(self, req: Request) -> Response:
        """Answer one request: route it through the middleware and map errors to responses."""
        handler = self.compose()
        match handler(req):
            case Ok(response):
                return response
            case Err(problem):
                status = problem.status()
                if status >= 500:
                    log.error(f"{req.method} {req.path}: {problem.message()}")
                message = problem.message() if status < 500 else "internal server error"
                failure = HttpError(status, message)
                response = error(status, message)
                match self.error_handler:
                    case Some(custom):
                        response = custom(req, failure)
                    case None:
                        pass
                # Middleware (`request_log`, `cors`) could not add its headers to a response
                # that did not exist yet.
                match req.error_headers():
                    case Some(headers):
                        for name, value in headers.items():
                            response.headers[name] = value
                    case None:
                        pass
                return response

    def compose(self) -> Handler:
        match self.chain:
            case Some(chain):
                return chain
            case None:
                pass
        self.build_fixed()
        set_form_limits_raw(self.max_files, self.max_fields, self.max_part_headers, self.upload_dir)
        for route in self.routes:
            seconds = route.timeout if route.timeout > 0.0 else self.timeout
            set_route_timeout_raw(route.label, int(seconds * 1000000000.0))
        server = self
        handler: Handler = lambda req: server.dispatch(req)
        for i in range(len(self.middleware) - 1, -1, -1):
            handler = wrap(self.middleware[i], handler)
        self.chain = handler
        return handler

    def bind(self, address: str) -> Result[int, HttpError]:
        """Start listening on `host:port` (`":8080"` for all interfaces, `":0"` for any free
        port). Returns the port. Then call `serve`."""
        return self.bound(listen_raw(address))

    def bind_tls(self, address: str, cert_file: str, key_file: str) -> Result[int, HttpError]:
        """`bind` for HTTPS: `cert_file` is the PEM certificate chain (the server's certificate
        first) and `key_file` its PEM private key. WebSockets on this server use TLS too."""
        return self.bound(listen_tls_raw(address, cert_file, key_file))

    def bound(self, listener: int) -> Result[int, HttpError]:
        if listener < 0:
            return Err(HttpError(500, last_error()))
        self.listener = listener
        problem = set_trusted_proxies_raw(",".join(self.trusted_proxies))
        if problem != "":
            panic(f"`trusted_proxies` holds {problem!r}, which is not an IP address or a network such as \"10.0.0.0/8\"")
        set_max_body_raw(self.max_body)
        set_request_limits_raw(self.max_headers, self.max_url)
        set_drain_raw(self.drain_delay)
        ws_set_limits(self.max_message, self.ping_interval)
        return port_raw(listener)

    def serve(self):
        """Serve requests until the program is interrupted (SIGINT or SIGTERM) or `stop` is
        called; requests in progress finish first. After SIGTERM or `stop`, the server goes on
        serving for `drain_delay` seconds first, with `/readyz` (`health`) failing."""
        self.compose()
        server = self
        def serve_one(handle: int):
            req = Request(req_method(handle), req_path(handle), handle, server.no_params)
            response = server.handle(req)
            # The runtime writes the status line, `Content-Type` and its own headers straight
            # into the response; only extra headers need a string here.
            headers = ""
            if len(response.headers) > 0:
                header_lines: list[str] = []
                for name, value in response.headers.items():
                    if "\n" in value or "\r" in value:
                        # Several values (`add_header`, `set_cookie`): one line each. A line
                        # break can never start a header of another name.
                        for line in value.replace("\r", "").split("\n"):
                            header_lines.append(f"{name}: {line}\r\n")
                    else:
                        header_lines.append(f"{name}: {value}\r\n")
                headers = "".join(header_lines)
            match response.data:
                case Some(data):
                    respond_raw(handle, response.status, response.content_type, headers, __bytes_data(data))
                case None:
                    respond_raw(handle, response.status, response.content_type, headers, response.body)
        __http_serve(self.listener, serve_one)

    def listen(self, address: str) -> Result[None, HttpError]:
        """`bind` and `serve`."""
        port = self.bind(address)?
        log.info(f"listening on port {port}")
        self.serve()

    def listen_tls(self, address: str, cert_file: str, key_file: str) -> Result[None, HttpError]:
        """`bind_tls` and `serve`."""
        port = self.bind_tls(address, cert_file, key_file)?
        log.info(f"listening on port {port} (https)")
        self.serve()

    def stop(self):
        """Ask `serve` to finish, as SIGTERM does."""
        shutdown_raw()

    def metrics(self, path: str = "/metrics", dashboard: bool = True, user: str? = None, password: str? = None, public: bool = False):
        """
        Serve the metrics at `path` in the Prometheus text format: requests by method, route
        pattern and status, their durations and response sizes, connections, errors, memory and
        tasks, and the program's own (the `metrics` module). Recording requests starts here;
        before, it costs nothing. With `dashboard`, a page at `path + "/dashboard"` charts them
        over the last hour, with the routes, recent server errors and slowest requests.

        Both need a user name and password (HTTP Basic authentication), from the arguments or
        else from the environment variables `METRICS_USER` and `METRICS_PASSWORD`, or
        `METRICS_PASSWORD_HASH` in place of the password (a hash from the compiler's
        `hash-password` command). Without them this panics, unless `public=True` says the
        metrics are meant to be open, behind a private network. After ten wrong passwords in a
        minute a client is refused for a minute. The routes are left out of the metrics and of
        the API documentation.
        """
        name = user if user is not None else os.getenv("METRICS_USER")
        secret = password if password is not None else os.getenv("METRICS_PASSWORD")
        hashed = 0
        if secret is None and password is None:
            secret = os.getenv("METRICS_PASSWORD_HASH")
            hashed = 1
        credentials = -1
        if name is not None and secret is not None:
            credentials = metrics_credentials_raw(name.unwrap(), secret.unwrap(), hashed)
            if credentials < 0:
                panic(last_error())
        elif not public:
            panic("server.metrics needs a username and password: set METRICS_USER and METRICS_PASSWORD in the environment or in .env (read by config.load or config.load_env), or pass public=True to serve the metrics without them.")
        metrics_enable_raw()
        self.special_route(path, lambda req: Ok(metrics_reply(req, credentials)), UNMETERED)
        if not dashboard:
            return
        base = path
        while base.ends_with("/"):
            base = base[0:len(base) - 1]
        board = base + "/dashboard"
        dashboard_start_raw()
        page = docs_file(dashboard_asset_raw(0).replace("{{base}}", html_escape(board)), "text/html; charset=utf-8", True)
        style = docs_file(dashboard_asset_raw(1), "text/css; charset=utf-8", False)
        script = docs_file(dashboard_asset_raw(2), "text/javascript; charset=utf-8", False)
        self.special_route(board, lambda req: Ok(dashboard_file(req, credentials, page)), UNMETERED)
        self.special_route(board + "/", lambda req: Ok(dashboard_file(req, credentials, page)), UNMETERED)
        self.special_route(board + "/dashboard.css", lambda req: Ok(dashboard_file(req, credentials, style)), UNMETERED)
        self.special_route(board + "/dashboard.js", lambda req: Ok(dashboard_file(req, credentials, script)), UNMETERED)
        self.special_route(board + "/data.json", lambda req: Ok(dashboard_data(req, credentials)), UNMETERED)

    def health(self, live: str = "/healthz", ready: str = "/readyz", checks: dict[str, def() -> Result[None]] = {}):
        """
        Health checks for a load balancer or orchestrator. `live` always answers `200 ok`
        while the process serves. `ready` runs the `checks` at once, each in its own task with
        two seconds to pass, and answers 200 with `{"database": "ok"}`, or 503 with each
        failure's message in place of `"ok"`. After SIGTERM it answers 503
        `{"server": "draining"}` for the server's `drain_delay`. Neither route is in the access
        log, the metrics or the API documentation.

            server.health(checks={"database": lambda: ping(db)})
        """
        self.special_route(live, lambda req: Ok(Response(200, "ok\n").with_header("Cache-Control", "no-store")), UNMETERED + QUIET)
        named: tuple[str, ...] = tuple(sorted(checks.keys()))
        run: tuple[def() -> Result[None], ...] = tuple([checks[name] for name in named])
        self.special_route(ready, lambda req: Ok(readiness(named, run)), UNMETERED + QUIET)

    def special_route(self, pattern: str, handler: Handler, flags: int):
        # A GET route of the server's own, left out of the API documentation and, as `flags`
        # says, of the metrics or the access log.
        route = new_route("GET", pattern, handler)
        route.label = route.label + flags
        self.routes.append(route)
        self.docs_routes.append(pattern)
        self.chain = None
        self.docs_json = ""

    def docs(
        self,
        path: str = "/docs",
        title: str = "API",
        version: str = "0.1.0",
        description: str = "",
        servers: list[str] = [],
        tags: list[Tag] = [],
        security: dict[str, SecurityScheme] = {},
        ui: bool = True,
        try_it_out: bool = True,
        hide_ws: bool = True,
    ):
        """
        Serve an API documentation page at `path`, and the OpenAPI 3.1 description it shows
        at `path + "/openapi.json"` and `path + "/openapi.yaml"`. The description is built from
        the routes' types, annotations and docstrings when first asked for, so `docs` can come
        before or after `mount`. `servers` are the base URLs listed in it (and the one "Try it
        out" sends to; by default the page's own). `tags` describe and order the tags; `security`
        names the ways clients authenticate, for the routes' `security=` (see `SecurityScheme`).
        `ui=False` serves only the description;
        `try_it_out=False` makes the page read-only. WebSocket endpoints are listed only with
        `hide_ws=False`. The routes go through the server's middleware like any other, so
        protect them as you would the API.
        """
        base = path
        while base.ends_with("/"):
            base = base[0:len(base) - 1]
        self.docs_settings = DocsSettings(base, title, version, description, servers, tags, security, hide_ws)
        server = self
        self.docs_route(base + "/openapi.json", lambda req: Ok(server.openapi_reply(False)))
        self.docs_route(base + "/openapi.yaml", lambda req: Ok(server.openapi_reply(True)))
        if not ui:
            return
        page_text = (
            docs_asset(0)
            .replace("{{base}}", html_escape(base))
            .replace("{{openapi_url}}", html_escape(base + "/openapi.json"))
            .replace("{{try_it_out}}", "true" if try_it_out else "false")
            .replace("{{title}}", html_escape(title))
        )
        page = docs_file(page_text, "text/html; charset=utf-8", True)
        css = docs_file(docs_asset(1), "text/css; charset=utf-8", False)
        core = docs_file(docs_asset(2), "text/javascript; charset=utf-8", False)
        viewer = docs_file(docs_asset(3), "text/javascript; charset=utf-8", False)
        if base != "":
            self.docs_route(base, lambda req: Ok(serve_docs_file(page, req)))
        self.docs_route(base + "/", lambda req: Ok(serve_docs_file(page, req)))
        self.docs_route(base + "/viewer.css", lambda req: Ok(serve_docs_file(css, req)))
        self.docs_route(base + "/core.js", lambda req: Ok(serve_docs_file(core, req)))
        self.docs_route(base + "/viewer.js", lambda req: Ok(serve_docs_file(viewer, req)))

    def openapi_json(
        self,
        title: str = "API",
        version: str = "0.1.0",
        description: str = "",
        servers: list[str] = [],
        tags: list[Tag] = [],
        security: dict[str, SecurityScheme] = {},
        hide_ws: bool = True,
    ) -> str:
        """The OpenAPI document `docs` serves, as JSON text: for tests, a file, or a route of
        your own."""
        return self.document(DocsSettings("", title, version, description, servers, tags, security, hide_ws))

    def security_scheme(self, name: str, scheme: SecurityScheme):
        """Document a security scheme on every documentation page of this server, as if it
        were given to `docs(security=...)`, which takes precedence. It is for libraries that
        protect routes: `auth`'s `install` documents the session cookie this way."""
        self.security_schemes[name] = scheme
        self.docs_json = ""

    def __document(self, method: str, path: str, id: str, operation: str, ws: bool, security: str):
        """Used by the code `server.mount` generates: one documented route."""
        self.doc_operations.append(DocOperation(method, path, id, operation, ws, security))
        self.docs_json = ""

    def __schema(self, name: str, schema: str):
        """Used by the code `server.mount` generates: a schema the documented routes use."""
        self.doc_schemas[name] = schema
        self.docs_json = ""

    def docs_route(self, pattern: str, handler: Handler):
        # A GET route left out of the API documentation: the documentation's own, and files.
        self.route("GET", pattern, handler)
        self.docs_routes.append(pattern)

    def openapi_reply(self, yaml: bool) -> Response:
        if self.docs_json == "":
            match self.docs_settings:
                case Some(settings):
                    self.docs_yaml = ""
                    self.docs_json = self.document(settings)
                case None:
                    pass
        if not yaml:
            return Response(200, self.docs_json, "application/json").with_header("Cache-Control", "no-cache")
        if self.docs_yaml == "":
            self.docs_yaml = yaml_of_json(self.docs_json)
        return Response(200, self.docs_yaml, "application/yaml").with_header("Cache-Control", "no-cache")

    def document(self, settings: DocsSettings) -> str:
        """The OpenAPI document, as JSON text, joined from what `mount` recorded. Call-style
        routes are listed with their method, path and path parameters."""
        schemes: dict[str, SecurityScheme] = {}
        for name in self.security_schemes.keys():
            schemes[name] = self.security_schemes[name]
        for name in settings.security.keys():
            schemes[name] = settings.security[name]
        documented: dict[str, DocOperation] = {}
        for op in self.doc_operations:
            documented[op.method + " " + op.path] = op
        seen: list[str] = []
        order: list[str] = []
        by_path: dict[str, list[str]] = {}
        used_ids: dict[str, int] = {}
        for route in self.routes:
            method = route.method.lower()
            path = route.pattern.replace("...}", "}")
            key = route.method + " " + path
            if route.pattern in self.docs_routes or not OPENAPI_METHODS.contains(" " + method + " ") or key in seen:
                continue
            seen.append(key)
            operation = ""
            match documented.get(key):
                case Some(op):
                    if op.ws and settings.hide_ws:
                        continue
                    if op.security != "":
                        for name in op.security.split(" "):
                            if name not in schemes:
                                if name == "googleSession":
                                    panic(f"the route {op.method} {op.path} needs a signed-in user, but no sign-in provider is installed: call `provider.install(server)`")
                                panic(f"the route {op.method} {op.path} names the security scheme `{name}`, which `docs` was not given")
                    id = unique_id(op.id, used_ids)
                    operation = "{\"operationId\":" + jsonlib.encode(id) + "," + op.operation[1:]
                case None:
                    operation = call_style_operation(route)
            if path not in by_path:
                order.append(path)
                by_path[path] = []
            by_path[path].append(jsonlib.encode(method) + ":" + operation)
        info = "{\"title\":" + jsonlib.encode(settings.title) + ",\"version\":" + jsonlib.encode(settings.version)
        if settings.description != "":
            info = info + ",\"description\":" + jsonlib.encode(settings.description)
        parts = ["{\"openapi\":\"3.1.0\",\"info\":" + info + "}"]
        if len(settings.servers) > 0:
            urls = ["{\"url\":" + jsonlib.encode(url) + "}" for url in settings.servers]
            parts.append(",\"servers\":[" + ",".join(urls) + "]")
        if len(settings.tags) > 0:
            tags: list[str] = []
            for tag in settings.tags:
                text = "{\"name\":" + jsonlib.encode(tag.name)
                if tag.description != "":
                    text = text + ",\"description\":" + jsonlib.encode(tag.description)
                tags.append(text + "}")
            parts.append(",\"tags\":[" + ",".join(tags) + "]")
        paths = [jsonlib.encode(path) + ":{" + ",".join(by_path[path]) + "}" for path in order]
        parts.append(",\"paths\":{" + ",".join(paths) + "}")
        components: list[str] = []
        if len(self.doc_schemas) > 0:
            names = sorted(self.doc_schemas.keys())
            schemas = [jsonlib.encode(name) + ":" + self.doc_schemas[name] for name in names]
            components.append("\"schemas\":{" + ",".join(schemas) + "}")
        if len(schemes) > 0:
            names = sorted(schemes.keys())
            described = [jsonlib.encode(name) + ":" + security_scheme_json(schemes[name]) for name in names]
            components.append("\"securitySchemes\":{" + ",".join(described) + "}")
        if len(components) > 0:
            parts.append(",\"components\":{" + ",".join(components) + "}")
        parts.append("}")
        return "".join(parts)

pub struct Group:
    priv server: Server
    priv prefix: str
    priv middleware: list[Middleware] = []
    # The largest request body its routes read, unless a route says otherwise; 0 for the
    # server's `max_body`.
    max_body: int = 0
    # The seconds its handlers may run, unless a route says otherwise; 0 for the server's
    # `timeout`.
    timeout: float = 0.0

impl Group:
    def route(self, method: str, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        wrapped = handler
        for i in range(len(self.middleware) - 1, -1, -1):
            wrapped = wrap(self.middleware[i], wrapped)
        limit = max_body if max_body > 0 else self.max_body
        self.server.route(method, self.prefix + path, wrapped, limit, timeout if timeout > 0.0 else self.timeout)
        if len(self.middleware) > 0:
            server = self.server
            preflight: Handler = lambda req: not_routed(req, [r for r in server.routes if fits(r, split_path(req.path))])
            for i in range(len(self.middleware) - 1, -1, -1):
                preflight = wrap(self.middleware[i], preflight)
            server.routes[len(server.routes) - 1].preflight = preflight

    def get(self, path: str, handler: Handler, timeout: float = 0.0):
        self.route("GET", path, handler, 0, timeout)

    def post(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("POST", path, handler, max_body, timeout)

    def put(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("PUT", path, handler, max_body, timeout)

    def patch(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("PATCH", path, handler, max_body, timeout)

    def delete(self, path: str, handler: Handler, max_body: int = 0, timeout: float = 0.0):
        self.route("DELETE", path, handler, max_body, timeout)

    def ws(self, path: str, handler: WsHandler):
        self.route("GET", path, lambda req: upgrade(req, handler))

    def __document(self, method: str, path: str, id: str, operation: str, ws: bool, security: str):
        """Used by the code `group.mount` generates: one documented route."""
        self.server.__document(method, self.prefix + path, id, operation, ws, security)

    def __schema(self, name: str, schema: str):
        """Used by the code `group.mount` generates: a schema the documented routes use."""
        self.server.__schema(name, schema)

    def use(self, middleware: Middleware):
        """Middleware for the routes registered on this group after this call."""
        self.middleware.append(middleware)

    def group(self, prefix: str) -> Group:
        nested = Group(self.server, self.prefix + prefix)
        nested.max_body = self.max_body
        nested.timeout = self.timeout
        for middleware in self.middleware:
            nested.middleware.append(middleware)
        return nested

# ---- API documentation --------------------------------------------------------------------

struct DocsFile:
    """A file of the documentation page, with its `ETag`."""
    body: str
    content_type: str
    etag: str
    # The page itself, which gets the security headers.
    page: bool

def docs_file(body: str, content_type: str, page: bool) -> DocsFile:
    return DocsFile(body, content_type, f"\"{docs_hash(body)}\"", page)

def serve_docs_file(file: DocsFile, req: Request) -> Response:
    """The file, or `304 Not Modified` when the browser has this version. Browsers check each
    time (`no-cache`), so a server with a newer viewer is never stuck behind an old one."""
    response = Response(200, file.body, file.content_type)
    match req.header("If-None-Match"):
        case Some(tags):
            if tags.contains(file.etag):
                response = Response(304, "", "")
        case None:
            pass
    response.headers["ETag"] = file.etag
    response.headers["Cache-Control"] = "no-cache"
    response.headers["X-Content-Type-Options"] = "nosniff"
    if file.page:
        # No inline script or style; requests from "Try it out" may go to any server listed.
        response.headers["Content-Security-Policy"] = "default-src 'self'; connect-src *; img-src 'self' data:"
        response.headers["Referrer-Policy"] = "no-referrer"
    return response

def html_escape(text: str) -> str:
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")

# The methods an OpenAPI path item can have, each between spaces.
const OPENAPI_METHODS = " get put post delete options head patch trace "

def unique_id(id: str, used: dict[str, int]) -> str:
    """`id`, or `id_2`, `id_3`... when the document already has it (a type mounted twice)."""
    match used.get(id):
        case None:
            used[id] = 1
            return id
        case Some(count):
            n = count + 1
            candidate = f"{id}_{n}"
            while candidate in used:
                n += 1
                candidate = f"{id}_{n}"
            used[id] = n
            used[candidate] = 1
            return candidate

def call_style_operation(route: Route) -> str:
    """What is known of a route registered with `server.get(...)` and the like."""
    parameters: list[str] = []
    for i in range(len(route.kinds)):
        if route.kinds[i] != LITERAL:
            parameters.append(
                "{\"name\":" + jsonlib.encode(route.names[i])
                + ",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}"
            )
    text = "{"
    if len(parameters) > 0:
        text = text + "\"parameters\":[" + ",".join(parameters) + "],"
    return text + "\"responses\":{\"default\":{\"description\":\"Response\"}}}"

def yaml_of_json(text: str) -> str:
    """The same document in YAML. Strings are plain when they cannot be read as anything else,
    and double-quoted otherwise, which in YAML takes JSON's escapes."""
    match jsonlib.parse(text):
        case Ok(value):
            lines: list[str] = []
            yaml_lines(value, "", lines)
            return "\n".join(lines) + "\n"
        case Err(_):
            return ""

def yaml_lines(value: jsonlib.Value, indent: str, out: list[str]):
    match value:
        case jsonlib.Value.Object(fields):
            for key, item in fields.items():
                match yaml_inline(item):
                    case Some(text):
                        out.append(indent + yaml_str(key) + ": " + text)
                    case None:
                        out.append(indent + yaml_str(key) + ":")
                        yaml_lines(item, indent + "  ", out)
        case jsonlib.Value.Array(items):
            for item in items:
                match yaml_inline(item):
                    case Some(text):
                        out.append(indent + "- " + text)
                    case None:
                        out.append(indent + "-")
                        yaml_lines(item, indent + "  ", out)
        case _:
            pass

def yaml_inline(value: jsonlib.Value) -> str?:
    """A value that fits on its line, or `None` for a non-empty object or array."""
    match value:
        case jsonlib.Value.Null:
            return "null"
        case jsonlib.Value.Bool(flag):
            if flag:
                return "true"
            return "false"
        case jsonlib.Value.Int(number):
            return f"{number}"
        case jsonlib.Value.Float(real):
            return jsonlib.encode(real)
        case jsonlib.Value.Str(text):
            return yaml_str(text)
        case jsonlib.Value.Array(items):
            if len(items) == 0:
                return "[]"
            return None
        case jsonlib.Value.Object(fields):
            if len(fields) == 0:
                return "{}"
            return None

# Letters, digits and the punctuation a plain YAML scalar may be made of here.
const YAML_PLAIN = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-/"
# Plain scalars that YAML would read as something other than a string, each between spaces.
const YAML_WORDS = " true false null yes no on off y n "

def yaml_str(text: str) -> str:
    if text == "" or YAML_WORDS.contains(" " + text.lower() + " ") or not YAML_PLAIN[0:52].contains(text[0:1]):
        return jsonlib.encode(text)
    for c in text:
        if not YAML_PLAIN.contains(c):
            return jsonlib.encode(text)
    return text

# ---- WebSockets ---------------------------------------------------------------------------

pub enum WsMessage:
    """A message from the peer: text, or binary data."""
    Text(body: str)
    Binary(data: bytes)

@derive(Display)
pub struct WsClosed:
    """The error from sending on a WebSocket that has closed."""
    id: int

impl Error for WsClosed:
    def message(self) -> str:
        return "the WebSocket is closed"

@frozen
pub struct WebSocket:
    """
    One WebSocket connection. Its handler receives with `recv()` or `for msg in ws`; any task may
    `send`, since sends are serialised per connection. A `WebSocket` can be shared between tasks,
    so a hub can keep connections in a `Mutex[dict[int, http.WebSocket]]`.
    """
    id: int
    path: str
    priv params: frozendict[str, str]

impl WebSocket:
    def recv(self) -> WsMessage?:
        """Wait for the next message; `None` once the connection has closed."""
        kind = ws_recv(self.id)
        if kind == 1:
            return Text(ws_payload())
        if kind == 2:
            return Binary(__bytes(ws_payload()))
        return None

    def next(self) -> WsMessage?:
        """`for msg in ws` receives until the connection closes."""
        return self.recv()

    def send(self, text: str) -> Result[None, WsClosed]:
        """Send a text message."""
        if ws_send(self.id, 0, text) < 0:
            return Err(WsClosed(self.id))
        return Ok(None)

    def send_bytes(self, data: bytes) -> Result[None, WsClosed]:
        """Send a binary message."""
        if ws_send(self.id, 1, __bytes_data(data)) < 0:
            return Err(WsClosed(self.id))
        return Ok(None)

    def close(self, code: int = 1000, reason: str = ""):
        """Start the closing handshake; `recv` then returns `None` once the peer agrees."""
        ws_close(self.id, code, reason)

    def param(self, name: str) -> str:
        """A `{name}` segment of the endpoint's path, or `""`."""
        return self.params.get_or(name, "")

    def query(self, name: str) -> str?:
        """A query parameter of the upgrade request."""
        return ws_query(self.id, name)

    def header(self, name: str) -> str?:
        """A header of the upgrade request."""
        return ws_header(self.id, name)

    def remote_addr(self) -> str:
        return ws_remote(self.id)

pub def send_json[T: ToJson](ws: WebSocket, value: T) -> Result[None, WsClosed]:
    """Send a value as a JSON text message."""
    return ws.send(jsonlib.encode(value))

pub type WsHandler = def(WebSocket)
"""A WebSocket endpoint's handler, which runs for the life of the connection."""

pub def upgrade(req: Request, handler: WsHandler) -> Result[Response]:
    """Answer a WebSocket handshake and run `handler` on the connection until it returns."""
    id = ws_accept(req.handle)
    if id == -2:
        return Ok(error(426, last_error()).with_header("Sec-WebSocket-Version", "13"))
    if id < 0:
        return Err(HttpError(400, last_error()))
    ws = WebSocket(id, req.path, frozendict(req.params))
    handler(ws)
    ws_finish(id)
    return Ok(Response(101, "", ""))

# ---- the client ----------------------------------------------------------------------------

pub struct ClientError:
    """A request that got no response: the host could not be reached, it closed the connection
    early, it timed out (after 30 seconds, unless the call gave a `timeout`), its TLS certificate
    is not trusted, or the URL is not `http://` or `https://`."""
    url: str
    reason: str

impl Error for ClientError:
    def message(self) -> str:
        return f"{self.url}: {self.reason}"

    def status(self) -> int:
        """Returned from a handler, a failed call to another service is a 502 Bad Gateway."""
        return 502

pub struct ClientResponse:
    """A response from another server."""
    status: int
    body: bytes
    priv headers: dict[str, str] = {}
    priv url: str = ""

impl ClientResponse:
    def ok(self) -> bool:
        """Whether the status is 2xx."""
        return self.status >= 200 and self.status < 300

    def header(self, name: str) -> str?:
        """A response header; names are case-insensitive. A header sent several times, such as
        `Set-Cookie`, is its values joined by newlines."""
        return self.headers.get(name.lower())

    def text(self) -> Result[str, ClientError]:
        """The body as text; an error if it is not UTF-8."""
        match self.body.decode():
            case Some(text):
                return text
            case None:
                return Err(ClientError(self.url, "the response body is not UTF-8 text"))

    def json(self) -> Result[jsonlib.Value, ClientError]:
        """The body parsed as JSON of any shape."""
        text = self.text()?
        match jsonlib.parse(text):
            case Ok(value):
                return value
            case Err(error):
                return Err(ClientError(self.url, f"invalid JSON: {error.message()}"))

pub def decode_json[T: FromJson](response: ClientResponse) -> Result[T, ClientError]:
    """The body decoded as JSON into a `T`."""
    text = response.text()?
    match jsonlib.decode[T](text):
        case Ok(value):
            return value
        case Err(error):
            return Err(ClientError(response.url, f"invalid JSON: {error.message()}"))

pub def fetch(
    method: str,
    url: str,
    body: str = "",
    headers: dict[str, str] = {},
    timeout: datetime.Duration = datetime.seconds(30),
    connect_timeout: datetime.Duration? = None,
) -> Result[ClientResponse, ClientError]:
    """Send a request and wait for the whole response, for at most `timeout` from connecting to
    the last byte, and at most `connect_timeout`, if given, for the connection. A task waiting
    here does not hold a worker, and a cancelled task's request fails at once. `https://` URLs
    use TLS, checking the server's certificate."""
    lines = ""
    for name, value in headers.items():
        lines = lines + f"{name}: {value}\r\n"
    connect_ns = 0
    match connect_timeout:
        case Some(limit):
            connect_ns = limit.nanoseconds()
        case None:
            pass
    status = client_raw(method, url, lines, body, timeout.nanoseconds(), connect_ns)
    if status < 0:
        return Err(ClientError(url, last_error()))
    parsed: dict[str, str] = {}
    for line in client_headers().split("\n"):
        parts = line.split(": ")
        if len(parts) >= 2:
            value = ": ".join(parts[1:])
            # A header sent several times (`Set-Cookie`) keeps every value, one per line.
            match parsed.get(parts[0]):
                case Some(earlier):
                    parsed[parts[0]] = earlier + "\n" + value
                case None:
                    parsed[parts[0]] = value
    return ClientResponse(status, __bytes(client_body()), parsed, url)

pub def get(url: str) -> Result[ClientResponse, ClientError]:
    """`GET url`."""
    return fetch("GET", url)

pub def post(url: str, body: str, content_type: str = "application/json") -> Result[ClientResponse, ClientError]:
    """`POST url` with a body."""
    return fetch("POST", url, body, {"Content-Type": content_type})

pub def post_form(url: str, fields: list[tuple[str, str]], headers: dict[str, str] = {}) -> Result[ClientResponse, ClientError]:
    """`POST url` with the fields as an HTML form would send them
    (`application/x-www-form-urlencoded`), as OAuth token endpoints expect."""
    all_headers = headers.copy()
    all_headers["Content-Type"] = "application/x-www-form-urlencoded"
    return fetch("POST", url, form_encode(fields), all_headers)

# ---- adapters for annotated routes --------------------------------------------------------

pub def reply_json[T: ToJson](value: T, status: int) -> Result[Response]:
    return Ok(json(value, status))

pub def reply_text(value: str, status: int) -> Result[Response]:
    return Ok(text(value, status))

pub def reply_empty(status: int) -> Result[Response]:
    return Ok(Response(status, "", ""))
