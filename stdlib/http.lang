# ---- errors -------------------------------------------------------------------------------

pub struct HttpError:
    """An error that becomes a response with its status: `Err(http.Error(404, "not found"))`."""
    status: int
    message: str

impl Error for HttpError:
    def message(self) -> str:
        return self.message

    def status(self) -> int:
        return self.status

impl Display for HttpError:
    def to_str(self) -> str:
        return f"{self.status} {self.message}"

pub def Error(status: int, message: str) -> HttpError:
    """An error with an HTTP status, for handlers to return."""
    return HttpError(status, message)

# ---- requests -----------------------------------------------------------------------------

pub struct Request:
    """
    A request being handled. `method` and `path` are filled in; the rest is read from the
    connection when asked for.
    """
    method: str
    path: str
    priv handle: int = -1
    priv params: dict[str, str] = {}
    # What no connection holds: a test request's parts, and the values middleware stored.
    # `None` until needed, so a request that uses neither is no bigger for them.
    priv extra: RequestExtra? = None

struct RequestExtra:
    # A test request's body, query string and headers; `None` for a request from a connection.
    test: TestParts?
    locals: dict[str, str]?

struct TestParts:
    body: str
    query: str
    # Names lower-cased.
    headers: dict[str, str]

impl Request:
    def param(self, name: str) -> str:
        """A `{name}` segment of the route's path, or `""`."""
        return self.params.get_or(name, "")

    def param_int(self, name: str) -> Result[int, HttpError]:
        """A path segment as an `int`; a 400 error if it is not one."""
        match int.parse(self.param(name)):
            case Ok(value):
                return value
            case Err(_):
                return Err(HttpError(400, f"path parameter `{name}` must be an integer"))

    def param_float(self, name: str) -> Result[float, HttpError]:
        match float.parse(self.param(name)):
            case Ok(value):
                return value
            case Err(_):
                return Err(HttpError(400, f"path parameter `{name}` must be a number"))

    def param_bool(self, name: str) -> Result[bool, HttpError]:
        return parse_bool(self.param(name), f"path parameter `{name}`")

    priv def test_parts(self) -> TestParts?:
        match self.extra:
            case Some(extra):
                return extra.test
            case None:
                return None

    def query(self, name: str) -> str?:
        """A query parameter (`?name=value`), decoded, or `None`."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return query_value_raw(parts.query, name)
                case None:
                    return None
        return req_query(self.handle, name)

    def query_string(self) -> str:
        """The query string as sent, without the `?` and not decoded: `""` if there is none."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return parts.query
                case None:
                    return ""
        return req_query_string(self.handle)

    def header(self, name: str) -> str?:
        """A header's value, or `None`. Header names are case-insensitive."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return parts.headers.get(name.lower())
                case None:
                    return None
        return req_header(self.handle, name)

    def set_local(self, name: str, value: str):
        """Keep a value with this request, for the handlers and middleware after this one:
        middleware that works out who is asking stores it here, as Express's `res.locals` and
        Starlette's `request.state` do."""
        match self.extra:
            case Some(extra):
                match extra.locals:
                    case Some(values):
                        values[name] = value
                    case None:
                        extra.locals = {name: value}
            case None:
                self.extra = RequestExtra(None, {name: value})

    def local(self, name: str) -> str?:
        """A value stored with `set_local`, or `None`."""
        match self.extra:
            case Some(extra):
                match extra.locals:
                    case Some(values):
                        return values.get(name)
                    case None:
                        return None
            case None:
                return None

    def text(self) -> Result[str, HttpError]:
        """The body as text; a 400 error if it is not UTF-8. Each call reads it from the
        connection's buffer again, so keep the result rather than calling it twice."""
        if self.handle < 0:
            match self.test_parts():
                case Some(parts):
                    return parts.body
                case None:
                    return ""
        match req_body(self.handle):
            case Some(text):
                return text
            case None:
                return Err(HttpError(400, "the request body is not UTF-8 text"))

    def json(self) -> Result[jsonlib.Value, HttpError]:
        """The body parsed as JSON of any shape; a 400 error if it is not JSON."""
        text = self.text()?
        match jsonlib.parse(text):
            case Ok(value):
                return value
            case Err(error):
                return Err(HttpError(400, f"invalid JSON body: {error.message()}"))

    def remote_addr(self) -> str:
        """The client's address and port."""
        if self.handle < 0:
            return ""
        return req_remote(self.handle)

    def cookie(self, name: str) -> str?:
        """A cookie sent with the request (from its `Cookie` header), or `None`. `%XX` escapes
        are decoded, undoing what `Response.set_cookie` does to characters a cookie cannot
        hold; a value with a malformed escape is returned as it was sent."""
        match self.header("Cookie"):
            case Some(text):
                for pair in text.split(";"):
                    parts = pair.strip().split("=")
                    if len(parts) >= 2 and parts[0] == name:
                        value = "=".join(parts[1:])
                        if "%" not in value:
                            return value
                        return url_decode_raw(value, 0).unwrap_or(value)
                return None
            case None:
                return None

@frozen
pub struct Header:
    """A handler parameter bound from the request header named after it:
    `user_agent: http.Header` is the `User-Agent` header. A 400 if it is missing, unless the
    parameter is `http.Header?`."""
    value: str

impl Display for Header:
    def to_str(self) -> str:
        return self.value

@frozen
pub struct Cookie:
    """A handler parameter bound from the cookie with its name: `session: http.Cookie`. A 400
    if it is missing, unless the parameter is `http.Cookie?`."""
    value: str

impl Display for Cookie:
    def to_str(self) -> str:
        return self.value

pub def header_param(req: Request, name: str) -> Result[Header, HttpError]:
    match req.header(name):
        case Some(value):
            return Header(value)
        case None:
            return Err(HttpError(400, f"missing header `{name}`"))

pub def header_param_opt(req: Request, name: str) -> Result[Header?, HttpError]:
    match req.header(name):
        case Some(value):
            return Ok(Some(Header(value)))
        case None:
            return Ok(None)

pub def cookie_param(req: Request, name: str) -> Result[Cookie, HttpError]:
    match req.cookie(name):
        case Some(value):
            return Cookie(value)
        case None:
            return Err(HttpError(400, f"missing cookie `{name}`"))

pub def cookie_param_opt(req: Request, name: str) -> Result[Cookie?, HttpError]:
    match req.cookie(name):
        case Some(value):
            return Ok(Some(Cookie(value)))
        case None:
            return Ok(None)

pub def test_request(method: str, path: str, body: str = "", headers: dict[str, str] = {}) -> Request:
    """A request that is not from a connection, for calling `server.handle(...)` in tests.
    `path` may end in a query string (`"/items?limit=5"`), which `query` reads; `headers` are
    what `header` and `cookie` read, with names in any case."""
    before, _mark, after = path.partition("?")
    lowered: dict[str, str] = {}
    for name, value in headers.items():
        lowered[name.lower()] = value
    request = Request(method, before)
    request.extra = RequestExtra(TestParts(body, after, lowered), None)
    return request

def parse_bool(text: str, what: str) -> Result[bool, HttpError]:
    lowered = text.lower()
    if lowered == "true" or lowered == "1":
        return True
    if lowered == "false" or lowered == "0":
        return False
    return Err(HttpError(400, f"{what} must be `true` or `false`"))

pub def body[T: FromJson](req: Request) -> Result[T, HttpError]:
    """The body decoded as JSON into a `T`; a 400 error naming the problem if it does not fit."""
    text = req.text()?
    match jsonlib.decode[T](text):
        case Ok(value):
            return value
        case Err(error):
            return Err(HttpError(400, f"invalid JSON body: {error.message()}"))

pub def query_str(req: Request, name: str) -> Result[str, HttpError]:
    match req.query(name):
        case Some(text):
            return text
        case None:
            return Err(HttpError(400, f"missing query parameter `{name}`"))

pub def query_str_opt(req: Request, name: str) -> Result[str?, HttpError]:
    return Ok(req.query(name))

pub def query_int(req: Request, name: str) -> Result[int, HttpError]:
    text = query_str(req, name)?
    match int.parse(text):
        case Ok(value):
            return value
        case Err(_):
            return Err(HttpError(400, f"query parameter `{name}` must be an integer"))

pub def query_int_opt(req: Request, name: str) -> Result[int?, HttpError]:
    match req.query(name):
        case Some(_):
            value = query_int(req, name)?
            return Ok(Some(value))
        case None:
            return Ok(None)

pub def query_float(req: Request, name: str) -> Result[float, HttpError]:
    text = query_str(req, name)?
    match float.parse(text):
        case Ok(value):
            return value
        case Err(_):
            return Err(HttpError(400, f"query parameter `{name}` must be a number"))

pub def query_float_opt(req: Request, name: str) -> Result[float?, HttpError]:
    match req.query(name):
        case Some(_):
            value = query_float(req, name)?
            return Ok(Some(value))
        case None:
            return Ok(None)

pub def query_bool(req: Request, name: str) -> Result[bool, HttpError]:
    text = query_str(req, name)?
    return parse_bool(text, f"query parameter `{name}`")

pub def query_bool_opt(req: Request, name: str) -> Result[bool?, HttpError]:
    match req.query(name):
        case Some(text):
            value = parse_bool(text, f"query parameter `{name}`")?
            return Ok(Some(value))
        case None:
            return Ok(None)

# ---- responses ----------------------------------------------------------------------------

pub struct Response:
    status: int = 200
    body: str = ""
    content_type: str = "text/plain; charset=utf-8"
    headers: dict[str, str] = {}

impl Response:
    def with_header(self, name: str, value: str) -> Response:
        """Set a header, replacing any value it had, and return the response for chaining."""
        self.headers[name] = value
        return self

    def add_header(self, name: str, value: str) -> Response:
        """Add a header, keeping any it already has: the header is sent once per value. In
        `headers`, the values are joined by newlines."""
        match self.headers.get(name):
            case Some(existing):
                self.headers[name] = existing + "\n" + value
            case None:
                self.headers[name] = value
        return self

    def set_cookie(
        self,
        name: str,
        value: str,
        max_age: int = -1,
        path: str = "/",
        http_only: bool = True,
        secure: bool = False,
        same_site: str = "Lax",
    ) -> Response:
        """Set a cookie (a `Set-Cookie` header); any number can be set on one response.
        Characters a cookie cannot hold (spaces, `;`, `,`, `"`, `\\`, non-ASCII) and `%` are
        sent as `%XX`, which `req.cookie` decodes. `max_age` is in seconds; -1 makes a cookie
        that ends with the browser session. Scripts cannot read it unless `http_only=False`.
        `same_site` is `"Lax"`, `"Strict"`, `"None"` or `""` to leave it out. A cookie named
        `__Host-...` or `__Secure-...`, or with `same_site="None"`, is always `Secure`, as
        browsers require."""
        check_cookie_name(name)
        if same_site != "Lax" and same_site != "Strict" and same_site != "None" and same_site != "":
            panic(f"`same_site` must be \"Lax\", \"Strict\", \"None\" or \"\", not {same_site!r}")
        if ";" in path or "\n" in path or "\r" in path:
            panic(f"a cookie's path cannot contain `;` or a line break: {path!r}")
        if name.starts_with("__Host-") and path != "/":
            panic(f"a `__Host-` cookie must have the path \"/\", not {path!r}")
        parts = [name + "=" + cookie_encode_raw(value)]
        if path != "":
            parts.append("Path=" + path)
        if max_age >= 0:
            parts.append(f"Max-Age={max_age}")
        if http_only:
            parts.append("HttpOnly")
        if secure or same_site == "None" or name.starts_with("__Host-") or name.starts_with("__Secure-"):
            parts.append("Secure")
        if same_site != "":
            parts.append("SameSite=" + same_site)
        return self.add_header("Set-Cookie", "; ".join(parts))

    def delete_cookie(self, name: str, path: str = "/") -> Response:
        """Tell the browser to forget a cookie: the same name and path, expired now."""
        return self.set_cookie(name, "", 0, path, True, False, "Lax")

    def cookie(self, name: str) -> str?:
        """The value this response sets for the cookie `name`, decoded, or `None`: for tests."""
        match self.headers.get("Set-Cookie"):
            case Some(lines):
                for line in lines.split("\n"):
                    first, _mark, _rest = line.partition(";")
                    key, equals, value = first.partition("=")
                    if equals == "=" and key == name:
                        return url_decode_raw(value, 0).unwrap_or(value)
                return None
            case None:
                return None

def check_cookie_name(name: str):
    # RFC 6265: a token, so no separators, spaces or control characters.
    if name == "":
        panic("a cookie needs a name")
    for c in name:
        code = ord(c)
        if code <= 32 or code >= 127 or c in "()<>@,;:\\\"/[]?={}":
            panic(f"{name!r} is not a valid cookie name: use letters, digits and `-_.!#$%&'*+^`|~`")

pub def text(body: str, status: int = 200) -> Response:
    return Response(status, body, "text/plain; charset=utf-8")

pub def html(body: str, status: int = 200) -> Response:
    return Response(status, body, "text/html; charset=utf-8")

pub def json[T: ToJson](value: T, status: int = 200) -> Response:
    """A JSON response."""
    return Response(status, jsonlib.encode(value), "application/json")

pub def error(status: int, message: str) -> Response:
    """A JSON error response: `{"error": message}`."""
    return Response(status, jsonlib.encode({"error": message}), "application/json")

pub def redirect(location: str, status: int = 302) -> Response:
    return Response(status, "", "").with_header("Location", location)

pub def no_content() -> Response:
    return Response(204, "", "")

# ---- encoding -----------------------------------------------------------------------------

pub def url_encode(text: str) -> str:
    """`text` with every character but ASCII letters, digits and `-._~` written as `%XX`, byte
    by byte in UTF-8: safe in a query string, a form body or a path segment."""
    return url_encode_raw(text)

pub def url_decode(text: str, plus_is_space: bool = True) -> str?:
    """`%XX` escapes decoded, and `+` as a space unless `plus_is_space=False` (it is a space in
    query strings and form bodies, not in paths). `None` if an escape is malformed or the
    result is not UTF-8."""
    return url_decode_raw(text, 1 if plus_is_space else 0)

pub def form_encode(fields: list[tuple[str, str]]) -> str:
    """Name and value pairs as `a=1&b=2`, each part `url_encode`d: a query string, or an
    `application/x-www-form-urlencoded` body. A list keeps the order and allows a name twice."""
    parts: list[str] = []
    for name, value in fields:
        parts.append(url_encode_raw(name) + "=" + url_encode_raw(value))
    return "&".join(parts)

# ---- routing ------------------------------------------------------------------------------

pub type Handler = def(Request) -> Result[Response]
"""A request handler: every route, and the rest of the chain that middleware calls."""

pub type Middleware = def(Request, Handler) -> Result[Response]
"""Code that runs around handlers: it gets the request and the next handler."""

# The kinds of a route's path segments.
const LITERAL = 0
const PARAM = 1
const REST = 2

struct Route:
    method: str
    pattern: str
    handler: Handler
    # Per segment: its kind, and the literal text or the parameter's name.
    kinds: list[int]
    names: list[str]
    # Whether the pattern has parameters; if not, every path it matches is the same.
    has_params: bool

def new_route(method: str, pattern: str, handler: Handler) -> Route:
    kinds: list[int] = []
    names: list[str] = []
    for part in split_path(pattern):
        if part.starts_with("{") and part.ends_with("...}"):
            kinds.append(REST)
            names.append(part[1:len(part) - 4])
        elif part.starts_with("{") and part.ends_with("}"):
            kinds.append(PARAM)
            names.append(part[1:len(part) - 1])
        else:
            kinds.append(LITERAL)
            names.append(part)
    has_params = PARAM in kinds or REST in kinds
    return Route(method, pattern, handler, kinds, names, has_params)

def split_path(path: str) -> list[str]:
    return [part for part in path.split("/") if part != ""]

def fits(route: Route, path: list[str]) -> bool:
    """Whether `path` (split into segments) fits the route's pattern. Allocates nothing."""
    for i in range(len(route.kinds)):
        kind = route.kinds[i]
        if kind == REST:
            return True
        if i >= len(path):
            return False
        if kind == LITERAL and route.names[i] != path[i]:
            return False
    return len(path) == len(route.kinds)

def params_of(route: Route, path: list[str]) -> dict[str, str]:
    """The parameters of a path that fits the route."""
    params: dict[str, str] = {}
    for i in range(len(route.kinds)):
        kind = route.kinds[i]
        if kind == REST:
            params[route.names[i]] = "/".join(path[i:])
            return params
        if kind == PARAM:
            params[route.names[i]] = path[i]
    return params

def accepts(route: Route, method: str) -> bool:
    return route.method == method or (method == "HEAD" and route.method == "GET")

struct Candidate:
    """A route a path fits, with the parameters it gives."""
    route: Route
    params: dict[str, str]

def not_routed(req: Request, fitting: list[Route]) -> Result[Response]:
    """The response when no route takes the request: 405 with the methods the path's routes
    accept, or 404 if no route fits the path."""
    allowed: list[str] = []
    for route in fitting:
        if route.method not in allowed:
            allowed.append(route.method)
    if len(allowed) > 0:
        return error(405, "method not allowed").with_header("Allow", ", ".join(allowed))
    return error(404, "not found")

def wrap(middleware: Middleware, next: Handler) -> Handler:
    return lambda req: middleware(req, next)

struct DocOperation:
    """A route `mount` documented: `operation` is its OpenAPI operation object as JSON text,
    without the `operationId`, which the document makes unique."""
    method: str
    path: str
    id: str
    operation: str
    ws: bool
    # The names in its `security=`, separated by spaces.
    security: str

struct DocsSettings:
    path: str
    title: str
    version: str
    description: str
    servers: list[str]
    tags: list[Tag]
    security: dict[str, SecurityScheme]
    hide_ws: bool

@frozen
pub struct Tag:
    """A tag of the API documentation: its description, and its place in the page. Give
    them to `docs(tags=[...])`; the page lists tags in that order, then the others."""
    name: str
    description: str = ""

@frozen
pub struct SecurityScheme:
    """How clients authenticate, for the API documentation. Make one with `http.bearer`,
    `http.basic_auth` or `http.api_key`, give it a name in `docs(security={...})`, and name it in
    `security=[...]` on the routes that need it. It documents the scheme; checking credentials is
    the job of your middleware."""
    priv kind: str = "bearer"
    priv name: str = ""
    priv format: str = ""
    priv description: str = ""

pub def bearer(format: str = "", description: str = "") -> SecurityScheme:
    """A token in `Authorization: Bearer <token>`. `format` is a hint such as `"JWT"`."""
    return SecurityScheme("bearer", "", format, description)

pub def basic_auth(description: str = "") -> SecurityScheme:
    """A user name and password in `Authorization: Basic ...`."""
    return SecurityScheme("basic", "", "", description)

pub def api_key(name: str, cookie: bool = False, description: str = "") -> SecurityScheme:
    """A key in the request header called `name`, or in the cookie called `name` when `cookie`
    is set."""
    return SecurityScheme("cookie" if cookie else "header", name, "", description)

def security_scheme_json(scheme: SecurityScheme) -> str:
    fields = ""
    if scheme.kind == "bearer" or scheme.kind == "basic":
        fields = "\"type\":\"http\",\"scheme\":" + jsonlib.encode(scheme.kind)
        if scheme.format != "":
            fields = fields + ",\"bearerFormat\":" + jsonlib.encode(scheme.format)
    else:
        fields = "\"type\":\"apiKey\",\"in\":" + jsonlib.encode(scheme.kind) + ",\"name\":" + jsonlib.encode(scheme.name)
    if scheme.description != "":
        fields = fields + ",\"description\":" + jsonlib.encode(scheme.description)
    return "{" + fields + "}"

pub struct Server:
    """
    Routes, middleware and settings. Register routes, then call `listen`. Request handlers run
    concurrently, one task per connection, so handlers and mounted values must be shareable.
    """
    max_body: int = 8388608
    max_message: int = 16777216
    ping_interval: int = 30
    priv routes: list[Route] = []
    priv middleware: list[Middleware] = []
    priv error_handler: (def(Request, HttpError) -> Response)? = None
    priv chain: Handler? = None
    priv listener: int = -1
    # For each path that is exactly a route's pattern without parameters, every route that
    # path fits, in order, with its parameters: worked out once, in `compose`.
    priv fixed: dict[str, list[Candidate]] = {}
    # The parameters of a request on a route without any, shared by all such requests. Never
    # changed: `params` is only ever replaced, and read.
    priv no_params: dict[str, str] = {}
    # The API documentation (docs/12): what `mount` recorded when the program asks for it, the
    # settings given to `docs`, the patterns of the routes `docs` added, and the documents
    # once built ("" until the first request for them, and after any route is added).
    priv doc_operations: list[DocOperation] = []
    priv doc_schemas: dict[str, str] = {}
    priv docs_settings: DocsSettings? = None
    priv docs_routes: list[str] = []
    priv docs_json: str = ""
    priv docs_yaml: str = ""
    # Security schemes that libraries document for every page, such as `auth`'s session cookie.
    priv security_schemes: dict[str, SecurityScheme] = {}

impl Server:
    def route(self, method: str, path: str, handler: Handler):
        """Register a handler for a method and a path such as `/todos/{id}` or `/files/{rest...}`."""
        self.routes.append(new_route(method.upper(), path, handler))
        self.chain = None
        self.docs_json = ""

    def get(self, path: str, handler: Handler):
        self.route("GET", path, handler)

    def post(self, path: str, handler: Handler):
        self.route("POST", path, handler)

    def put(self, path: str, handler: Handler):
        self.route("PUT", path, handler)

    def patch(self, path: str, handler: Handler):
        self.route("PATCH", path, handler)

    def delete(self, path: str, handler: Handler):
        self.route("DELETE", path, handler)

    def head(self, path: str, handler: Handler):
        self.route("HEAD", path, handler)

    def options(self, path: str, handler: Handler):
        self.route("OPTIONS", path, handler)

    def use(self, middleware: Middleware):
        """Add middleware, which runs around every route, first added outermost."""
        self.middleware.append(middleware)
        self.chain = None

    def ws(self, path: str, handler: WsHandler):
        """A WebSocket endpoint. `handler` runs in its own task for the life of each connection."""
        self.route("GET", path, lambda req: upgrade(req, handler))

    def group(self, prefix: str) -> Group:
        """Routes under a common path prefix, with their own middleware."""
        return Group(self, prefix)

    def on_error(self, handler: def(Request, HttpError) -> Response):
        """Replace how errors returned by handlers become responses."""
        self.error_handler = handler

    def dispatch(self, req: Request) -> Result[Response]:
        # The first route, in order, that the path fits and that accepts the method.
        match self.fixed.get(req.path):
            case Some(candidates):
                for candidate in candidates:
                    if accepts(candidate.route, req.method):
                        req.params = candidate.params
                        return candidate.route.handler(req)
                return not_routed(req, [candidate.route for candidate in candidates])
            case None:
                pass
        segments = split_path(req.path)
        for route in self.routes:
            if fits(route, segments) and accepts(route, req.method):
                req.params = params_of(route, segments) if route.has_params else self.no_params
                return route.handler(req)
        return not_routed(req, [route for route in self.routes if fits(route, segments)])

    def build_fixed(self):
        fixed: dict[str, list[Candidate]] = {}
        for route in self.routes:
            if route.has_params or route.pattern in fixed:
                continue
            segments = split_path(route.pattern)
            candidates: list[Candidate] = []
            for other in self.routes:
                if fits(other, segments):
                    params = params_of(other, segments) if other.has_params else self.no_params
                    candidates.append(Candidate(other, params))
            fixed[route.pattern] = candidates
        self.fixed = fixed

    def handle(self, req: Request) -> Response:
        """Answer one request: route it through the middleware and map errors to responses."""
        handler = self.compose()
        match handler(req):
            case Ok(response):
                return response
            case Err(problem):
                status = problem.status()
                if status >= 500:
                    log.error(f"{req.method} {req.path}: {problem.message()}")
                message = problem.message() if status < 500 else "internal server error"
                failure = HttpError(status, message)
                match self.error_handler:
                    case Some(custom):
                        return custom(req, failure)
                    case None:
                        return error(status, message)

    def compose(self) -> Handler:
        match self.chain:
            case Some(chain):
                return chain
            case None:
                pass
        self.build_fixed()
        server = self
        handler: Handler = lambda req: server.dispatch(req)
        for i in range(len(self.middleware) - 1, -1, -1):
            handler = wrap(self.middleware[i], handler)
        self.chain = handler
        return handler

    def bind(self, address: str) -> Result[int, HttpError]:
        """Start listening on `host:port` (`":8080"` for all interfaces, `":0"` for any free
        port). Returns the port. Then call `serve`."""
        return self.bound(listen_raw(address))

    def bind_tls(self, address: str, cert_file: str, key_file: str) -> Result[int, HttpError]:
        """`bind` for HTTPS: `cert_file` is the PEM certificate chain (the server's certificate
        first) and `key_file` its PEM private key. WebSockets on this server use TLS too."""
        return self.bound(listen_tls_raw(address, cert_file, key_file))

    def bound(self, listener: int) -> Result[int, HttpError]:
        if listener < 0:
            return Err(HttpError(500, last_error()))
        self.listener = listener
        set_max_body_raw(self.max_body)
        ws_set_limits(self.max_message, self.ping_interval)
        return port_raw(listener)

    def serve(self):
        """Serve requests until the program is interrupted (SIGINT or SIGTERM) or `stop` is
        called; requests in progress finish first."""
        self.compose()
        server = self
        def serve_one(handle: int):
            req = Request(req_method(handle), req_path(handle), handle, server.no_params)
            response = server.handle(req)
            # The runtime writes the status line, `Content-Type` and its own headers straight
            # into the response; only extra headers need a string here.
            headers = ""
            if len(response.headers) > 0:
                header_lines: list[str] = []
                for name, value in response.headers.items():
                    if "\n" in value or "\r" in value:
                        # Several values (`add_header`, `set_cookie`): one line each. A line
                        # break can never start a header of another name.
                        for line in value.replace("\r", "").split("\n"):
                            header_lines.append(f"{name}: {line}\r\n")
                    else:
                        header_lines.append(f"{name}: {value}\r\n")
                headers = "".join(header_lines)
            respond_raw(handle, response.status, response.content_type, headers, response.body)
        __http_serve(self.listener, serve_one)

    def listen(self, address: str) -> Result[None, HttpError]:
        """`bind` and `serve`."""
        port = self.bind(address)?
        log.info(f"listening on port {port}")
        self.serve()

    def listen_tls(self, address: str, cert_file: str, key_file: str) -> Result[None, HttpError]:
        """`bind_tls` and `serve`."""
        port = self.bind_tls(address, cert_file, key_file)?
        log.info(f"listening on port {port} (https)")
        self.serve()

    def stop(self):
        """Ask `serve` to finish, as SIGTERM does."""
        shutdown_raw()

    def docs(
        self,
        path: str = "/docs",
        title: str = "API",
        version: str = "0.1.0",
        description: str = "",
        servers: list[str] = [],
        tags: list[Tag] = [],
        security: dict[str, SecurityScheme] = {},
        ui: bool = True,
        try_it_out: bool = True,
        hide_ws: bool = True,
    ):
        """
        Serve an API documentation page at `path`, and the OpenAPI 3.1 description it shows
        at `path + "/openapi.json"` and `path + "/openapi.yaml"`. The description is built from
        the routes' types, annotations and docstrings when first asked for, so `docs` can come
        before or after `mount`. `servers` are the base URLs listed in it (and the one "Try it
        out" sends to; by default the page's own). `tags` describe and order the tags; `security`
        names the ways clients authenticate, for the routes' `security=` (see `SecurityScheme`).
        `ui=False` serves only the description;
        `try_it_out=False` makes the page read-only. WebSocket endpoints are listed only with
        `hide_ws=False`. The routes go through the server's middleware like any other, so
        protect them as you would the API.
        """
        base = path
        while base.ends_with("/"):
            base = base[0:len(base) - 1]
        self.docs_settings = DocsSettings(base, title, version, description, servers, tags, security, hide_ws)
        server = self
        self.docs_route(base + "/openapi.json", lambda req: Ok(server.openapi_reply(False)))
        self.docs_route(base + "/openapi.yaml", lambda req: Ok(server.openapi_reply(True)))
        if not ui:
            return
        page_text = (
            docs_asset(0)
            .replace("{{base}}", html_escape(base))
            .replace("{{openapi_url}}", html_escape(base + "/openapi.json"))
            .replace("{{try_it_out}}", "true" if try_it_out else "false")
            .replace("{{title}}", html_escape(title))
        )
        page = docs_file(page_text, "text/html; charset=utf-8", True)
        css = docs_file(docs_asset(1), "text/css; charset=utf-8", False)
        core = docs_file(docs_asset(2), "text/javascript; charset=utf-8", False)
        viewer = docs_file(docs_asset(3), "text/javascript; charset=utf-8", False)
        if base != "":
            self.docs_route(base, lambda req: Ok(serve_docs_file(page, req)))
        self.docs_route(base + "/", lambda req: Ok(serve_docs_file(page, req)))
        self.docs_route(base + "/viewer.css", lambda req: Ok(serve_docs_file(css, req)))
        self.docs_route(base + "/core.js", lambda req: Ok(serve_docs_file(core, req)))
        self.docs_route(base + "/viewer.js", lambda req: Ok(serve_docs_file(viewer, req)))

    def openapi_json(
        self,
        title: str = "API",
        version: str = "0.1.0",
        description: str = "",
        servers: list[str] = [],
        tags: list[Tag] = [],
        security: dict[str, SecurityScheme] = {},
        hide_ws: bool = True,
    ) -> str:
        """The OpenAPI document `docs` serves, as JSON text: for tests, a file, or a route of
        your own."""
        return self.document(DocsSettings("", title, version, description, servers, tags, security, hide_ws))

    def security_scheme(self, name: str, scheme: SecurityScheme):
        """Document a security scheme on every documentation page of this server, as if it
        were given to `docs(security=...)`, which takes precedence. It is for libraries that
        protect routes: `auth`'s `install` documents the session cookie this way."""
        self.security_schemes[name] = scheme
        self.docs_json = ""

    def __document(self, method: str, path: str, id: str, operation: str, ws: bool, security: str):
        """Used by the code `server.mount` generates: one documented route."""
        self.doc_operations.append(DocOperation(method, path, id, operation, ws, security))
        self.docs_json = ""

    def __schema(self, name: str, schema: str):
        """Used by the code `server.mount` generates: a schema the documented routes use."""
        self.doc_schemas[name] = schema
        self.docs_json = ""

    def docs_route(self, pattern: str, handler: Handler):
        self.route("GET", pattern, handler)
        self.docs_routes.append(pattern)

    def openapi_reply(self, yaml: bool) -> Response:
        if self.docs_json == "":
            match self.docs_settings:
                case Some(settings):
                    self.docs_yaml = ""
                    self.docs_json = self.document(settings)
                case None:
                    pass
        if not yaml:
            return Response(200, self.docs_json, "application/json").with_header("Cache-Control", "no-cache")
        if self.docs_yaml == "":
            self.docs_yaml = yaml_of_json(self.docs_json)
        return Response(200, self.docs_yaml, "application/yaml").with_header("Cache-Control", "no-cache")

    def document(self, settings: DocsSettings) -> str:
        """The OpenAPI document, as JSON text, joined from what `mount` recorded. Call-style
        routes are listed with their method, path and path parameters."""
        schemes: dict[str, SecurityScheme] = {}
        for name in self.security_schemes.keys():
            schemes[name] = self.security_schemes[name]
        for name in settings.security.keys():
            schemes[name] = settings.security[name]
        documented: dict[str, DocOperation] = {}
        for op in self.doc_operations:
            documented[op.method + " " + op.path] = op
        seen: list[str] = []
        order: list[str] = []
        by_path: dict[str, list[str]] = {}
        used_ids: dict[str, int] = {}
        for route in self.routes:
            method = route.method.lower()
            path = route.pattern.replace("...}", "}")
            key = route.method + " " + path
            if route.pattern in self.docs_routes or not OPENAPI_METHODS.contains(" " + method + " ") or key in seen:
                continue
            seen.append(key)
            operation = ""
            match documented.get(key):
                case Some(op):
                    if op.ws and settings.hide_ws:
                        continue
                    if op.security != "":
                        for name in op.security.split(" "):
                            if name not in schemes:
                                if name == "googleSession":
                                    panic(f"the route {op.method} {op.path} needs a signed-in user, but no sign-in provider is installed: call `provider.install(server)`")
                                panic(f"the route {op.method} {op.path} names the security scheme `{name}`, which `docs` was not given")
                    id = unique_id(op.id, used_ids)
                    operation = "{\"operationId\":" + jsonlib.encode(id) + "," + op.operation[1:]
                case None:
                    operation = call_style_operation(route)
            if path not in by_path:
                order.append(path)
                by_path[path] = []
            by_path[path].append(jsonlib.encode(method) + ":" + operation)
        info = "{\"title\":" + jsonlib.encode(settings.title) + ",\"version\":" + jsonlib.encode(settings.version)
        if settings.description != "":
            info = info + ",\"description\":" + jsonlib.encode(settings.description)
        parts = ["{\"openapi\":\"3.1.0\",\"info\":" + info + "}"]
        if len(settings.servers) > 0:
            urls = ["{\"url\":" + jsonlib.encode(url) + "}" for url in settings.servers]
            parts.append(",\"servers\":[" + ",".join(urls) + "]")
        if len(settings.tags) > 0:
            tags: list[str] = []
            for tag in settings.tags:
                text = "{\"name\":" + jsonlib.encode(tag.name)
                if tag.description != "":
                    text = text + ",\"description\":" + jsonlib.encode(tag.description)
                tags.append(text + "}")
            parts.append(",\"tags\":[" + ",".join(tags) + "]")
        paths = [jsonlib.encode(path) + ":{" + ",".join(by_path[path]) + "}" for path in order]
        parts.append(",\"paths\":{" + ",".join(paths) + "}")
        components: list[str] = []
        if len(self.doc_schemas) > 0:
            names = sorted(self.doc_schemas.keys())
            schemas = [jsonlib.encode(name) + ":" + self.doc_schemas[name] for name in names]
            components.append("\"schemas\":{" + ",".join(schemas) + "}")
        if len(schemes) > 0:
            names = sorted(schemes.keys())
            described = [jsonlib.encode(name) + ":" + security_scheme_json(schemes[name]) for name in names]
            components.append("\"securitySchemes\":{" + ",".join(described) + "}")
        if len(components) > 0:
            parts.append(",\"components\":{" + ",".join(components) + "}")
        parts.append("}")
        return "".join(parts)

pub struct Group:
    priv server: Server
    priv prefix: str
    priv middleware: list[Middleware] = []

impl Group:
    def route(self, method: str, path: str, handler: Handler):
        wrapped = handler
        for i in range(len(self.middleware) - 1, -1, -1):
            wrapped = wrap(self.middleware[i], wrapped)
        self.server.route(method, self.prefix + path, wrapped)

    def get(self, path: str, handler: Handler):
        self.route("GET", path, handler)

    def post(self, path: str, handler: Handler):
        self.route("POST", path, handler)

    def put(self, path: str, handler: Handler):
        self.route("PUT", path, handler)

    def patch(self, path: str, handler: Handler):
        self.route("PATCH", path, handler)

    def delete(self, path: str, handler: Handler):
        self.route("DELETE", path, handler)

    def ws(self, path: str, handler: WsHandler):
        self.route("GET", path, lambda req: upgrade(req, handler))

    def __document(self, method: str, path: str, id: str, operation: str, ws: bool, security: str):
        """Used by the code `group.mount` generates: one documented route."""
        self.server.__document(method, self.prefix + path, id, operation, ws, security)

    def __schema(self, name: str, schema: str):
        """Used by the code `group.mount` generates: a schema the documented routes use."""
        self.server.__schema(name, schema)

    def use(self, middleware: Middleware):
        """Middleware for the routes registered on this group after this call."""
        self.middleware.append(middleware)

    def group(self, prefix: str) -> Group:
        nested = Group(self.server, self.prefix + prefix)
        for middleware in self.middleware:
            nested.middleware.append(middleware)
        return nested

# ---- API documentation --------------------------------------------------------------------

struct DocsFile:
    """A file of the documentation page, with its `ETag`."""
    body: str
    content_type: str
    etag: str
    # The page itself, which gets the security headers.
    page: bool

def docs_file(body: str, content_type: str, page: bool) -> DocsFile:
    return DocsFile(body, content_type, f"\"{docs_hash(body)}\"", page)

def serve_docs_file(file: DocsFile, req: Request) -> Response:
    """The file, or `304 Not Modified` when the browser has this version. Browsers check each
    time (`no-cache`), so a server with a newer viewer is never stuck behind an old one."""
    response = Response(200, file.body, file.content_type)
    match req.header("If-None-Match"):
        case Some(tags):
            if tags.contains(file.etag):
                response = Response(304, "", "")
        case None:
            pass
    response.headers["ETag"] = file.etag
    response.headers["Cache-Control"] = "no-cache"
    response.headers["X-Content-Type-Options"] = "nosniff"
    if file.page:
        # No inline script or style; requests from "Try it out" may go to any server listed.
        response.headers["Content-Security-Policy"] = "default-src 'self'; connect-src *; img-src 'self' data:"
        response.headers["Referrer-Policy"] = "no-referrer"
    return response

def html_escape(text: str) -> str:
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")

# The methods an OpenAPI path item can have, each between spaces.
const OPENAPI_METHODS = " get put post delete options head patch trace "

def unique_id(id: str, used: dict[str, int]) -> str:
    """`id`, or `id_2`, `id_3`... when the document already has it (a type mounted twice)."""
    match used.get(id):
        case None:
            used[id] = 1
            return id
        case Some(count):
            n = count + 1
            candidate = f"{id}_{n}"
            while candidate in used:
                n += 1
                candidate = f"{id}_{n}"
            used[id] = n
            used[candidate] = 1
            return candidate

def call_style_operation(route: Route) -> str:
    """What is known of a route registered with `server.get(...)` and the like."""
    parameters: list[str] = []
    for i in range(len(route.kinds)):
        if route.kinds[i] != LITERAL:
            parameters.append(
                "{\"name\":" + jsonlib.encode(route.names[i])
                + ",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}"
            )
    text = "{"
    if len(parameters) > 0:
        text = text + "\"parameters\":[" + ",".join(parameters) + "],"
    return text + "\"responses\":{\"default\":{\"description\":\"Response\"}}}"

def yaml_of_json(text: str) -> str:
    """The same document in YAML. Strings are plain when they cannot be read as anything else,
    and double-quoted otherwise, which in YAML takes JSON's escapes."""
    match jsonlib.parse(text):
        case Ok(value):
            lines: list[str] = []
            yaml_lines(value, "", lines)
            return "\n".join(lines) + "\n"
        case Err(_):
            return ""

def yaml_lines(value: jsonlib.Value, indent: str, out: list[str]):
    match value:
        case jsonlib.Value.Object(fields):
            for key, item in fields.items():
                match yaml_inline(item):
                    case Some(text):
                        out.append(indent + yaml_str(key) + ": " + text)
                    case None:
                        out.append(indent + yaml_str(key) + ":")
                        yaml_lines(item, indent + "  ", out)
        case jsonlib.Value.Array(items):
            for item in items:
                match yaml_inline(item):
                    case Some(text):
                        out.append(indent + "- " + text)
                    case None:
                        out.append(indent + "-")
                        yaml_lines(item, indent + "  ", out)
        case _:
            pass

def yaml_inline(value: jsonlib.Value) -> str?:
    """A value that fits on its line, or `None` for a non-empty object or array."""
    match value:
        case jsonlib.Value.Null:
            return "null"
        case jsonlib.Value.Bool(flag):
            if flag:
                return "true"
            return "false"
        case jsonlib.Value.Int(number):
            return f"{number}"
        case jsonlib.Value.Float(real):
            return jsonlib.encode(real)
        case jsonlib.Value.Str(text):
            return yaml_str(text)
        case jsonlib.Value.Array(items):
            if len(items) == 0:
                return "[]"
            return None
        case jsonlib.Value.Object(fields):
            if len(fields) == 0:
                return "{}"
            return None

# Letters, digits and the punctuation a plain YAML scalar may be made of here.
const YAML_PLAIN = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-/"
# Plain scalars that YAML would read as something other than a string, each between spaces.
const YAML_WORDS = " true false null yes no on off y n "

def yaml_str(text: str) -> str:
    if text == "" or YAML_WORDS.contains(" " + text.lower() + " ") or not YAML_PLAIN[0:52].contains(text[0:1]):
        return jsonlib.encode(text)
    for c in text:
        if not YAML_PLAIN.contains(c):
            return jsonlib.encode(text)
    return text

# ---- WebSockets ---------------------------------------------------------------------------

pub enum WsMessage:
    """A message from the peer: text, or binary data."""
    Text(body: str)
    Binary(data: bytes)

@derive(Display)
pub struct WsClosed:
    """The error from sending on a WebSocket that has closed."""
    id: int

impl Error for WsClosed:
    def message(self) -> str:
        return "the WebSocket is closed"

@frozen
pub struct WebSocket:
    """
    One WebSocket connection. Its handler receives with `recv()` or `for msg in ws`; any task may
    `send`, since sends are serialised per connection. A `WebSocket` can be shared between tasks,
    so a hub can keep connections in a `Mutex[dict[int, http.WebSocket]]`.
    """
    id: int
    path: str
    priv params: frozendict[str, str]

impl WebSocket:
    def recv(self) -> WsMessage?:
        """Wait for the next message; `None` once the connection has closed."""
        kind = ws_recv(self.id)
        if kind == 1:
            return Text(ws_payload())
        if kind == 2:
            return Binary(__bytes(ws_payload()))
        return None

    def next(self) -> WsMessage?:
        """`for msg in ws` receives until the connection closes."""
        return self.recv()

    def send(self, text: str) -> Result[None, WsClosed]:
        """Send a text message."""
        if ws_send(self.id, 0, text) < 0:
            return Err(WsClosed(self.id))
        return Ok(None)

    def send_bytes(self, data: bytes) -> Result[None, WsClosed]:
        """Send a binary message."""
        if ws_send(self.id, 1, __bytes_data(data)) < 0:
            return Err(WsClosed(self.id))
        return Ok(None)

    def close(self, code: int = 1000, reason: str = ""):
        """Start the closing handshake; `recv` then returns `None` once the peer agrees."""
        ws_close(self.id, code, reason)

    def param(self, name: str) -> str:
        """A `{name}` segment of the endpoint's path, or `""`."""
        return self.params.get_or(name, "")

    def query(self, name: str) -> str?:
        """A query parameter of the upgrade request."""
        return ws_query(self.id, name)

    def header(self, name: str) -> str?:
        """A header of the upgrade request."""
        return ws_header(self.id, name)

    def remote_addr(self) -> str:
        return ws_remote(self.id)

pub def send_json[T: ToJson](ws: WebSocket, value: T) -> Result[None, WsClosed]:
    """Send a value as a JSON text message."""
    return ws.send(jsonlib.encode(value))

pub type WsHandler = def(WebSocket)
"""A WebSocket endpoint's handler, which runs for the life of the connection."""

pub def upgrade(req: Request, handler: WsHandler) -> Result[Response]:
    """Answer a WebSocket handshake and run `handler` on the connection until it returns."""
    id = ws_accept(req.handle)
    if id == -2:
        return Ok(error(426, last_error()).with_header("Sec-WebSocket-Version", "13"))
    if id < 0:
        return Err(HttpError(400, last_error()))
    ws = WebSocket(id, req.path, frozendict(req.params))
    handler(ws)
    ws_finish(id)
    return Ok(Response(101, "", ""))

# ---- the client ----------------------------------------------------------------------------

pub struct ClientError:
    """A request that got no response: the host could not be reached, it closed the connection
    early, it timed out (after 30 seconds), its TLS certificate is not trusted, or the URL is
    not `http://` or `https://`."""
    url: str
    reason: str

impl Error for ClientError:
    def message(self) -> str:
        return f"{self.url}: {self.reason}"

    def status(self) -> int:
        """Returned from a handler, a failed call to another service is a 502 Bad Gateway."""
        return 502

pub struct ClientResponse:
    """A response from another server."""
    status: int
    body: bytes
    priv headers: dict[str, str] = {}
    priv url: str = ""

impl ClientResponse:
    def ok(self) -> bool:
        """Whether the status is 2xx."""
        return self.status >= 200 and self.status < 300

    def header(self, name: str) -> str?:
        """A response header; names are case-insensitive. A header sent several times, such as
        `Set-Cookie`, is its values joined by newlines."""
        return self.headers.get(name.lower())

    def text(self) -> Result[str, ClientError]:
        """The body as text; an error if it is not UTF-8."""
        match self.body.decode():
            case Some(text):
                return text
            case None:
                return Err(ClientError(self.url, "the response body is not UTF-8 text"))

    def json(self) -> Result[jsonlib.Value, ClientError]:
        """The body parsed as JSON of any shape."""
        text = self.text()?
        match jsonlib.parse(text):
            case Ok(value):
                return value
            case Err(error):
                return Err(ClientError(self.url, f"invalid JSON: {error.message()}"))

pub def decode_json[T: FromJson](response: ClientResponse) -> Result[T, ClientError]:
    """The body decoded as JSON into a `T`."""
    text = response.text()?
    match jsonlib.decode[T](text):
        case Ok(value):
            return value
        case Err(error):
            return Err(ClientError(response.url, f"invalid JSON: {error.message()}"))

pub def fetch(method: str, url: str, body: str = "", headers: dict[str, str] = {}) -> Result[ClientResponse, ClientError]:
    """Send a request and wait for the whole response. A task waiting here does not hold a
    worker. `https://` URLs use TLS, checking the server's certificate."""
    lines = ""
    for name, value in headers.items():
        lines = lines + f"{name}: {value}\r\n"
    status = client_raw(method, url, lines, body)
    if status < 0:
        return Err(ClientError(url, last_error()))
    parsed: dict[str, str] = {}
    for line in client_headers().split("\n"):
        parts = line.split(": ")
        if len(parts) >= 2:
            value = ": ".join(parts[1:])
            # A header sent several times (`Set-Cookie`) keeps every value, one per line.
            match parsed.get(parts[0]):
                case Some(earlier):
                    parsed[parts[0]] = earlier + "\n" + value
                case None:
                    parsed[parts[0]] = value
    return ClientResponse(status, __bytes(client_body()), parsed, url)

pub def get(url: str) -> Result[ClientResponse, ClientError]:
    """`GET url`."""
    return fetch("GET", url)

pub def post(url: str, body: str, content_type: str = "application/json") -> Result[ClientResponse, ClientError]:
    """`POST url` with a body."""
    return fetch("POST", url, body, {"Content-Type": content_type})

pub def post_form(url: str, fields: list[tuple[str, str]], headers: dict[str, str] = {}) -> Result[ClientResponse, ClientError]:
    """`POST url` with the fields as an HTML form would send them
    (`application/x-www-form-urlencoded`), as OAuth token endpoints expect."""
    all_headers = headers.copy()
    all_headers["Content-Type"] = "application/x-www-form-urlencoded"
    return fetch("POST", url, form_encode(fields), all_headers)

# ---- adapters for annotated routes --------------------------------------------------------

pub def reply_json[T: ToJson](value: T, status: int) -> Result[Response]:
    return Ok(json(value, status))

pub def reply_text(value: str, status: int) -> Result[Response]:
    return Ok(text(value, status))

pub def reply_empty(status: int) -> Result[Response]:
    return Ok(Response(status, "", ""))
