# Task creation: spawn 10,000 tasks that each add two numbers, join them all, twenty times.

def add(a: int, b: int) -> int:
    return a + b

def main():
    total = 0
    for round in range(20):
        tasks = [spawn add(i, round) for i in range(10000)]
        for task in tasks:
            total += task.join()
    print(total)
