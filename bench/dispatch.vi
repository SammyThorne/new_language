# Dynamic dispatch: 10 million method calls through trait objects.

trait Shape:
    def area(self) -> float

struct Circle:
    radius: float

struct Square:
    side: float

struct Rect:
    width: float
    height: float

impl Shape for Circle:
    def area(self) -> float:
        return 3.0 * self.radius * self.radius

impl Shape for Square:
    def area(self) -> float:
        return self.side * self.side

impl Shape for Rect:
    def area(self) -> float:
        return self.width * self.height

def main():
    shapes: list[Shape] = []
    for i in range(1000):
        size = float(i % 10 + 1)
        if i % 3 == 0:
            shapes.append(Circle(size))
        elif i % 3 == 1:
            shapes.append(Square(size))
        else:
            shapes.append(Rect(size, 2.0))
    total = 0.0
    for _ in range(10_000):
        for shape in shapes:
            total += shape.area()
    print(f"{total:.1f}")
