# The HTTP benchmark server: a plain-text endpoint and a JSON endpoint, as in TechEmpower's
# "plaintext" and "JSON" tests, a JSON list of records, and two endpoints shaped like a REST API:
# a typed route with a path parameter behind ten other routes, and a POST whose JSON body is
# decoded into a struct and answered with a computed JSON receipt.
#
# With `observed` after the port, it runs as a production server would: with the access log
# (`request_log`) and request metrics (`metrics`), for bench/http/counts.py --observed. With
# `metrics`, only the metrics are on.

import http
import io
import os

@derive(Json)
struct Message:
    message: str

@derive(Json)
struct Item:
    id: int
    name: str
    price: float
    tags: list[str]

@derive(Json)
struct User:
    id: int
    name: str
    email: str
    active: bool

@derive(Json)
@frozen
struct Line:
    sku: str
    qty: int
    price: float

@derive(Json)
@frozen
struct Order:
    customer: str
    lines: list[Line]

@derive(Json)
struct Receipt:
    customer: str
    count: int
    total: float

def plaintext(req: http.Request) -> Result[http.Response]:
    return http.text("Hello, World!")

def message(req: http.Request) -> Result[http.Response]:
    return http.json(Message("Hello, World!"))

def items(req: http.Request) -> Result[http.Response]:
    return http.json([Item(i, f"item {i}", float(i) * 1.5, ["a", "b"]) for i in range(20)])

def other(req: http.Request) -> Result[http.Response]:
    return http.text("other")

@http.get("/users/{id}")
def user(id: int) -> User:
    return User(id, f"user {id}", f"user{id}@example.com", id % 2 == 0)

@http.post("/orders", status=200)
def order(body: Order) -> Receipt:
    total = 0.0
    count = 0
    for line in body.lines:
        total += float(line.qty) * line.price
        count += line.qty
    return Receipt(body.customer, count, total)

def main():
    server = http.Server()
    args = os.args()
    mode = args[2] if len(args) > 2 else ""
    if mode == "observed":
        server.use(http.request_log())
    if mode == "observed" or mode == "metrics":
        server.metrics(public=True)
    server.get("/plaintext", plaintext)
    server.get("/json", message)
    server.get("/items", items)
    for i in range(10):
        server.get(f"/api/v1/resource{i}/{{id}}", other)
    server.mount(user)
    server.mount(order)
    port = server.bind(f"127.0.0.1:{args[1]}").unwrap()
    io.eprint(f"listening on {port}")
    server.serve()
